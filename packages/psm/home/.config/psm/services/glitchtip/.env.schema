# GlitchTip config schema — canonical source of truth for every tunable.
#
# Dev defaults are baked into compose.yml so the stack boots untouched; the
# values here document intent, types, and which vars are required/sensitive.
# When varlock is adopted, this file drives validation and injection.
#
# @defaultSensitive=false @defaultRequired=infer
# ---

## Images — fully qualified for Podman (no docker.io assumption).
# @type=string
POSTGRES_IMAGE=docker.io/library/postgres
# @type=string
POSTGRES_TAG=18
# @type=string
VALKEY_IMAGE=docker.io/valkey/valkey
# @type=string
VALKEY_TAG=9
# @type=string
GLITCHTIP_IMAGE=docker.io/glitchtip/glitchtip
# Check https://glitchtip.com/blog/ for new major versions.
# @type=string
GLITCHTIP_TAG=6

## Core config
# Django secret key. The dev default is INSECURE — set a real one for anything
# shared or exposed. Generate: openssl rand -hex 32
# @required @sensitive @type=string
GLITCHTIP_SECRET_KEY=dev-insecure-change-me
# Public URL GlitchTip builds links (emails, DSNs) against.
# @required @type=url
GLITCHTIP_DOMAIN=http://localhost:8000
# Host port for the web UI. 8000 avoids the Rails dev server (3000/5000).
# @type=port
GLITCHTIP_PORT=8000

## Connections — default to the in-network postgres/valkey services.
# @sensitive @type=string
GLITCHTIP_DATABASE_URL=postgres://postgres:postgres@postgres:5432/postgres
# Set to an empty string to disable Valkey (uses Postgres for queue + cache).
# @type=string
GLITCHTIP_VALKEY_URL=redis://valkey:6379
# consolemail:// prints emails to the container log. For real delivery use e.g.
# smtp://user:pass@host:port — see https://glitchtip.com/documentation/install
# @type=string
GLITCHTIP_EMAIL_URL=consolemail://
# @type=email
GLITCHTIP_DEFAULT_FROM_EMAIL=glitchtip@localhost

## Postgres auth. "trust" = no password (dev only). Remove/replace in prod.
# @type=string
POSTGRES_HOST_AUTH_METHOD=trust

## Feature toggles (Django-style "True"/"False" strings).
# Django Admin at /admin/
# @type=string(enum=[True, False])
GLITCHTIP_ENABLE_ADMIN=False
# OpenAPI spec at /api/docs
# @type=string(enum=[True, False])
GLITCHTIP_ENABLE_OPENAPI=False
# MCP server
# @type=string(enum=[True, False])
GLITCHTIP_ENABLE_MCP=False
# Cold-storage archival via DuckDB
# @type=string(enum=[True, False])
GLITCHTIP_ENABLE_DUCKDB=False
