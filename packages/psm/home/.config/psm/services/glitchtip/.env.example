# Copy to .env and edit to override any compose.yml default.
# The stack boots WITHOUT this file — only set what you want to change.
# See .env.schema for the full list, types, and docs.

# Set a real secret before exposing GlitchTip beyond localhost:
#   openssl rand -hex 32
# GLITCHTIP_SECRET_KEY=

# GLITCHTIP_PORT=8000
# GLITCHTIP_DOMAIN=http://localhost:8000
