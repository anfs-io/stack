# Dockge config schema — canonical source of truth for every tunable.
#
# Defaults are baked into compose.yml so the service boots untouched.
#
# @defaultSensitive=false @defaultRequired=infer
# ---

## Image — fully qualified for Podman (no docker.io assumption).
# @type=string
DOCKGE_IMAGE=docker.io/louislam/dockge
# @type=string
DOCKGE_TAG=1

## Web UI
# Host address the UI binds to. Dockge controls your podman (it can run any
# container and mount anything you can), so keep it on localhost unless it is
# behind something that authenticates. Use 0.0.0.0 to expose it on the network.
# @type=string
DOCKGE_BIND=127.0.0.1
# @type=port
DOCKGE_PORT=5001

## Injected by psm — do not set
# Podman API socket (inside the podman machine VM on macOS).
# @type=string
PSM_PODMAN_SOCKET=
