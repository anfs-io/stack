# Postgres config schema — canonical source of truth for every tunable.
#
# Shared psm postgres. Dependents get connection details from ./provision.
# Validate: varlock load --path .
#
# @defaultSensitive=false @defaultRequired=infer
# ---

## Credentials
# Superuser password. The dev default is INSECURE — set a real one for anything
# shared or exposed. Changing it after first boot does not change the password of
# an existing cluster.
# @required @sensitive={allowShortValue=true} @type=string
POSTGRES_PASSWORD=postgres
# @type=string
POSTGRES_USER=postgres
# Database created on first boot; also the admin db provision connects to.
# @type=string
POSTGRES_DB=postgres

## Network
# Host port.
# @type=port
POSTGRES_PORT=5432

## Injected by psm — do not set
# Root of psm service volumes.
# @required @type=string
PSM_VOLUMES_HOME=
