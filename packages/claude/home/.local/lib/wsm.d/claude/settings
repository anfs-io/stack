#!/usr/bin/env bash
# stack/claude: the coordinator's hooks and status line in the person's ~/.claude/settings.json
# (agents/06b2 and the status line, moved out of core/wsm by agents/06's to-stack). Run by this
# package's install.sh (post_install: settings install; post_remove: settings remove), from the
# package's own copy: post_remove runs after the unstow.
#
#   settings install                  merge ours in (exit 1 when refused or not written)
#   settings remove                   take ours out; the file goes when nothing else is in it
#   settings status                   ok, missing (none of ours there: Claude Code may not be
#                                     used), outdated, invalid or refused; a warning saying why,
#                                     and exit 1, for the last three
#
# The file is user scope: one place, every session on the machine. This package owns its own
# hooks there and nothing else: the person's keys and hooks (herdr's too) are kept; the file is
# merged, never overwritten (Claude Code writes it too: /config). Its own are the handlers whose
# command is the adapter beside this script, ~/.local/lib/wsm.d/claude/hook (absolute: JSON does
# not expand ~; exec form, args, no shell): each write takes every one of them out and puts these
# back at the end of each event's list:
#
#   SessionStart       hook session-start (sync, 10 s) and hook listen (asyncRewake, a day: the
#                      listener; --max a minute less)
#   Stop               hook listen (the same)
#   UserPromptSubmit   hook prompt (5 s: a takeover, the inbox line)
#   SessionEnd         hook session-end (3 s)
#
# The hook exits at once when its directory is not under $WSM_SPACES_HOME (no library sourced): a
# session elsewhere pays one bash start per hook. A file that is not a JSON object, or
# settings.json as a link, is refused, saying so.
#
# The status line: the same writes put
#
#   "statusLine": {"type": "command", "command": "'<hook>' statusline"}
#
# into the file when it has no statusLine or has ours (a command ending in the adapter's path and
# statusline: statusLine has no args, its command runs in a shell, so the path is quoted). A
# statusLine of the person's is never touched: install says how to compose (their script runs ours
# with the same stdin and prints its line too). There is no switch here: whether a space shows a
# line is the space's anfs: (else the machine's WSM_ANFS), which the hook reads as it runs
# (agents/06's anfs-key).

set -euo pipefail

# core's libraries, beside this script's directory (<lib>/wsm.d/claude/settings and <lib>/anfs),
# else the installed ones: run from the package, as install.sh does
_lib="${BASH_SOURCE[0]%/wsm.d/claude/settings}/anfs"
[[ "$_lib" != "${BASH_SOURCE[0]}/anfs" && -f "$_lib/bash.sh" ]] || _lib="$HOME/.local/lib/anfs"
if [[ ! -f "$_lib/paths.sh" ]]; then
  echo "claude-anfs: ~/.local/lib/anfs is missing; install core/anfs" >&2
  exit 69
fi
# shellcheck source=/dev/null
source "$_lib/bash.sh"
# shellcheck source=/dev/null
source "$_lib/paths.sh"
for _l in log cli table files; do
  # shellcheck source=/dev/null
  source "$ANFS_LIB_DIR/$_l.sh"
done

CLI_TOOL=claude-anfs

HOOK_TIMEOUT=86400
HOOK="$ANFS_LIB_ROOT/wsm.d/claude/hook"

cli_cmd install "Merge the coordinator's hooks and the status line into ~/.claude/settings.json"
cli_cmd remove "Take them out of ~/.claude/settings.json" --alias rm
cli_cmd status "Whether they are in ~/.claude/settings.json as install writes them"
cli_standard

cli_help_epilogue() {
  cat <<'EOF'
claude-anfs is ~/.local/lib/wsm.d/claude/settings (stack/claude), run by the package's install.sh.
The hooks it writes run ~/.local/lib/wsm.d/claude/hook; whether they act in a space is the space's
anfs: (else WSM_ANFS: wsm config).
EOF
}

warn() { anfs_warn "$@"; }

# <text> as a JSON string, into REPLY
_json() {
  local t="$1"
  t="${t//\\/\\\\}" t="${t//\"/\\\"}" t="${t//$'\t'/\\t}" t="${t//$'\r'/\\r}" t="${t//$'\n'/\\n}"
  REPLY="\"$t\""
}

# The hooks we want in ~/.claude/settings.json, as JSON into REPLY
_want() {
  local h t="$HOOK_TIMEOUT"
  _json "$HOOK"; h="$REPLY"
  local start='{"type":"command","command":'"$h"',"args":["session-start"],"timeout":10}'
  local listen='{"type":"command","command":'"$h"',"args":["listen","--max","'"$(( t - 60 ))"'"],"asyncRewake":true,"timeout":'"$t"'}'
  local prompt='{"type":"command","command":'"$h"',"args":["prompt"],"timeout":5}'
  local end='{"type":"command","command":'"$h"',"args":["session-end"],"timeout":3}'
  REPLY='{"SessionStart":[{"hooks":['"$start"','"$listen"']}],"Stop":[{"hooks":['"$listen"']}],"UserPromptSubmit":[{"hooks":['"$prompt"']}],"SessionEnd":[{"hooks":['"$end"']}]}'
}

# The statusLine we want, as JSON into REPLY
_statusline() {
  local q r="'\\''"
  q="'${HOOK//\'/$r}' statusline"
  _json "$q"
  REPLY='{"type":"command","command":'"$REPLY"'}'
}

# <file> (or {} when missing) with our hooks taken out and <want> (JSON hooks) put in, and our
# statusLine set to <statusline> (JSON) where it is ours or there is none, or taken out (""),
# printed as the file is written; 1 when it is not a JSON object
SL_OURS='((.statusLine.command // "") | test("/wsm[.]d/claude/hook\x27?[[:space:]]+statusline$"))'
MERGE='.hooks = ((.hooks // {}) | with_entries(.value |= (map(.hooks |= map(select((.command // "") | test("/wsm[.]d/claude/hook$") | not))) | map(select((.hooks | length) > 0))))) | .hooks = (.hooks | with_entries(select(.value | length > 0))) | .hooks = (.hooks *+ (strenv(CLAUDE_WANT) | from_json)) | del(select(.hooks | length == 0) | .hooks) | with(select(strenv(CLAUDE_SL) != "" and (.statusLine == null or '"$SL_OURS"')); .statusLine = (strenv(CLAUDE_SL) | from_json)) | with(select(strenv(CLAUDE_SL) == "" and '"$SL_OURS"'); del(.statusLine))'
_merged() {
  local f="$1" want="$2" sl="${3:-}" body
  if [[ -e "$f" ]]; then
    body=$(cat -- "$f" 2>/dev/null) || return 1
    [[ "$body" =~ ^[[:space:]]*(\{.*)?$ ]] || return 1
    [[ -n "${body//[[:space:]]/}" ]] || body='{}'
  else
    body='{}'
  fi
  printf '%s' "$body" | CLAUDE_WANT="$want" CLAUDE_SL="$sl" yq -p json -o json -I2 "$MERGE" 2>/dev/null
}

# The state of our hooks (and statusLine) in ~/.claude/settings.json, into REPLY: ok, missing
# (none of ours there), outdated, invalid (not a JSON object), refused (a link); FILE the file,
# NEW what install writes, BARE the file without ours; SL_THEIRS the person's own statusLine
# command when there is one ("" otherwise)
_state() {
  local cur="" want
  FILE="$HOME/.claude/settings.json" NEW="" BARE="" SL_THEIRS=""
  if [[ -L "$FILE" ]]; then REPLY=refused; return 0; fi
  _want; want="$REPLY"
  _statusline
  NEW=$(_merged "$FILE" "$want" "$REPLY") && BARE=$(_merged "$FILE" '{}') ||
    { NEW="" BARE=""; REPLY=invalid; return 0; }
  SL_THEIRS=$(printf '%s' "$NEW" | yq -p json -r 'select(.statusLine != null and ('"$SL_OURS"' | not)) | .statusLine.command // "(not a command)"' 2>/dev/null) || SL_THEIRS=""
  [[ ! -f "$FILE" ]] || cur=$(yq -p json -o json -I2 . "$FILE" 2>/dev/null) || cur=""
  if [[ ! -f "$FILE" || "$cur" == "$BARE" ]]; then REPLY=missing
  elif [[ "$cur" == "$NEW" ]]; then REPLY=ok
  else REPLY=outdated
  fi
}

# Why our hooks are not right, for a warning (state <state>)
_why() {
  local f
  f=$(anfs_display "$FILE")
  case "$1" in
    outdated) REPLY="$f: stack/claude's Claude Code hooks are outdated: ppm install stack/claude writes them" ;;
    invalid)  REPLY="$f is not a JSON object: stack/claude's Claude Code hooks are not in it (fix it, then ppm install stack/claude)" ;;
    refused)  REPLY="$f is a link: stack/claude writes its Claude Code hooks only into a file (one owner): make it a file, then ppm install stack/claude" ;;
    *)        REPLY="" ;;
  esac
}

# Write our hooks into ~/.claude/settings.json; 1 when refused or not written
_install() {
  local what="the coordinator's hooks"
  _state
  case "$REPLY" in
    invalid|refused) _why "$REPLY"; warn "$REPLY"; return 1 ;;
  esac
  if [[ -n "$SL_THEIRS" ]]; then
    echo "claude settings: statusLine is yours ($SL_THEIRS): kept; for the coordinator's line, have it also run '$HOOK' statusline with the same stdin and print what that prints"
  fi
  if [[ "$REPLY" == ok ]]; then echo "claude settings: up to date ($(anfs_display "$FILE"))"; return 0; fi
  if ! { [[ -d "$HOME/.claude" ]] || mkdir -m 700 -- "$HOME/.claude"; } || ! anfs_write_atomic "$FILE" "$NEW"$'\n' 600; then
    warn "cannot write $(anfs_display "$FILE")"
    return 1
  fi
  [[ -n "$SL_THEIRS" ]] || what+=" and the status line"
  echo "claude settings: written ($(anfs_display "$FILE"): $what)"
}

cmd_install() { _install; }

# Take our hooks out of ~/.claude/settings.json; the file goes when nothing else is in it
cmd_remove() {
  _state
  case "$REPLY" in
    missing|refused) return 0 ;;
    invalid) _why "$REPLY"; warn "$REPLY"; return 0 ;;
  esac
  if [[ "$BARE" == "{}" ]]; then rm -f -- "$FILE"
  elif ! anfs_write_atomic "$FILE" "$BARE"$'\n' 600; then warn "cannot write $(anfs_display "$FILE")"; return 1
  fi
  echo "claude settings: stack/claude's hooks (and status line) taken out of $(anfs_display "$FILE")"
}

cmd_status() {
  local state
  _state; state="$REPLY"
  echo "claude settings: $state ($(anfs_display "$FILE"))"
  _why "$state"
  [[ -n "$REPLY" ]] || return 0
  warn "$REPLY"
  return 1
}

cli_dispatch "$@"
