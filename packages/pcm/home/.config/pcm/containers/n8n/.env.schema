# n8n config schema — canonical source of truth for every tunable.
#
# Uses the shared pcm postgres; connection details come from its provision hook.
# Validate: varlock load --path .
#
# @defaultSensitive=false @defaultRequired=infer
# ---

## Images — fully qualified for Podman (no docker.io assumption). docker.io rather
## than docker.n8n.io: the latter proxies Docker Hub anyway. n8n and the runners
## image share a version, so one tag drives both.
# @type=string
N8N_IMAGE=docker.io/n8nio/n8n
# @type=string
N8N_RUNNERS_IMAGE=docker.io/n8nio/runners
# Stable releases: https://github.com/n8n-io/n8n/releases (skip "prerelease" ones).
# @type=string
N8N_TAG=2.38.7

## Core config
# Shared secret between n8n and its task runner. The dev default is INSECURE —
# set a real one for anything shared. Generate: openssl rand -hex 32
# @required @sensitive @type=string
N8N_RUNNERS_AUTH_TOKEN=dev-insecure-change-me
# Host port for the editor UI and webhooks.
# @type=port
N8N_PORT=5678
# Public base URL n8n shows for webhook nodes. Change it if webhooks are reached
# through a tunnel or proxy.
# @required @type=url
N8N_WEBHOOK_URL=http://localhost:${N8N_PORT}/
# Timezone for schedule triggers and date handling.
# @type=string
N8N_TIMEZONE=America/New_York

## Injected by pcm — do not set
# Connection details for the shared pcm postgres (x-pcm.depends_on in compose.yml).
# To point elsewhere, export them in your shell before `pcm up`. Optional because
# pcm only provisions them on `up`; `down`, `logs` etc. run without them.
# @optional @type=string
PCM_POSTGRES_HOST=
# @optional @type=port
PCM_POSTGRES_PORT=
# @optional @type=string
PCM_POSTGRES_DATABASE=
# @optional @type=string
PCM_POSTGRES_USER=
# @optional @sensitive @type=string
PCM_POSTGRES_PASSWORD=
# Root of pcm service volumes.
# @required @type=string
PCM_VOLUMES_HOME=
