# opm settings: shipped by stack/op. Every setting opm reads.
#
# This machine's values go in ~/.config/opm/opm.local.env, beside this file (yours, never
# shipped). The environment wins over both: `OPM_SHARED_VAULT=common opm create x` does what it
# says. Format: NAME=value, one per line, read and never sourced (nothing is expanded; a value may
# be quoted). A commented line is the default used when nothing sets it. `opm config` is to list
# and set them; until it exists, edit opm.local.env.

# The vault each scope's service-account token item is saved in (--token-vault's default)
#OPM_SA_CREDENTIALS_VAULT=Private
# The cross-cutting vault every service account also reads (--shared's default)
#OPM_SHARED_VAULT=shared
# The tag on every token item opm writes: what `opm list` queries. OPM_TAG wins over
# OPM_PROVISION_TAG; either changes what opm finds, so set it once, before provisioning.
#OPM_PROVISION_TAG=op-provision
#OPM_TAG=op-provision
