#!/usr/bin/env bash
# gem-local — link the gems found in your repos into one place and bundle them
#
# The config ($RUBY_LOCAL_GEMS_CONFIG) lists repo directories; `build` links every gem found in
# them into $RUBY_LOCAL_GEMS_HOME, writes a Gemfile of path gems and bundles it.
set -euo pipefail
# A job's copy of this tool runs instead when ANFS_WORK names one (lib/anfs/work.sh)
[ -z "${ANFS_WORK:-}" ] || [ ! -f "$HOME/.local/lib/anfs/work.sh" ] || . "$HOME/.local/lib/anfs/work.sh"

# Paths, messages, the log and the command line come from anfs
if [[ ! -f "$HOME/.local/lib/anfs/paths.sh" ]]; then
  echo "gem-local: ~/.local/lib/anfs is missing or out of date; install core/anfs again" >&2
  exit 69
fi
# The bash floor, first: re-execs under bash 5 when this is macOS's 3.2
# shellcheck source=/dev/null
source "$HOME/.local/lib/anfs/bash.sh"
# shellcheck source=/dev/null
source "$HOME/.local/lib/anfs/paths.sh"
if [[ ! -f "$ANFS_LIB_DIR/table.sh" ]]; then
  echo "gem-local: $ANFS_LIB_DIR is out of date; install core/anfs again" >&2
  exit 69
fi
# shellcheck source=/dev/null
source "$ANFS_LIB_DIR/log.sh"
# shellcheck source=/dev/null
source "$ANFS_LIB_DIR/cli.sh"
# shellcheck source=/dev/null
source "$ANFS_LIB_DIR/table.sh"

: "${RUBY_LOCAL_GEMS_HOME:=$XDG_DATA_HOME/gems}"
: "${RUBY_LOCAL_GEMS_CONFIG:=$XDG_CONFIG_HOME/ruby/local-gems}"

CLI_TOOL=gem-local

cli_cmd build "Link every gem found in the configured repos and bundle them (rebuilds from scratch)"
cli_cmd list "Linked gems: GEM DIR NOTE" --alias ls
cli_cmd path "Print the gems dir, or a gem's repo dir" --arg "[gem]"
cli_cmd cd "Change to the gems dir, or a gem's repo dir (requires ~/.config/sh/ruby.sh)" --arg "[gem]"
cli_group src "The repos gems are looked for in"
cli_cmd "src list" "Configured repos: PATH NOTE" --alias ls
cli_cmd "src add" "Add a repo to the config ('.' adds the current dir)" --arg "dir"
cli_cmd "src remove" "Remove a repo from the config" --alias rm --arg "dir"
cli_standard

cli_help_epilogue() {
  cat <<'EOF'
Config: $RUBY_LOCAL_GEMS_CONFIG (~/.config/ruby/local-gems), one repo path per
line; blank lines and # comments are ignored, a leading ~ is expanded

  ~/spaces/rjayroach/gems
  ~/spaces/cnfs-io/gems

`build`:
  - searches each repo, at any depth, for dirs holding a *.gemspec
  - symlinks each one as $RUBY_LOCAL_GEMS_HOME/<gemspec name>
  - writes a Gemfile of path gems, runs bundle install and puts binstubs for
    gems with an exe/ dir in $RUBY_LOCAL_GEMS_HOME/bin

~/.config/sh/ruby.sh adds $RUBY_LOCAL_GEMS_HOME/bin to $PATH and each gem's lib dir to
$RUBYLIB when the shell starts, so open a new shell after a build.
EOF
}

die()  { anfs_die "$@"; }
warn() { anfs_warn "$@"; }

_expand() {
  echo "${1/#\~/$HOME}"
}

# Configured repo paths as written, one per line (comments and blanks stripped)
_config_entries() {
  [[ -f "$RUBY_LOCAL_GEMS_CONFIG" ]] || return 0
  local line
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ "$line" =~ ^[[:space:]]*# ]] && continue
    [[ -z "${line// }" ]] && continue
    echo "$line"
  done < "$RUBY_LOCAL_GEMS_CONFIG"
}

# Configured repo dirs that exist, expanded, one per line
_sources() {
  local entry src
  while IFS= read -r entry; do
    src="$(_expand "$entry")"
    if [[ -d "$src" ]]; then
      echo "$src"
    else
      warn "configured repo not found, skipping: $entry"
    fi
  done < <(_config_entries)
  return 0
}

# Link each gem dir as $RUBY_LOCAL_GEMS_HOME/<gemspec name>
_scan_for_gems() {
  local src gemdir gemspec name link
  local -a specs

  while IFS= read -r src; do
    while IFS= read -r gemdir; do
      specs=("$gemdir"/*.gemspec)
      gemspec="${specs[0]}"
      [[ -f "$gemspec" ]] || continue
      name="$(basename "$gemspec" .gemspec)"
      link="$RUBY_LOCAL_GEMS_HOME/$name"

      if [[ -L "$link" ]]; then
        [[ "$(readlink "$link")" == "$gemdir" ]] || warn "skipping $gemdir: $name is already linked to $(readlink "$link")"
        continue
      fi

      ln -s "$gemdir" "$link"
      anfs_info "Linked $name"
    done < <(find -L "$src" -name "*.gemspec" -exec dirname {} + | sort -u)
  done < <(_sources)
}

_write_gemfile() {
  local link
  anfs_info "Generating Gemfile..."
  {
    printf 'source "https://rubygems.org"\n\n'
    for link in "$RUBY_LOCAL_GEMS_HOME"/*; do
      [[ -L "$link" ]] || continue
      echo "gem \"$(basename "$link")\", path: \"$link/\""
    done
  } > "$RUBY_LOCAL_GEMS_HOME/Gemfile"
}

_bundle() {
  anfs_info "Running bundle install..."
  (
    cd "$RUBY_LOCAL_GEMS_HOME"
    bundle install --quiet
    bundle config set --local bin bin
    mkdir -p bin

    # Binstubs for gems with executables
    local link
    for link in *; do
      [[ -L "$link" ]] || continue
      compgen -G "$link/exe/*" >/dev/null || continue
      bundle binstubs "$link" --force 2>&1 | grep -v "has no executables" || true
      chmod +x "$link"/exe/*
    done

    chmod +x bin/* 2>/dev/null || true
  )
}

cmd_build() {
  [[ -f "$RUBY_LOCAL_GEMS_CONFIG" ]] || die "config file $RUBY_LOCAL_GEMS_CONFIG not found"
  [[ -n "$RUBY_LOCAL_GEMS_HOME" && "$RUBY_LOCAL_GEMS_HOME" != "/" ]] || die "RUBY_LOCAL_GEMS_HOME is not set"

  rm -rf "$RUBY_LOCAL_GEMS_HOME"
  mkdir -p "$RUBY_LOCAL_GEMS_HOME"
  _scan_for_gems
  _write_gemfile
  _bundle
}

cmd_list() {
  local link note rows=""

  for link in "$RUBY_LOCAL_GEMS_HOME"/*; do
    [[ -L "$link" ]] || continue
    note=""
    [[ -e "$link" ]] || note="missing"
    rows+="$(anfs_row "${link##*/}" "$(readlink "$link")" "$note")"$'\n'
  done
  printf '%s' "$rows" | anfs_table "GEM DIR NOTE" "gem dir note"

  [[ -n "$rows" ]] || anfs_json_on || warn "no gems linked; run: gem-local build"
}

cmd_path() {
  if [[ $# -eq 0 ]]; then
    echo "$RUBY_LOCAL_GEMS_HOME"
    return 0
  fi

  local link="$RUBY_LOCAL_GEMS_HOME/$1"
  [[ -L "$link" ]] || die "gem '$1' is not linked (see: gem-local list)"
  [[ -d "$link" ]] || die "gem '$1' links to missing $(readlink "$link")"
  (cd -P "$link" && pwd -P)
}

cmd_cd() {
  die "cd requires the gem-local shell function (source ~/.config/sh/ruby.sh)"
}

cmd_src_list() {
  local entry note rows=""

  while IFS= read -r entry; do
    note=""
    [[ -d "$(_expand "$entry")" ]] || note="missing"
    rows+="$(anfs_row "$(_expand "$entry")" "$note")"$'\n'
  done < <(_config_entries)
  printf '%s' "$rows" | anfs_table "PATH NOTE" "path note"

  [[ -n "$rows" ]] || anfs_json_on || warn "no repos configured; add one with: gem-local src add <dir>"
}

cmd_src_add() {
  local path entry existing
  path="$(cd -P "$1" 2>/dev/null && pwd -P)" || die "not a directory: $1"
  # Written the way the config prefers: ~ instead of $HOME
  entry="$(anfs_display "$path")"

  while IFS= read -r existing; do
    if [[ "$(_expand "$existing")" == "$path" ]]; then
      anfs_info "Already configured: $existing"
      return 0
    fi
  done < <(_config_entries)

  mkdir -p "$(dirname "$RUBY_LOCAL_GEMS_CONFIG")"
  # Append on a line of its own even if the file doesn't end in a newline
  [[ -s "$RUBY_LOCAL_GEMS_CONFIG" && -n "$(tail -c1 "$RUBY_LOCAL_GEMS_CONFIG")" ]] && echo >> "$RUBY_LOCAL_GEMS_CONFIG"
  echo "$entry" >> "$RUBY_LOCAL_GEMS_CONFIG"
  anfs_info "Added $entry to $(anfs_display "$RUBY_LOCAL_GEMS_CONFIG")"

  [[ -n "$(find -L "$path" -name "*.gemspec" -print -quit)" ]] || warn "no *.gemspec found under $entry"
  anfs_info "Run: gem-local build"
}

cmd_src_remove() {
  [[ -f "$RUBY_LOCAL_GEMS_CONFIG" ]] || die "config file $RUBY_LOCAL_GEMS_CONFIG not found"

  # Unlike add, a repo whose dir is gone must still be removable, so an
  # unresolvable path falls back to the argument as written
  local path entry line cmp tmp found=false
  path="$(cd -P "$1" 2>/dev/null && pwd -P)" || { path="$(_expand "$1")"; path="${path%/}"; }
  entry="$(anfs_display "$path")"

  tmp="$RUBY_LOCAL_GEMS_CONFIG.tmp.$$"
  : > "$tmp"
  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ ! "$line" =~ ^[[:space:]]*# ]] && [[ -n "${line// }" ]]; then
      cmp="$(_expand "$line")"
      if [[ "${cmp%/}" == "$path" || "$line" == "$1" ]]; then
        found=true
        continue
      fi
    fi
    printf '%s\n' "$line" >> "$tmp"
  done < "$RUBY_LOCAL_GEMS_CONFIG"

  if ! $found; then
    rm -f "$tmp"
    warn "not configured: $entry"
    return 0
  fi

  # Write back through the original file so its mode and ownership survive
  cat "$tmp" > "$RUBY_LOCAL_GEMS_CONFIG"
  rm -f "$tmp"
  anfs_info "Removed $entry from $(anfs_display "$RUBY_LOCAL_GEMS_CONFIG")"
  anfs_info "Run: gem-local build"
}

# What cli.sh asks for on a tab press (complete_<kind>): one candidate per line, quickly
complete_gem() {
  local link
  for link in "$RUBY_LOCAL_GEMS_HOME"/*; do
    [[ -L "$link" ]] && echo "${link##*/}"
  done
  return 0
}

cli_dispatch "$@"
