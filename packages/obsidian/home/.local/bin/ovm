#!/usr/bin/env bash
# ovm — Obsidian Vault Manager
#
# A vault is a directory of markdown documents with an ovm.yml at its root: an Obsidian vault, or
# any directory of markdown, Obsidian's or not (a plain tree, a git repo of docs). "Obsidian" is
# the name, not a restriction. Vaults are the entries of ~/vaults ($OVM_VAULTS_HOME), as spaces
# are ~/spaces': a directory there, or a link to one (a vault stored on iCloud is a link, declared
# by a package's links: entry), with an ovm.yml, which carries the vault's id. `ls ~/vaults` is
# the list; a vault is named by its entry.
#
# ovm does three things with a vault:
#
#   links      ovm.yml maps vault directories to wsm spaces (an id, as `wsm ls` has it: lgat,
#              lgat/tech/web). ovm puts a symlink in the space's directory pointing back into the
#              vault, so the documentation sits next to the code it describes. Knowledge of the
#              links is the vault's; the symlinks are machine-local and `ovm link apply` recreates
#              them. wsm tells ovm when a space is installed or removed (lib/anfs/callbacks.sh; this
#              package's install.sh registers), without knowing ovm exists.
#   documents  every document has frontmatter with a stable `id`, so it can be found whatever
#              its path becomes: `ovm docs`, `ovm path ID`, `ovm show ID`.
#   validate   documents are checked against the vault's `profile` (required keys, allowed
#              types). OKF itself only requires `type`; the profile is the real schema.
#
# Every command takes --json. Exit codes follow wsm: 1 not found, 2 ambiguous, 3 not a usable vault,
# 64 usage, 69 unavailable, 73 exists, 75 lock.
set -euo pipefail

OVM_VERSION=0.3.0

# Paths, messages, the log and the command line come from anfs
ANFS_LIB="$HOME/.local/lib/anfs"
if [[ ! -f "$ANFS_LIB/bash.sh" || ! -f "$ANFS_LIB/table.sh" ]]; then
  echo "ovm: $ANFS_LIB is missing or out of date; install core/anfs again" >&2
  exit 69
fi
# The bash floor, first: re-execs under bash 5 when this is macOS's 3.2
# shellcheck source=/dev/null
source "$ANFS_LIB/bash.sh"
# shellcheck source=/dev/null
source "$ANFS_LIB/paths.sh"
# shellcheck source=/dev/null
source "$ANFS_LIB/log.sh"
# shellcheck source=/dev/null
source "$ANFS_LIB/cli.sh"
# shellcheck source=/dev/null
source "$ANFS_LIB/table.sh"
# The config group (lib/anfs/config.sh), when core has it
# shellcheck source=/dev/null
if [[ -f "$ANFS_LIB/config.sh" ]]; then source "$ANFS_LIB/config.sh"; fi
# The links into vaults are made as every link the toolkit makes: relative (lib/anfs/link.sh)
# shellcheck source=/dev/null
source "$ANFS_LIB/link.sh"

anfs_tool_paths ovm
OVM_VAULTS_HOME="${OVM_VAULTS_HOME:-$HOME/vaults}"
OVM_VAULTS_HOME="${OVM_VAULTS_HOME%/}"
OVM_LOCK="$OVM_STATE_HOME/links.lock"
# The symlinks ovm made: what `remove` events and `link validate` work from
OVM_LINKS="$OVM_STATE_HOME/links"
OVM_CONFIG=ovm.yml
OVM_HOME=$(cd "$HOME" && pwd -P)

EX_NOTFOUND=1 EX_AMBIGUOUS=2 EX_STALE=3
EX_USAGE=64 EX_UNAVAIL=69 EX_EXISTS=73 EX_LOCK=75

CLI_TOOL=ovm
CLI_EX_USAGE=$EX_USAGE

# Ids, of vaults and of documents: 10 characters of lowercase base32. Short enough to type and to
# sit inside a firstmate task id, and nothing in them needs quoting anywhere.
ID_RE='^[a-z2-7]{10}$'
# Rows passed between functions use anfs's field separator (lib/anfs/table.sh): unlike a tab,
# bash's `read` does not fold empty fields away around it
US="$ANFS_US"

CLI_VERSION="$OVM_VERSION"
cli_cmd init "Make an entry of ~/vaults (default .) a vault: write ovm.yml, mint its id" --arg "[dir]"
cli_cmd new "Create ~/vaults/NAME and init it" --arg "name"
cli_cmd list "The entries of ~/vaults: the vaults" --alias ls
cli_cmd cd "Change to a vault (default: the one you are in) or a document's directory (requires the ovm shell function)" \
  --arg "[vault-or-doc]"
cli_cmd path "Print the path of a vault (default: the one you are in) or of a document" \
  --opt "--dir: A document's directory, not the file (what ovm cd goes to)" --arg "[vault-or-doc]"
cli_cmd docs "List documents: id, type, title, space, path" \
  --opt "--type TYPE: Only that type" --opt "--space SPEC: Only the documents of that wsm space" --arg "[dir]"
cli_cmd show "Print a document by id" --opt "--body: Leave out the frontmatter" --arg "doc"
cli_group link "Vault directories linked into wsm spaces"
cli_cmd "link add" "Link a directory (default .) into a space, and record it in ovm.yml" \
  --opt "--to SPEC: The wsm space (wsm ls): lgat, lgat/tech/web" \
  --opt "--as NAME: The symlink's name (default: the directory's)" --arg "[dir]"
cli_cmd "link remove" "Remove a directory's links and their ovm.yml entries" --alias rm \
  --opt "--to SPEC: Only the link to that space" \
  --opt "-y --yes: Do not ask before removing the links" --arg "[dir]"
cli_cmd "link list" "The configured links and their state" --alias ls --arg "[dir]"
cli_cmd "link apply" "Create this vault's links that are missing" \
  --opt "--event EVENT: From wsm: install or remove, for the spaces that follow" --arg "[spec...]"
cli_cmd "link validate" "Every vault's links that are missing, dangling or in conflict" --arg "[spec]"
cli_cmd validate "Check documents against the vault's profile" \
  --opt "--fix: Mint the ids that are missing" --opt "--strict: Exit 1 on any finding" --arg "[path]"
! declare -F anfs_config_declare >/dev/null || anfs_config_declare
cli_standard

cli_help_epilogue() {
  cat <<EOF
A vault is an entry of $(_display "$OVM_VAULTS_HOME") (OVM_VAULTS_HOME), a directory or a link to one,
with an ovm.yml; it is named by its entry, its id or a unique id prefix (4+ characters). A vault
stored elsewhere is a link there. SPEC is a wsm space (wsm ls): its id, the source and its path
(lgat, lgat/tech/web).
EOF
}

# --- Helpers ------------------------------------------------------------------------------

# Messages and the log are anfs's (lib/anfs/log.sh)
warn() { anfs_warn "$@"; }
die()  { anfs_die "$@"; }
fail() { anfs_fail "$@"; }
usage_err() { cli_usage "$@"; }

_display() { anfs_display "$1"; }

# The canonical path of an existing directory
_canon() { anfs_canon "$1"; }

_require_yq() { anfs_require yq "it is anfs's base software: brew install yq"; }

_new_id() {
  local id=""
  while [[ ${#id} -lt 10 ]]; do
    id+=$(head -c 64 /dev/urandom | LC_ALL=C tr -dc 'a-z2-7' || true)
  done
  printf '%s\n' "${id:0:10}"
}

# Lists and --json are anfs's (lib/anfs/table.sh): anfs_row, anfs_table, anfs_result

# What a command says when it is done; quiet with --json, where anfs_result speaks instead
say() { anfs_json_on || printf '%s\n' "$*"; }

# --- The marker: ovm.yml ------------------------------------------------------------------

# The id in <root>/ovm.yml, or nothing when there is none or it is not an id
_cfg_id() {
  local id
  [[ -f "$1/$OVM_CONFIG" ]] || return 0
  id=$(yq -r '.id // ""' "$1/$OVM_CONFIG" 2>/dev/null) || return 0
  [[ "$id" =~ $ID_RE ]] && printf '%s\n' "$id"
  return 0
}

# The root of the vault containing <dir>, or return 1. Checks $HOME itself but never walks above
# it, and stops at / for a start outside $HOME.
_find_root() {
  local dir
  dir=$(_canon "$1") || return 1
  while :; do
    [[ -f "$dir/$OVM_CONFIG" ]] && { printf '%s\n' "$dir"; return 0; }
    [[ "$dir" == "$OVM_HOME" || "$dir" == "/" ]] && return 1
    dir=$(dirname -- "$dir")
  done
}

# Whether <dir>/ovm.yml can be read within OVM_PROBE_SECONDS (3): a vault on a hung iCloud or
# network mount blocks every read of it, so ovm looks once, in a process an alarm can end, and
# leaves the vault alone after that. Remembered per path for the run.
declare -A OVM_REACH=()
_reachable() {
  local dir="$1"
  if [[ -z "${OVM_REACH[$dir]:-}" ]]; then
    if perl -e 'alarm shift; stat $ARGV[0]; exit 0' "${OVM_PROBE_SECONDS:-3}" "$dir/$OVM_CONFIG" 2>/dev/null
    then OVM_REACH[$dir]=yes
    else OVM_REACH[$dir]=no
    fi
  fi
  [[ "${OVM_REACH[$dir]}" == yes ]]
}

# --- The vaults: the entries of $OVM_VAULTS_HOME -------------------------------------------
#
# An entry (a directory, or a link to one) with an ovm.yml is a vault, named by the entry. There
# is no other list: a vault stored elsewhere (iCloud) is a link there, declared by a package's
# links: entry.

# The entry names of $OVM_VAULTS_HOME, one per line, hidden ones left out. Reads nothing in them.
_entries() {
  local e
  for e in "$OVM_VAULTS_HOME"/*; do
    [[ -e "$e" || -L "$e" ]] && printf '%s\n' "${e##*/}"
  done
  return 0
}

# Every entry, into parallel arrays: E_NAME, E_STATE (ok, unreachable, not a vault), E_ID and
# E_ROOT (the vault's canonical root when ok; else the entry, or what its link points at)
E_NAME=() E_STATE=() E_ID=() E_ROOT=()
_vaults_load() {
  local name e
  E_NAME=() E_STATE=() E_ID=() E_ROOT=()
  while IFS= read -r name; do
    [[ -n "$name" ]] || continue
    e="$OVM_VAULTS_HOME/$name"
    E_NAME+=("$name")
    if [[ -L "$e" && ! -e "$e" ]] || ! _reachable "$e"; then
      E_STATE+=(unreachable) E_ID+=("")
      if [[ -L "$e" ]]; then E_ROOT+=("$(readlink -- "$e")"); else E_ROOT+=("$e"); fi
    elif [[ ! -d "$e" || ! -f "$e/$OVM_CONFIG" ]]; then
      E_STATE+=("not a vault") E_ID+=("") E_ROOT+=("$e")
    else
      E_STATE+=(ok) E_ROOT+=("$(_canon "$e")") E_ID+=("$(_cfg_id "$e")")
    fi
  done < <(_entries)
}

# The name of the entry of $OVM_VAULTS_HOME that is the directory <root> (canonical), or return 1
_entry_of() {
  local root="$1" name e
  # The common case first: the entry has the directory's name
  e="$OVM_VAULTS_HOME/${root##*/}"
  if [[ -d "$e" ]] && _reachable "$e" && [[ "$e" -ef "$root" ]]; then printf '%s\n' "${root##*/}"; return 0; fi
  while IFS= read -r name; do
    e="$OVM_VAULTS_HOME/$name"
    [[ -d "$e" ]] && _reachable "$e" && [[ "$e" -ef "$root" ]] && { printf '%s\n' "$name"; return 0; }
  done < <(_entries)
  return 1
}

# The vault holding <dir>: VA_ROOT (its canonical root) and VA_NAME (its entry). Returns 1 when no
# ovm.yml holds <dir>; fails when the one that does is not an entry of $OVM_VAULTS_HOME.
VA_ROOT="" VA_NAME=""
_vault_of() {
  VA_ROOT=$(_find_root "$1") || return 1
  VA_NAME=$(_entry_of "$VA_ROOT") ||
    fail "$EX_NOTFOUND" "$(_display "$VA_ROOT") is not in $(_display "$OVM_VAULTS_HOME"): link it there (ln -s '$VA_ROOT' $(_display "$OVM_VAULTS_HOME")/<name>)"
}

# The vault you are in, or die
_here() {
  _vault_of "$PWD" || fail "$EX_NOTFOUND" "not inside a vault (no $OVM_CONFIG here or above): ovm new NAME, or name one"
}

# The entry <query> names, as V_I (index into E_*): its name, a vault id, or a unique id prefix of
# 4 or more. Returns 1 for no match, 2 for more than one (the candidates are in V_MATCHES).
V_I=-1 V_MATCHES=()
_vault_resolve() {
  local q="$1" i
  V_I=-1 V_MATCHES=()
  for i in "${!E_NAME[@]}"; do
    [[ "${E_NAME[$i]}" == "$q" ]] && { V_I=$i; return 0; }
  done
  for i in "${!E_ID[@]}"; do
    [[ -n "${E_ID[$i]}" && "${E_ID[$i]}" == "$q" ]] && { V_I=$i; return 0; }
  done
  if [[ ${#q} -ge 4 && "$q" =~ ^[a-z2-7]+$ ]]; then
    for i in "${!E_ID[@]}"; do
      [[ -n "${E_ID[$i]}" && "${E_ID[$i]}" == "$q"* ]] && V_MATCHES+=("$i")
    done
  fi
  case ${#V_MATCHES[@]} in
    0) return 1 ;;
    1) V_I=${V_MATCHES[0]}; return 0 ;;
    *) return 2 ;;
  esac
}

_ambiguous() {
  local i
  warn "'$1' matches more than one vault:"
  for i in "${V_MATCHES[@]}"; do
    printf '  %s  %s  %s\n' "${E_ID[$i]}" "${E_NAME[$i]}" "$(_display "${E_ROOT[$i]}")" >&2
  done
  exit "$EX_AMBIGUOUS"
}

# The roots of the vaults that answer, into LIVE (parallel: LIVE_ID, LIVE_NAME)
LIVE=() LIVE_ID=() LIVE_NAME=()
_live_vaults() {
  local i
  LIVE=() LIVE_ID=() LIVE_NAME=()
  _vaults_load
  for i in "${!E_NAME[@]}"; do
    case "${E_STATE[$i]}" in
      ok) LIVE+=("${E_ROOT[$i]}") LIVE_ID+=("${E_ID[$i]}") LIVE_NAME+=("${E_NAME[$i]}") ;;
      unreachable) warn "vault ${E_NAME[$i]} skipped: $(_display "${E_ROOT[$i]}") does not answer" ;;
    esac
  done
}

# --- Locking ------------------------------------------------------------------------------
#
# Guards the record of the links ovm made. mkdir is the atomic step; the file inside records
# when, because a directory's mtime cannot be read portably. Retry for 5s, then break a lock
# older than 60s: its holder is not coming back.

OVM_LOCK_HELD=false

_lock_try() {
  local tries=0
  while ! mkdir "$OVM_LOCK" 2>/dev/null; do
    tries=$((tries + 1))
    [[ $tries -ge 50 ]] && return 1
    sleep 0.1
  done
  printf '%(%s)T\n' -1 > "$OVM_LOCK/created" 2>/dev/null || true
  OVM_LOCK_HELD=true
  anfs_on_exit _lock_release
  trap '_lock_release; exit 130' INT TERM HUP
}

_lock_acquire() {
  local created now
  $OVM_LOCK_HELD && return 0
  mkdir -p "$OVM_STATE_HOME" || fail "$EX_LOCK" "cannot create $OVM_STATE_HOME"
  _lock_try && return 0
  created=$(cat -- "$OVM_LOCK/created" 2>/dev/null) || created=0
  [[ "$created" =~ ^[0-9]+$ ]] || created=0
  printf -v now '%(%s)T' -1
  if (( now - created > 60 )); then
    warn "clearing a stale lock at $OVM_LOCK"
    rm -rf "$OVM_LOCK"
    _lock_try && return 0
  fi
  fail "$EX_LOCK" "could not acquire $OVM_LOCK after 5s"
}

_lock_release() {
  $OVM_LOCK_HELD || return 0
  OVM_LOCK_HELD=false
  rm -rf "$OVM_LOCK"
}

# --- init, new, list ----------------------------------------------------------------------

cmd_init() {
  local dir="${1:-}"
  _require_yq
  local root parent id file name made=false
  root=$(_canon "${dir:-.}") || fail "$EX_NOTFOUND" "no such directory: ${dir:-.}"
  file="$root/$OVM_CONFIG"
  name=$(_entry_of "$root") ||
    fail "$EX_NOTFOUND" "$(_display "$root") is not in $(_display "$OVM_VAULTS_HOME"), where vaults are: ovm new NAME, or link it there (ln -s '$root' $(_display "$OVM_VAULTS_HOME")/<name>) and ovm init that"
  if [[ "$root" != / && "$root" != "$OVM_HOME" ]] && parent=$(_find_root "$(dirname -- "$root")"); then
    fail "$EX_EXISTS" "$(_display "$root") is inside the vault at $(_display "$parent"); a vault does not hold another"
  fi

  if [[ -f "$file" ]]; then
    yq -e 'tag == "!!map" or tag == "!!null"' "$file" >/dev/null 2>&1 || die "$(_display "$file") is not a YAML mapping"
    id=$(_cfg_id "$root")
    if [[ -z "$id" ]]; then
      id=$(_new_id)
      I="$id" yq -i '.id = strenv(I)' "$file"
      made=true
    fi
  else
    id=$(_new_id)
    cat > "$file" <<CFG
# An ovm vault (ovm help). The id is this vault's identity: do not change it. The vault's name is
# its entry in ~/vaults (OVM_VAULTS_HOME).
id: $id
# Directories linked into wsm spaces are recorded here: ovm link add DIR --to SPEC
#links:
#  - source: docs/product      # relative to this file
#    target: lgat/tech/web     # a wsm space (wsm ls)
#    as: product               # optional: the symlink's name; default is the directory's
# What \`ovm validate\` requires of every document's frontmatter
profile:
  required: [type, id]
  #types: [PRD, ADR, Note]    # allowed values of type; leave out to allow any
CFG
    made=true
  fi
  if $made; then
    say "initialized vault $name ($id) at $(_display "$root")"
  else
    say "vault $name ($id) at $(_display "$root") is initialized already"
  fi
  anfs_result id "$id" name "$name" path "$root" status "$($made && echo initialized || echo unchanged)"
}

cmd_new() {
  local name="$1" dir
  [[ -n "$name" && "$name" != */* && "$name" != .* ]] ||
    fail "$EX_USAGE" "a vault's name is an entry of $(_display "$OVM_VAULTS_HOME"), not a path: $name"
  dir="$OVM_VAULTS_HOME/$name"
  [[ ! -e "$dir" && ! -L "$dir" ]] || fail "$EX_EXISTS" "already exists: $(_display "$dir") (ovm init $(_display "$dir") makes it a vault)"
  mkdir -p -- "$dir" || die "cannot create $dir"
  cmd_init "$dir"
}

cmd_list() {
  local i
  _vaults_load
  for i in "${!E_NAME[@]}"; do
    printf '%s\n' "${E_NAME[$i]}$US${E_ID[$i]}$US${E_STATE[$i]}$US${E_ROOT[$i]}"
  done | anfs_table "NAME ID STATUS PATH" "name id status path"
}

# --- Documents ----------------------------------------------------------------------------
#
# A document is a .md file in a vault: not in a hidden directory (.obsidian, .git, .trash) or
# node_modules, and not index.md or log.md, which OKF reserves and which carry no frontmatter.

# One row per document that opens with frontmatter: path, ok|open (open: the block never closes),
# then its top-level id, type and title. A file with no frontmatter gives no row.
# shellcheck disable=SC2016
FM_AWK='
function val(s) {
  sub(/^[^:]*:[ \t]*/, "", s); sub(/[ \t\r]+$/, "", s)
  if (s ~ /^".*"$/ || s ~ /^\047.*\047$/) s = substr(s, 2, length(s) - 2)
  gsub(/\t/, " ", s)
  return s
}
function row(state) { printf "%s\037%s\037%s\037%s\037%s\n", file, state, id, type, title }
FNR == 1 {
  if (open) row("open")
  open = 0; file = FILENAME; id = ""; type = ""; title = ""
  line = $0; sub(/[ \t\r]+$/, "", line)
  if (line != "---") nextfile
  open = 1; next
}
open && /^---[ \t\r]*$/ { row("ok"); open = 0; nextfile }
open && /^id:/    { id = val($0) }
open && /^type:/  { type = val($0) }
open && /^title:/ { title = val($0) }
END { if (open) row("open") }
'

# The documents under <dir>, one path per line
_doc_files() {
  find "$1" -mindepth 1 \( -name '.*' -o -name node_modules \) -prune -o \
    -type f -name '*.md' ! -name index.md ! -name log.md -print 2>/dev/null | LC_ALL=C sort
}

# FM_AWK's rows for every document under <dir>
_doc_scan() {
  find "$1" -mindepth 1 \( -name '.*' -o -name node_modules \) -prune -o \
    -type f -name '*.md' ! -name index.md ! -name log.md -exec awk "$FM_AWK" {} + 2>/dev/null | LC_ALL=C sort
}

# A document's frontmatter, without the fences / its body, without the frontmatter
_fm_block() { awk 'NR == 1 { if ($0 !~ /^---[ \t\r]*$/) exit; next } /^---[ \t\r]*$/ { exit } { print }' "$1"; }
_doc_body() {
  awk 'NR == 1 && /^---[ \t\r]*$/ { fm = 1; next } fm == 1 { if (/^---[ \t\r]*$/) fm = 2; next } { print }' "$1"
}

# The links of the vault at <root>, into L_SRC, L_TGT, L_AS (the default name filled in)
L_SRC=() L_TGT=() L_AS=()
_links_load() {
  local root="$1" src tgt as
  L_SRC=() L_TGT=() L_AS=()
  [[ -f "$root/$OVM_CONFIG" ]] || return 0
  while IFS="$US" read -r src tgt as; do
    src="${src#./}" src="${src%/}" tgt="${tgt%/}"
    [[ -n "$src" && -n "$tgt" ]] || continue
    [[ -n "$as" ]] || as=$(_default_as "$root" "$src")
    L_SRC+=("$src") L_TGT+=("$tgt") L_AS+=("$as")
  done < <(yq -r ".links[]? | [.source // \"\", .target // \"\", .as // \"\"] | join(\"$US\")" "$root/$OVM_CONFIG" 2>/dev/null || true)
}

# The wsm space a path relative to the vault root belongs to: the link whose source holds it,
# the deepest one when links nest. Empty when no link does. Uses L_* (_links_load).
_space_of() {
  local rel="$1" i best="" len=-1 src
  for i in "${!L_SRC[@]}"; do
    src="${L_SRC[$i]}"
    if [[ "$src" == . || "$rel" == "$src" || "$rel" == "$src"/* ]]; then
      if [[ ${#src} -gt $len ]]; then len=${#src} best="${L_TGT[$i]}"; fi
    fi
  done
  printf '%s\n' "$best"
}

# Find a document by id in every live vault: D_PATH, D_ROOT, D_VAULT (name), D_VID. Returns 1
# when there is none; exits 2 when more than one document carries the id.
D_PATH="" D_ROOT="" D_VAULT="" D_VID=""
_doc_find() {
  local want="$1" v path state id type title
  local -a hits=() roots=() names=() vids=()
  _live_vaults
  for v in "${!LIVE[@]}"; do
    # grep narrows it to the files that mention the id; the frontmatter scan decides
    while IFS="$US" read -r path state id type title; do
      [[ "$id" == "$want" ]] || continue
      hits+=("$path") roots+=("${LIVE[$v]}") names+=("${LIVE_NAME[$v]}") vids+=("${LIVE_ID[$v]}")
    done < <(find "${LIVE[$v]}" -mindepth 1 \( -name '.*' -o -name node_modules \) -prune -o \
      -type f -name '*.md' ! -name index.md ! -name log.md -exec grep -lE "^id:[[:space:]]*[\"']?$want" {} + 2>/dev/null |
      while IFS= read -r path; do awk "$FM_AWK" "$path"; done)
  done
  case ${#hits[@]} in
    0) return 1 ;;
    1) D_PATH="${hits[0]}" D_ROOT="${roots[0]}" D_VAULT="${names[0]}" D_VID="${vids[0]}" ;;
    *)
      warn "more than one document has the id $want:"
      printf '  %s\n' "${hits[@]}" >&2
      exit "$EX_AMBIGUOUS"
      ;;
  esac
}

# ovm cd is the shell function's (sh/ovm.sh): it cds to what `ovm path --dir` prints
cmd_cd() {
  echo "ovm cd needs the ovm shell function (source ~/.config/sh/ovm.sh)" >&2
  exit 1
}

cmd_path() {
  local rc=0 path
  if [[ $# -eq 0 ]]; then
    _here
    if anfs_json_on; then anfs_result path "$VA_ROOT"; else printf '%s\n' "$VA_ROOT"; fi
    return 0
  fi
  _vaults_load
  _vault_resolve "$1" || rc=$?
  [[ $rc -ne 2 ]] || _ambiguous "$1"
  if [[ $rc -eq 0 ]]; then
    path="${E_ROOT[$V_I]}"
    [[ "${E_STATE[$V_I]}" == ok ]] || path="$OVM_VAULTS_HOME/${E_NAME[$V_I]}"
    if anfs_json_on; then anfs_result path "$path" kind vault; else printf '%s\n' "$path"; fi
    if [[ "${E_STATE[$V_I]}" != ok ]]; then
      warn "${E_NAME[$V_I]} is ${E_STATE[$V_I]} (ovm list)"
      return "$EX_STALE"
    fi
    return 0
  fi
  if [[ "$1" =~ $ID_RE ]] && _doc_find "$1"; then
    [[ "${CLI_OPT[dir]:-false}" != true ]] || D_PATH=$(dirname -- "$D_PATH")
    if anfs_json_on; then anfs_result path "$D_PATH" kind document; else printf '%s\n' "$D_PATH"; fi
    return 0
  fi
  fail "$EX_NOTFOUND" "no vault or document matching '$1'"
}

cmd_docs() {
  local path="${1:-}" want_type="${CLI_OPT[type]:-}" want_space="${CLI_OPT[space]:-}"
  want_space="${want_space%/}"
  _require_yq
  # Where to look: PATH (in its vault), else the vault you are in, else every vault
  local -a roots=() dirs=() names=()
  local root dir v
  if [[ -n "$path" ]]; then
    dir=$(_canon "$path") || fail "$EX_NOTFOUND" "no such directory: $path"
    _vault_of "$dir" || fail "$EX_NOTFOUND" "$(_display "$dir") is not inside a vault"
    roots=("$VA_ROOT") dirs=("$dir") names=("$VA_NAME")
  elif _vault_of "$PWD"; then
    roots=("$VA_ROOT") dirs=("$VA_ROOT") names=("$VA_NAME")
  else
    _live_vaults
    roots=("${LIVE[@]}") dirs=("${LIVE[@]}") names=("${LIVE_NAME[@]}")
  fi

  local file state id type title space shown
  for v in "${!roots[@]}"; do
    _links_load "${roots[$v]}"
    while IFS="$US" read -r file state id type title; do
      [[ -n "$file" ]] || continue
      space=$(_space_of "${file#"${roots[$v]}"/}")
      [[ -z "$want_type" || "$type" == "$want_type" ]] || continue
      [[ -z "$want_space" || "$space" == "$want_space" ]] || continue
      printf '%s\n' "$id$US$type$US$title$US$space$US$file$US${names[$v]}"
    done < <(_doc_scan "${dirs[$v]}")
  done | anfs_table "ID TYPE TITLE SPACE PATH VAULT" "id type title space path vault"
}

cmd_show() {
  local want="$1" body=${CLI_OPT[body]:-false}
  _require_yq
  _doc_find "$want" || fail "$EX_NOTFOUND" "no document with the id '$want' in any vault (ovm docs)"
  if ! anfs_json_on; then
    if $body; then _doc_body "$D_PATH"; else cat -- "$D_PATH"; fi
    return 0
  fi
  # The frontmatter and the body go through files: a document can be larger than one
  # environment string may be
  local tmp space
  tmp=$(mktemp -d "${TMPDIR:-/tmp}/ovm-show.XXXXXX")
  anfs_on_exit "rm -rf '$tmp'"
  _fm_block "$D_PATH" > "$tmp/fm.yml"
  _doc_body "$D_PATH" > "$tmp/body"
  [[ -s "$tmp/fm.yml" ]] || echo '{}' > "$tmp/fm.yml"
  _links_load "$D_ROOT"
  space=$(_space_of "${D_PATH#"$D_ROOT"/}")
  ID="$want" VAULT="$D_VAULT" VID="$D_VID" P="$D_PATH" SPACE="$space" FM="$tmp/fm.yml" BODY="$tmp/body" \
    yq -n -o=json '{
      "id": strenv(ID), "vault": strenv(VAULT), "vault_id": strenv(VID), "path": strenv(P),
      "space": strenv(SPACE), "frontmatter": load(strenv(FM)), "body": load_str(strenv(BODY))
    } | (select(.space == "") | .space) = null' ||
    die "the frontmatter of $(_display "$D_PATH") does not parse (ovm validate)"
}

# --- Links --------------------------------------------------------------------------------
#
# A link is <space's directory>/<as> -> <vault>/<source>. The space's directory comes from wsm
# (`wsm ls --json`: space and dir, null when the space is not installed), so ovm.yml holds no
# absolute path and works on another machine. One tool reads another's list as JSON, never by
# column (lib/anfs/table.sh).

declare -A WSM_DIR=() WSM_KNOWN=()
WSM_LOADED=false
_wsm_load() {
  local id dir
  $WSM_LOADED && return 0
  command -v wsm >/dev/null 2>&1 || fail "$EX_UNAVAIL" "wsm is required for links (ppm install core/wsm)"
  WSM_DIR=() WSM_KNOWN=()
  while IFS="$US" read -r id dir; do
    id="${id%/}"
    [[ -n "$id" ]] || continue
    WSM_KNOWN[$id]=1
    WSM_DIR[$id]="$dir"
  done < <(wsm ls --json 2>/dev/null | yq -p json -r ".[] | .space + \"$US\" + (.dir // \"\")" 2>/dev/null || true)
  WSM_LOADED=true
}

# The record of the symlinks ovm made: path, vault id, what it points at, the space. Loaded into
# R_PATH, R_VID, R_DEST, R_TGT.
R_PATH=() R_VID=() R_DEST=() R_TGT=()
_rec_load() {
  local path vid dest tgt
  R_PATH=() R_VID=() R_DEST=() R_TGT=()
  [[ -f "$OVM_LINKS" ]] || return 0
  while IFS="$US" read -r path vid dest tgt; do
    [[ -n "$path" ]] || continue
    R_PATH+=("$path") R_VID+=("$vid") R_DEST+=("$dest") R_TGT+=("$tgt")
  done < "$OVM_LINKS"
}
# Rewrite the record without <path>, then with it again when the other three are given
_rec_set() {
  local path="$1" i tmp="$OVM_LINKS.tmp.$$"
  _lock_acquire
  _rec_load
  for i in "${!R_PATH[@]}"; do
    [[ "${R_PATH[$i]}" == "$path" ]] && continue
    printf '%s\n' "${R_PATH[$i]}$US${R_VID[$i]}$US${R_DEST[$i]}$US${R_TGT[$i]}"
  done > "$tmp"
  [[ $# -lt 4 ]] || printf '%s\n' "$path$US$2$US$3$US$4" >> "$tmp"
  mv -- "$tmp" "$OVM_LINKS"
  _lock_release
}

# Where one link stands. Sets LS_STATE, LS_PATH (the symlink), LS_DEST (what it should point at):
#   ok        the symlink is there and points into the vault
#   missing   the space is installed and nothing is at the symlink's path
#   pending   the space is not installed; wsm will say when it is
#   unknown   no source defines the space
#   conflict  something else is at the symlink's path
#   dangling  the vault directory is gone (the symlink, if any, points at nothing)
LS_STATE="" LS_PATH="" LS_DEST=""
_link_state() {
  local root="$1" src="$2" tgt="$3" as="$4" dir
  LS_DEST="$root/$src" LS_PATH=""
  [[ "$src" != . ]] || LS_DEST="$root"
  if [[ -z "${WSM_KNOWN[$tgt]:-}" ]]; then LS_STATE=unknown; return 0; fi
  dir="${WSM_DIR[$tgt]:-}"
  if [[ -z "$dir" ]]; then LS_STATE=pending; return 0; fi
  LS_PATH="$dir/$as"
  if [[ ! -d "$LS_DEST" ]]; then LS_STATE=dangling; return 0; fi
  if [[ -L "$LS_PATH" ]]; then
    if _points_at "$LS_PATH" "$LS_DEST"; then LS_STATE=ok; else LS_STATE=conflict; fi
  elif [[ -e "$LS_PATH" ]]; then
    LS_STATE=conflict
  else
    LS_STATE=missing
  fi
}

# True when the symlink <path> leads to <dest>: as written, or once both are resolved (a link
# made by hand may spell the same directory another way)
_points_at() {
  local to
  to=$(readlink -- "$1" 2>/dev/null) || return 1
  [[ "$to" == "$2" ]] && return 0
  [[ -d "$1" && -d "$2" && "$(_canon "$1")" == "$(_canon "$2")" ]]
}

# The name a link gets when ovm.yml gives none: the directory's, or the vault's (its entry in
# ~/vaults) for its root
_default_as() {
  if [[ "$2" == . ]]; then _entry_of "$1" || printf '%s\n' "${1##*/}"; else printf '%s\n' "${2##*/}"; fi
}

# A symlink in a cloned repo would show up there as an untracked file
_in_git() { [[ "$(git -C "$1" rev-parse --is-inside-work-tree 2>/dev/null)" == true ]]; }

# Bring one link into being. Returns 1 when it could not be (and says why).
# Usage: _link_make <root> <vault id> <source> <target> <as>
_link_make() {
  local root="$1" vid="$2" src="$3" tgt="$4" as="$5"
  _link_state "$root" "$src" "$tgt" "$as"
  case "$LS_STATE" in
    ok)
      _rec_set "$LS_PATH" "$vid" "$LS_DEST" "$tgt"
      ;;
    missing)
      if _in_git "${LS_PATH%/*}"; then
        warn "not linking $src: $(_display "${LS_PATH%/*}") is inside a git repository, where the link would be an untracked file"
        return 1
      fi
      anfs_link_one "$LS_DEST" "$LS_PATH" || { warn "cannot link $(_display "$LS_PATH")"; return 1; }
      _rec_set "$LS_PATH" "$vid" "$LS_DEST" "$tgt"
      say "linked $(_display "$LS_PATH") -> $(_display "$LS_DEST")"
      ;;
    pending)  say "pending $src -> $tgt: the space is not installed (wsm install $tgt)" ;;
    unknown)  warn "$src: no wsm space '$tgt' (wsm ls)"; return 1 ;;
    dangling) warn "$src: no such directory in the vault: $(_display "$LS_DEST")"; return 1 ;;
    conflict) warn "$src: $(_display "$LS_PATH") exists and is not this link; move it away, or pick another name with --as"; return 1 ;;
  esac
}

# Remove a symlink ovm made, if it still is one: never anything that replaced it
_link_drop() {
  local path="$1" dest="$2"
  if [[ -L "$path" ]] && _points_at "$path" "$dest"; then
    rm -f -- "$path"
    say "unlinked $(_display "$path")"
  fi
  _rec_set "$path"
}

# The vault directory an argument names, as a path relative to its vault's root: LK_ROOT, LK_SRC
LK_ROOT="" LK_SRC=""
_link_dir() {
  local dir
  dir=$(_canon "${1:-.}") || fail "$EX_NOTFOUND" "no such directory: ${1:-.}"
  _vault_of "$dir" || fail "$EX_NOTFOUND" "$(_display "$dir") is not inside a vault"
  LK_ROOT="$VA_ROOT"
  LK_SRC=.
  [[ "$dir" == "$LK_ROOT" ]] || LK_SRC="${dir#"$LK_ROOT"/}"
}

cmd_link_add() {
  local dir="${1:-}" to="${CLI_OPT[to]:-}" as="${CLI_OPT[as]:-}"
  to="${to%/}"
  [[ -n "$to" ]] || cli_usage_err "--to SPEC is required"
  [[ "$as" != */* && "$as" != . && "$as" != .. ]] || fail "$EX_USAGE" "--as is a name, not a path: $as"
  _require_yq
  _link_dir "$dir"
  _wsm_load
  [[ -n "${WSM_KNOWN[$to]:-}" ]] || fail "$EX_NOTFOUND" "no wsm space '$to' (wsm ls)"
  local name="$as" vid file="$LK_ROOT/$OVM_CONFIG"
  [[ -n "$name" ]] || name=$(_default_as "$LK_ROOT" "$LK_SRC")
  vid=$(_cfg_id "$LK_ROOT")
  [[ -n "$vid" ]] || die "$(_display "$file") has no id: ovm init $(_display "$LK_ROOT")"

  # Everything that would refuse the link, before ovm.yml changes
  _link_state "$LK_ROOT" "$LK_SRC" "$to" "$name"
  case "$LS_STATE" in
    conflict) fail "$EX_EXISTS" "$(_display "$LS_PATH") exists and is not this link; move it away, or pick another name with --as" ;;
    missing)
      ! _in_git "${LS_PATH%/*}" ||
        fail "$EX_UNAVAIL" "$(_display "${LS_PATH%/*}") is inside a git repository, where the link would be an untracked file"
      ;;
  esac

  # One entry per source and space: adding it again replaces it, and a link it had under
  # another name goes. ("=" marks an entry, so one without `as` is told from none at all.)
  local old
  old=$(S="$LK_SRC" T="$to" yq -r '.links[]? | select(.source == strenv(S) and .target == strenv(T)) | "=" + (.as // "")' "$file" | head -n 1)
  S="$LK_SRC" T="$to" yq -i 'del(.links[]? | select(.source == strenv(S) and .target == strenv(T)))' "$file"
  if [[ -n "$as" ]]; then
    S="$LK_SRC" T="$to" A="$as" yq -i '.links += [{"source": strenv(S), "target": strenv(T), "as": strenv(A)}]' "$file"
  else
    S="$LK_SRC" T="$to" yq -i '.links += [{"source": strenv(S), "target": strenv(T)}]' "$file"
  fi
  if [[ -n "$old" && -n "${WSM_DIR[$to]:-}" ]]; then
    old="${old#=}"
    [[ -n "$old" ]] || old=$(_default_as "$LK_ROOT" "$LK_SRC")
    [[ "$old" == "$name" ]] || _link_drop "${WSM_DIR[$to]}/$old" "$LS_DEST"
  fi
  local rc=0
  _link_make "$LK_ROOT" "$vid" "$LK_SRC" "$to" "$name" || rc=1
  anfs_result source "$LK_SRC" target "$to" as "$name" status "$LS_STATE" link "$LS_PATH"
  return "$rc"
}

cmd_link_remove() {
  local dir="${1:-}" to="${CLI_OPT[to]:-}"
  to="${to%/}"
  _require_yq
  _link_dir "$dir"
  _links_load "$LK_ROOT"
  _wsm_load
  local i n=0 file="$LK_ROOT/$OVM_CONFIG"
  for i in "${!L_SRC[@]}"; do
    [[ "${L_SRC[$i]}" == "$LK_SRC" && ( -z "$to" || "${L_TGT[$i]}" == "$to" ) ]] && n=$((n + 1))
  done
  [[ $n -eq 0 ]] || anfs_confirm "link remove removes $n links of $LK_SRC and their entries in $(_display "$file")" "Remove them?"
  n=0
  for i in "${!L_SRC[@]}"; do
    [[ "${L_SRC[$i]}" == "$LK_SRC" ]] || continue
    [[ -z "$to" || "${L_TGT[$i]}" == "$to" ]] || continue
    n=$((n + 1))
    _link_state "$LK_ROOT" "${L_SRC[$i]}" "${L_TGT[$i]}" "${L_AS[$i]}"
    [[ -z "$LS_PATH" ]] || _link_drop "$LS_PATH" "$LS_DEST"
    S="${L_SRC[$i]}" T="${L_TGT[$i]}" yq -i 'del(.links[]? | select(.source == strenv(S) and .target == strenv(T)))' "$file"
    say "removed $LK_SRC -> ${L_TGT[$i]} from $(_display "$file")"
  done
  [[ $n -gt 0 ]] || fail "$EX_NOTFOUND" "no link of $LK_SRC${to:+ to $to} in $(_display "$file") (ovm link ls)"
  # An empty list reads better gone
  yq -i 'del(.links | select(length == 0))' "$file"
  anfs_result source "$LK_SRC" removed "$n"
}

# Rows for the links of the vaults in ROOTS (parallel NAMES): source, target, as, state, the
# symlink's path, vault name
_link_rows() {
  local v i
  for v in "${!ROOTS[@]}"; do
    _links_load "${ROOTS[$v]}"
    for i in "${!L_SRC[@]}"; do
      _link_state "${ROOTS[$v]}" "${L_SRC[$i]}" "${L_TGT[$i]}" "${L_AS[$i]}"
      printf '%s\n' "${L_SRC[$i]}$US${L_TGT[$i]}$US${L_AS[$i]}$US$LS_STATE$US$LS_PATH$US${NAMES[$v]}"
    done
  done
}

cmd_link_list() {
  _require_yq
  local -a ROOTS=() NAMES=()
  local rel="" src tgt as state path vault
  if [[ $# -eq 1 ]]; then
    _link_dir "$1"
    ROOTS=("$LK_ROOT") NAMES=("$VA_NAME")
    [[ "$LK_SRC" == . ]] || rel="$LK_SRC"
  elif _vault_of "$PWD"; then
    ROOTS=("$VA_ROOT") NAMES=("$VA_NAME")
  else
    _live_vaults
    ROOTS=("${LIVE[@]}") NAMES=("${LIVE_NAME[@]}")
  fi
  _wsm_load
  _link_rows | while IFS="$US" read -r src tgt as state path vault; do
    # With PATH: the links at or below it, and the ones that hold it
    [[ -z "$rel" || "$src" == . || "$src" == "$rel" || "$src" == "$rel"/* || "$rel" == "$src"/* ]] || continue
    printf '%s\n' "$src$US$tgt$US$as$US$state$US$path$US$vault"
  done | anfs_table "SOURCE TARGET AS STATUS LINK VAULT" "source target as status link vault"
}

cmd_link_apply() {
  local event="${CLI_OPT[event]:-}" arg
  local -a specs=("$@")
  _require_yq
  local i v rc=0 vid root
  if [[ -z "$event" ]]; then
    _here; root="$VA_ROOT"
    vid=$(_cfg_id "$root")
    [[ -n "$vid" ]] || die "$(_display "$root/$OVM_CONFIG") has no id: ovm init"
    _wsm_load
    _links_load "$root"
    [[ ${#L_SRC[@]} -gt 0 ]] || say "no links in $(_display "$root/$OVM_CONFIG") (ovm link add DIR --to SPEC)"
    for i in "${!L_SRC[@]}"; do
      _link_make "$root" "$vid" "${L_SRC[$i]}" "${L_TGT[$i]}" "${L_AS[$i]}" || rc=1
    done
    anfs_result applied "${#L_SRC[@]}" ok "$([[ $rc -eq 0 ]] && echo true || echo false)"
    return "$rc"
  fi

  # From wsm, for the spaces it just installed or removed. Never fails the tool that emitted:
  # what could not be done is said, and `ovm link validate` shows it later.
  local -A want=()
  for arg in "${specs[@]}"; do want[${arg%/}]=1; done
  [[ ${#want[@]} -gt 0 ]] || return 0
  case "$event" in
    install)
      _wsm_load
      _live_vaults
      for v in "${!LIVE[@]}"; do
        _links_load "${LIVE[$v]}"
        for i in "${!L_SRC[@]}"; do
          [[ -n "${want[${L_TGT[$i]}]:-}" ]] || continue
          _link_make "${LIVE[$v]}" "${LIVE_ID[$v]}" "${L_SRC[$i]}" "${L_TGT[$i]}" "${L_AS[$i]}" || true
        done
      done
      ;;
    remove)
      # The space is gone from wsm, so its directory is only in the record of what ovm linked
      _rec_load
      local -a paths=("${R_PATH[@]}") dests=("${R_DEST[@]}") tgts=("${R_TGT[@]}")
      for i in "${!paths[@]}"; do
        [[ -n "${want[${tgts[$i]}]:-}" ]] || continue
        _link_drop "${paths[$i]}" "${dests[$i]}"
      done
      ;;
    *) cli_usage_err "unknown event '$event': install or remove" ;;
  esac
  return 0
}

cmd_link_validate() {
  _require_yq
  local spec="${1:-}" src tgt as state path vault i n=0
  spec="${spec%/}"
  local -a ROOTS=() NAMES=() rows=()
  local -A configured=()
  _live_vaults
  ROOTS=("${LIVE[@]}") NAMES=("${LIVE_NAME[@]}")
  _wsm_load
  while IFS="$US" read -r src tgt as state path vault; do
    [[ -n "$src" ]] || continue
    [[ -z "$path" ]] || configured[$path]=1
    [[ -z "$spec" || "$tgt" == "$spec" ]] || continue
    case "$state" in ok|pending) continue ;; esac
    rows+=("$src$US$tgt$US$as$US$state$US$path$US$vault")
  done < <(_link_rows)
  # A symlink ovm made whose entry has left every ovm.yml
  _rec_load
  for i in "${!R_PATH[@]}"; do
    [[ -z "${configured[${R_PATH[$i]}]:-}" && -L "${R_PATH[$i]}" ]] || continue
    [[ -z "$spec" || "${R_TGT[$i]}" == "$spec" ]] || continue
    rows+=("$US${R_TGT[$i]}$US${R_PATH[$i]##*/}${US}orphan$US${R_PATH[$i]}$US")
  done
  n=${#rows[@]}
  if [[ $n -gt 0 ]]; then
    printf '%s\n' "${rows[@]}"
  fi | anfs_table "SOURCE TARGET AS STATUS LINK VAULT" "source target as status link vault"
  if [[ $n -eq 0 ]]; then
    say "all links ok"
    return 0
  fi
  return 1
}

# --- validate -----------------------------------------------------------------------------

# Put `id: <id>` into a document's frontmatter: on its empty id line, else as its last line
_doc_set_id() {
  local file="$1" id="$2" tmp
  tmp=$(mktemp "${TMPDIR:-/tmp}/ovm-id.XXXXXX")
  awk -v id="$id" '
    NR == 1 { print; fm = 1; next }
    fm == 1 && /^id:/ { print "id: " id; done = 1; next }
    fm == 1 && /^---[ \t\r]*$/ { if (!done) print "id: " id; fm = 2 }
    { print }
  ' "$file" > "$tmp"
  # Written through, not moved over: the file keeps its inode, mode and whatever syncs it
  cat -- "$tmp" > "$file"
  rm -f -- "$tmp"
}

cmd_validate() {
  local path="${1:-}" fix=${CLI_OPT[fix]:-false} strict=${CLI_OPT[strict]:-false}
  _require_yq
  local scope root file
  if [[ -n "$path" ]]; then
    [[ -e "$path" ]] || fail "$EX_NOTFOUND" "no such file or directory: $path"
    if [[ -d "$path" ]]; then scope=$(_canon "$path"); else scope="$(_canon "$(dirname -- "$path")")/${path##*/}"; fi
    _vault_of "$( [[ -d "$scope" ]] && echo "$scope" || dirname -- "$scope")" ||
      fail "$EX_NOTFOUND" "$(_display "$scope") is not inside a vault"
    root="$VA_ROOT"
  else
    _here
    root="$VA_ROOT" scope="$VA_ROOT"
  fi
  file="$root/$OVM_CONFIG"

  # The profile: what every document must have. With none, OKF's type and ovm's id.
  local -a required=() types=()
  mapfile -t required < <(yq -r '.profile.required // ["type", "id"] | .[]' "$file" 2>/dev/null)
  mapfile -t types < <(yq -r '.profile.types // [] | .[]' "$file" 2>/dev/null)

  # The whole vault's ids, so a duplicate outside PATH is still one
  local -A state_of=() id_of=() type_of=() count=() first=()
  local f state id type title
  while IFS="$US" read -r f state id type title; do
    [[ -n "$f" ]] || continue
    state_of[$f]="$state" id_of[$f]="$id" type_of[$f]="$type"
    [[ -n "$id" ]] || continue
    count[$id]=$(( ${count[$id]:-0} + 1 ))
    [[ -n "${first[$id]:-}" ]] || first[$id]="$f"
  done < <(_doc_scan "$root")

  local -a docs=() rows=()
  if [[ -d "$scope" ]]; then
    mapfile -t docs < <(_doc_files "$scope")
  else
    docs=("$scope")
  fi

  local rel keys key t ok minted=0 new
  for f in "${docs[@]}"; do
    [[ -n "$f" ]] || continue
    rel="${f#"$root"/}"
    case "${state_of[$f]:-none}" in
      none) rows+=("$rel${US}no frontmatter"); continue ;;
      open) rows+=("$rel${US}the frontmatter is not closed (no second ---)"); continue ;;
    esac
    # The top-level keys that have a value
    if ! keys=$(_fm_block "$f" | yq -r '(. // {}) | to_entries | .[] | select(.value != null and .value != "") | .key' 2>/dev/null); then
      rows+=("$rel${US}the frontmatter does not parse as YAML")
      continue
    fi
    id="${id_of[$f]}"
    if $fix && ! grep -qxF id <<< "$keys"; then
      new=$(_new_id)
      while [[ -n "${count[$new]:-}" ]]; do new=$(_new_id); done
      _doc_set_id "$f" "$new"
      count[$new]=1 first[$new]="$f" id="$new"
      keys+=$'\n'id
      minted=$((minted + 1))
      say "$rel: minted id $new"
    fi
    for key in "${required[@]}"; do
      grep -qxF -- "$key" <<< "$keys" || rows+=("$rel${US}missing required key: $key")
    done
    if [[ ${#types[@]} -gt 0 && -n "${type_of[$f]}" ]]; then
      ok=false
      for t in "${types[@]}"; do [[ "$t" == "${type_of[$f]}" ]] && ok=true; done
      $ok || rows+=("$rel${US}type '${type_of[$f]}' is not one of: ${types[*]}")
    fi
    if [[ -n "$id" && ${count[$id]:-0} -gt 1 ]]; then
      rows+=("$rel${US}duplicate id $id$( [[ "${first[$id]}" == "$f" ]] || printf ' (also %s)' "${first[$id]#"$root"/}")")
    fi
  done

  if anfs_json_on; then
    if [[ ${#rows[@]} -gt 0 ]]; then printf '%s\n' "${rows[@]}"; fi | anfs_table "PATH FINDING" "path finding"
  else
    for f in "${rows[@]}"; do printf '%s: %s\n' "${f%%"$US"*}" "${f#*"$US"}"; done
    say "${#docs[@]} document(s), ${#rows[@]} finding(s)$( [[ $minted -eq 0 ]] || printf ', %d id(s) minted' "$minted")"
  fi
  if $strict && [[ ${#rows[@]} -gt 0 ]]; then return 1; fi
  return 0
}

# --- Completion ---------------------------------------------------------------------------
#
# What cli.sh asks for on a tab press (complete_<kind>): one candidate per line, quickly. No yq.

# The entries of ~/vaults, without looking inside them (a hung iCloud must not hang a tab press)
complete_vault() {
  local name
  while IFS= read -r name; do
    printf '%s\t%s\n' "$name" "$(anfs_display "$OVM_VAULTS_HOME/$name")"
  done < <(_entries)
}
complete_vault_or_doc() { complete_vault; }
# A wsm space: wsm's to say
complete_spec() { command wsm __complete install "" 2>/dev/null | cut -f1; }

# --- Dispatch -----------------------------------------------------------------------------

cli_globals "$@"
set -- "${CLI_ARGS[@]}"

cli_dispatch "$@"
