#!/usr/bin/env bash
# ovm — Obsidian Vault Manager
#
# A vault is a directory of markdown documents with a vault.yml at its root: an Obsidian vault, or
# any directory of markdown, Obsidian's or not (a plain tree, a git repo of docs). "Obsidian" is
# the name, not a restriction. Vaults are the entries of ~/vaults ($OVM_VAULTS_HOME), as spaces
# are ~/spaces': a directory there, or a link to one (a vault stored on iCloud is a link, declared
# by a package's links: entry), with a vault.yml, which carries the vault's id. `ls ~/vaults` is
# the list; a vault is named by its entry. A vault space is any folder under the vault's
# spaces_path (vault.yml, default spaces; . is the vault's root), named by its path there:
# <vault>/<path> (apex/anfs/product). A document's space is the deepest linked one holding it.
#
# ovm does three things with a vault:
#
#   spaces     vault spaces linked into wsm spaces (an id, as `wsm ls` has it: lgat,
#              lgat/tech/web), as ~/.config/ovm/links.yml declares: the person's, not the vault's
#              and not wsm's (links.local.yml beside it for one machine). ovm puts a symlink in
#              the wsm space's directory pointing back into the vault, so the documentation sits
#              next to the code it describes; `ovm space apply` makes the missing ones. wsm tells
#              ovm when a space is installed or removed (lib/anfs/callbacks.sh; this package's
#              install.sh registers), without knowing ovm exists.
#   documents  every document has frontmatter with a stable `id`, so it can be found whatever
#              its path becomes: `ovm docs`, `ovm path ID`, `ovm show ID`.
#   validate   documents are checked against the vocabulary in vault.yml (required keys, kinds,
#              field types, tags), vault-wide and per vault space.
#
# Every command takes --json. Exit codes follow wsm: 1 not found, 2 ambiguous, 3 not a usable vault,
# 64 usage, 69 unavailable, 73 exists, 75 lock.
set -euo pipefail
# A job's copy of this tool runs instead when ANFS_WORK names one (lib/anfs/work.sh)
[ -z "${ANFS_WORK:-}" ] || [ ! -f "$HOME/.local/lib/anfs/work.sh" ] || . "$HOME/.local/lib/anfs/work.sh"

OVM_VERSION=0.7.0

# Paths, messages, the log and the command line come from anfs
if [[ ! -f "$HOME/.local/lib/anfs/paths.sh" ]]; then
  echo "ovm: ~/.local/lib/anfs is missing or out of date; install core/anfs again" >&2
  exit 69
fi
# The bash floor, first: re-execs under bash 5 when this is macOS's 3.2
# shellcheck source=/dev/null
source "$HOME/.local/lib/anfs/bash.sh"
# shellcheck source=/dev/null
source "$HOME/.local/lib/anfs/paths.sh"
if [[ ! -f "$ANFS_LIB_DIR/table.sh" ]]; then
  echo "ovm: $ANFS_LIB_DIR is out of date; install core/anfs again" >&2
  exit 69
fi
# shellcheck source=/dev/null
source "$ANFS_LIB_DIR/log.sh"
# shellcheck source=/dev/null
source "$ANFS_LIB_DIR/cli.sh"
# shellcheck source=/dev/null
source "$ANFS_LIB_DIR/table.sh"
# The config group (lib/anfs/config.sh), when core has it
# shellcheck source=/dev/null
if [[ -f "$ANFS_LIB_DIR/config.sh" ]]; then source "$ANFS_LIB_DIR/config.sh"; fi
# The links into vaults are made as every link the toolkit makes: relative (lib/anfs/link.sh)
# shellcheck source=/dev/null
source "$ANFS_LIB_DIR/link.sh"

anfs_tool_paths ovm
OVM_VAULTS_HOME="${OVM_VAULTS_HOME:-$HOME/vaults}"
OVM_VAULTS_HOME="${OVM_VAULTS_HOME%/}"
OVM_LOCK="$OVM_STATE_HOME/links.lock"
# The symlinks ovm made: what `remove` events and `space list`'s orphans work from
OVM_LINKS="$OVM_STATE_HOME/links"
# Which vault spaces are linked into which wsm spaces: the person's (their repository's layer may
# ship it), and this machine's additions beside it
OVM_LINKS_YML="$OVM_CONFIG_HOME/links.yml"
OVM_LINKS_LOCAL="$OVM_CONFIG_HOME/links.local.yml"
OVM_CONFIG=vault.yml
OVM_HOME=$(cd "$HOME" && pwd -P)

EX_NOTFOUND=1 EX_AMBIGUOUS=2 EX_STALE=3
EX_USAGE=64 EX_UNAVAIL=69 EX_EXISTS=73 EX_LOCK=75

CLI_TOOL=ovm
CLI_EX_USAGE=$EX_USAGE

# Ids, of vaults and of documents: 10 characters of lowercase base32. Short enough to type and to
# sit inside a firstmate task id, and nothing in them needs quoting anywhere.
ID_RE='^[a-z2-7]{10}$'
# Rows passed between functions use anfs's field separator (lib/anfs/table.sh): unlike a tab,
# bash's `read` does not fold empty fields away around it
US="$ANFS_US"

# A second separator, for the parts of a YAML path (_yaml_dump)
RS=$'\x1e'

CLI_VERSION="$OVM_VERSION"
cli_cmd init "Make an entry of ~/vaults (default .) a vault: vault.yml; in a fresh one (no .obsidian/) our plugin settings and templates; then what sync does" \
  --opt "--no-plugins: vault.yml, the settings and the templates only (nothing downloaded)" --arg "[dir]"
cli_cmd new "Create ~/vaults/NAME and init it" \
  --opt "--no-plugins: vault.yml, the settings and the templates only (nothing downloaded)" --arg "name"
cli_cmd sync "Place the pinned plugins a vault is missing and enable them; nothing there is touched (every vault if none given)" \
  --arg "[vault...]"
cli_cmd update "Bring the plugins in a vault to the pinned versions; nothing else (every vault if none given)" \
  --arg "[vault...]"
cli_cmd list "The entries of ~/vaults: the vaults" --alias ls
cli_cmd cd "Change to a vault (default: the one you are in) or a document's directory (requires the ovm shell function)" \
  --arg "[vault-or-doc]"
cli_cmd path "Print the path of a vault (default: the one you are in) or of a document" \
  --opt "--dir: A document's directory, not the file (what ovm cd goes to)" --arg "[vault-or-doc]"
cli_cmd docs "List documents: id, type, title, space, path (of a vault, a vault space or a DIR)" \
  --opt "--type TYPE: Only that type" \
  --opt "--space VAULT-SPACE: Only that vault space (its path: anfs, anfs/product) and the folders below it" \
  --opt "--to SPEC: The documents of the vault spaces links.yml links into that wsm space" --arg "[vault-or-space]"
cli_cmd tasks "List open tasks (- [ ] lines): space, file, line, text (of a vault, a vault space or a DIR)" \
  --opt "--space VAULT-SPACE: Only that vault space (its path: anfs, anfs/product) and the folders below it" \
  --opt "--to SPEC: The tasks of the vault spaces links.yml links into that wsm space" --arg "[vault-or-space]"
cli_cmd show "Print a document by id" --opt "--body: Leave out the frontmatter" --arg "doc"
cli_group space "Vault spaces (the folders under a vault's spaces_path) and the wsm spaces links.yml links them into"
cli_cmd "space list" "The vault spaces (top-level, and linked deeper ones) and where each is linked: the vault you are in, VAULT, or every vault" --alias ls \
  --opt "--problems: Only the rows that are not ok, pending or unlinked; exit 1 when there is one" --arg "[vault]"
cli_cmd "space add" "Make a vault space: its folder (and those above it) under spaces_path" --arg "space"
cli_cmd "space remove" "Unlink a vault space from every wsm space; its folder and its notes stay" --alias rm \
  --opt "-y --yes: Do not ask before removing the links" --arg "space"
cli_cmd "space link" "Link a vault space into a wsm space, and declare it in links.yml" \
  --opt "--as NAME: The link's name in the wsm space (default: the space's)" --arg "space" --arg "spec"
cli_cmd "space unlink" "Remove a vault space's links (into SPEC, or every one) and their links.yml entries" \
  --arg "space" --arg "[spec]"
cli_cmd "space apply" "Make the links links.yml declares that are missing on this machine" \
  --opt "--event EVENT: From wsm: install or remove, for the spaces that follow" --arg "[spec...]"
cli_cmd validate "Check documents against the vault's vocabulary (vault.yml)" \
  --opt "--fix: Mint the ids that are missing" --opt "--strict: Exit 1 on any finding" --arg "[path]"
! declare -F anfs_config_declare >/dev/null || anfs_config_declare
cli_standard

cli_help_epilogue() {
  cat <<EOF
A vault is an entry of $(_display "$OVM_VAULTS_HOME") (OVM_VAULTS_HOME), a directory or a link to one,
with a vault.yml; it is named by its entry, its id or a unique id prefix (4+ characters). A vault
stored elsewhere is a link there. A vault space is any folder under the vault's spaces_path
(vault.yml, default spaces; . is the vault's root), named by its path there: <vault>/<path>
(apex/anfs/product: the first part is the vault), or <space> in the vault you are in. Which vault
spaces are linked into which wsm spaces is declared in $(_display "$OVM_LINKS_YML") (links.local.yml
beside it for this machine; ovm space link and unlink write them); one may hold another (anfs and
anfs/product) under different names. A document's space is the deepest linked vault space holding
it, else the first folder under spaces_path. SPEC is a wsm space (wsm ls): its id, the source and
its path (lgat, lgat/tech/web).

The Obsidian plugins ~/.local/lib/ovm/plugins.yml pins are downloaded once into
$(_display "$OVM_CACHE_HOME/plugins"), sha256-checked. As psm does it: ovm sync places the ones a
vault is missing and enables them, never touching a plugin, a setting, a template or vault.yml that
is there; ovm update brings the plugins there to the pins. ovm init copies the settings and
templates of ~/.local/lib/ovm/vault/ only into a fresh vault (no .obsidian/ yet): one deleted later
does not come back. What no file can do, once per device: turn on community plugins, and
Templater's "Trigger Templater on new file creation". Shell commands lets a note run commands on
this computer: read .obsidian/plugins/obsidian-shellcommands/data.json before turning plugins on in
a vault you did not write. After ovm update, quit Obsidian or reload it (Command palette: Reload
app without saving).

ovm tasks lists the open tasks (a list item whose box is [ ], in a callout too) of every .md file
the walk meets, index.md and log.md included; --json gives each its vault_id, vault, file (from the
vault's root), line, doc (the frontmatter id), space (<vault>/<path>: the document's space, as ovm
docs says it), section (the heading above), parent (the enclosing task), tags and text: what pjm
pulls. Fenced code and the frontmatter are skipped; indented code blocks, %% %% and HTML comments
and setext headings are not understood.
#go marks a task for pjm; ovm validate always allows the tag go, listed in vault.yml or not.
EOF
}

# --- Helpers ------------------------------------------------------------------------------

# Messages and the log are anfs's (lib/anfs/log.sh)
warn() { anfs_warn "$@"; }
die()  { anfs_die "$@"; }
fail() { anfs_fail "$@"; }
usage_err() { cli_usage "$@"; }

_display() { anfs_display "$1"; }

# The canonical path of an existing directory
_canon() { anfs_canon "$1"; }

_require_yq() { anfs_require yq "it is anfs's base software: brew install yq"; }

_new_id() {
  local id=""
  while [[ ${#id} -lt 10 ]]; do
    id+=$(head -c 64 /dev/urandom | LC_ALL=C tr -dc 'a-z2-7' || true)
  done
  printf '%s\n' "${id:0:10}"
}

# Lists and --json are anfs's (lib/anfs/table.sh): anfs_row, anfs_table, anfs_result

# What a command says when it is done; quiet with --json, where anfs_result speaks instead
say() { anfs_json_on || printf '%s\n' "$*"; }

# Every node of a YAML document on stdin (or <file>), one line each: its path (the parts joined
# by RS), its tag, and a scalar's value (newlines made spaces). Generic, so one yq reads all of a
# vault.yml or a frontmatter block.
# shellcheck disable=SC2016
YAML_DUMP='.. | [(path | map(tostring) | join(strenv(RS))), tag,
  ((select(tag != "!!map" and tag != "!!seq") | tostring | sub("\n"; " ")) // "")] | join(strenv(US))'
_yaml_dump() { RS="$RS" US="$US" yq -r "$YAML_DUMP" "$@"; }

# --- The marker: vault.yml ----------------------------------------------------------------

# The id in <root>/vault.yml, or nothing when there is none or it is not an id
_cfg_id() {
  local id
  [[ -f "$1/$OVM_CONFIG" ]] || return 0
  id=$(yq -r '.id // ""' "$1/$OVM_CONFIG" 2>/dev/null) || return 0
  [[ "$id" =~ $ID_RE ]] && printf '%s\n' "$id"
  return 0
}

# What the commands need of <root>/vault.yml, read once per vault per run: VC_SPACES (spaces_path,
# default spaces, . for the vault's root; empty when it is not usable, and VC_BAD says why),
# VC_PFX (what a space's path is under, relative to the root: spaces/, or nothing for .) and
# VC_EXCLUDE (the patterns, without a leading ./ or a trailing /)
declare -A VCC_SPACES=() VCC_BAD=() VCC_EXCLUDE=()
VC_SPACES="" VC_BAD="" VC_EXCLUDE=() VC_PFX=""
_vault_cfg() {
  local root="$1" sp p bad="" part
  local -a lines=() ex=()
  if [[ -z "${VCC_SPACES[$root]+x}" ]]; then
    mapfile -t lines < <(yq -r '[((.spaces_path // "spaces") | tostring)] + ((.exclude // []) | [.] | flatten | map(tostring)) | .[]' \
      "$root/$OVM_CONFIG" 2>/dev/null || true)
    sp="${lines[0]:-spaces}"
    while [[ "$sp" == ./?* ]]; do sp="${sp#./}"; done
    while [[ "$sp" == ?*/ ]]; do sp="${sp%/}"; done
    if [[ -z "$sp" || "$sp" == /* ]]; then
      bad="spaces_path is a folder relative to the vault's root: ${lines[0]:-}"
    elif [[ "$sp" == . ]]; then
      :   # the vault's root: its folders are the spaces
    else
      local IFS=/
      for part in $sp; do
        if [[ "$part" == .. ]]; then bad="spaces_path may not leave the vault (..): $sp"
        elif [[ "$part" == .* ]]; then bad="spaces_path may not be hidden: $sp"
        fi
      done
      unset IFS
    fi
    [[ -z "$bad" ]] || sp=""
    for p in "${lines[@]:1}"; do
      while [[ "$p" == ./* ]]; do p="${p#./}"; done
      while [[ "$p" == */ ]]; do p="${p%/}"; done
      [[ -z "$p" ]] || ex+=("$p")
    done
    VCC_SPACES[$root]="$sp" VCC_BAD[$root]="$bad"
    VCC_EXCLUDE[$root]=$(IFS="$US"; printf '%s' "${ex[*]}")
  fi
  VC_SPACES="${VCC_SPACES[$root]}" VC_BAD="${VCC_BAD[$root]}" VC_EXCLUDE=() VC_PFX=""
  [[ -z "$VC_SPACES" || "$VC_SPACES" == . ]] || VC_PFX="$VC_SPACES/"
  [[ -z "${VCC_EXCLUDE[$root]}" ]] || IFS="$US" read -ra VC_EXCLUDE <<< "${VCC_EXCLUDE[$root]}"
}

# The top-level vault spaces of the vault at <root>: the folders directly under its spaces_path,
# hidden ones, files and what exclude: names left out, one name per line. A deeper folder is a
# vault space too, named by its path (anfs/product); it is listed when links.yml links it.
_space_dirs() {
  local d n p
  _vault_cfg "$1"
  [[ -n "$VC_SPACES" ]] || return 0
  for d in "$1/$VC_PFX"*/; do
    [[ -d "$d" ]] || continue
    d="${d%/}" n="${d##*/}"
    for p in "${VC_EXCLUDE[@]}"; do
      # shellcheck disable=SC2053
      [[ "$VC_PFX$n" != $p ]] || continue 2
    done
    printf '%s\n' "$n"
  done
}

# A vault space's path: relative to spaces_path, its parts folder names, none of them hidden, no ..
_space_path_ok() {
  local part
  local -a parts=()
  [[ -n "$1" && "$1" != /* && "$1" != */ && "$1" != *//* ]] || return 1
  IFS=/ read -ra parts <<< "$1"
  for part in "${parts[@]}"; do [[ "$part" != .* ]] || return 1; done
}

# The vault space paths links.yml links (any wsm space) in the vault <name>, deepest first, into
# LINKED. links.yml is read once; one that does not read is warned about and taken as no links
# here (the space commands and --to are where it is refused).
declare -A LINKED_OF=()
LINKED=() LINKED_TRIED=false
_linked_spaces() {
  local i
  if ! $LINKED_TRIED; then
    LINKED_TRIED=true
    if ! $K_LOADED; then
      local soft=$K_SOFT
      K_SOFT=true
      _pairs_load || K_VAULT=() K_SPACE=() K_TO=() K_AS=() K_FILE=()
      K_SOFT=$soft
    fi
    local -A seen=()
    for i in "${!K_VAULT[@]}"; do
      [[ -z "${seen[${K_VAULT[$i]}|${K_SPACE[$i]}]:-}" ]] || continue
      seen[${K_VAULT[$i]}|${K_SPACE[$i]}]=1
      LINKED_OF[${K_VAULT[$i]}]+="${K_SPACE[$i]}$US"
    done
    for i in "${!LINKED_OF[@]}"; do
      LINKED_OF[$i]=$(printf '%s' "${LINKED_OF[$i]}" | tr "$US" '\n' |
        awk '{ print length($0) "\t" $0 }' | LC_ALL=C sort -k1,1nr -k2 | cut -f2- | tr '\n' "$US")
    done
  fi
  LINKED=()
  [[ -z "${LINKED_OF[$1]:-}" ]] || IFS="$US" read -ra LINKED <<< "${LINKED_OF[$1]}"
}

# The vault space of a document, into REPLY: for <rel> (a path relative to the root of the vault
# at <root>, named <vault>), the deepest vault space links.yml links that holds it; when none
# does, the first folder under spaces_path; nothing for a file directly in spaces_path or outside
# it. docs, show and tasks all say it so.
_space_of() {
  local rel="$2" p
  REPLY=""
  _vault_cfg "$1"
  [[ -n "$VC_SPACES" ]] || return 0
  if [[ -n "$VC_PFX" ]]; then
    [[ "$rel" == "$VC_PFX"* ]] || return 0
    rel="${rel#"$VC_PFX"}"
  fi
  [[ "$rel" == */* ]] || return 0
  _linked_spaces "$3"
  for p in "${LINKED[@]}"; do
    [[ "$rel" != "$p"/* ]] || { REPLY="$p"; return 0; }
  done
  REPLY="${rel%%/*}"
}

# The root of the vault containing <dir>, or return 1. Checks $HOME itself but never walks above
# it, and stops at / for a start outside $HOME.
_find_root() {
  local dir
  dir=$(_canon "$1") || return 1
  while :; do
    [[ -f "$dir/$OVM_CONFIG" ]] && { printf '%s\n' "$dir"; return 0; }
    [[ "$dir" == "$OVM_HOME" || "$dir" == "/" ]] && return 1
    dir=$(dirname -- "$dir")
  done
}

# Whether <dir>/vault.yml can be read within OVM_PROBE_SECONDS (3): a vault on a hung iCloud or
# network mount blocks every read of it, so ovm looks once, in a process an alarm can end, and
# leaves the vault alone after that. Remembered per path for the run.
declare -A OVM_REACH=()
_reachable() {
  local dir="$1"
  if [[ -z "${OVM_REACH[$dir]:-}" ]]; then
    if perl -e 'alarm shift; stat $ARGV[0]; exit 0' "${OVM_PROBE_SECONDS:-3}" "$dir/$OVM_CONFIG" 2>/dev/null
    then OVM_REACH[$dir]=yes
    else OVM_REACH[$dir]=no
    fi
  fi
  [[ "${OVM_REACH[$dir]}" == yes ]]
}

# --- The vaults: the entries of $OVM_VAULTS_HOME -------------------------------------------
#
# An entry (a directory, or a link to one) with a vault.yml is a vault, named by the entry. There
# is no other list: a vault stored elsewhere (iCloud) is a link there, declared by a package's
# links: entry.

# The entry names of $OVM_VAULTS_HOME, one per line, hidden ones left out. Reads nothing in them.
_entries() {
  local e
  for e in "$OVM_VAULTS_HOME"/*; do
    [[ -e "$e" || -L "$e" ]] && printf '%s\n' "${e##*/}"
  done
  return 0
}

# Every entry, into parallel arrays: E_NAME, E_STATE (ok, unreachable, not a vault), E_ID and
# E_ROOT (the vault's canonical root when ok; else the entry, or what its link points at)
E_NAME=() E_STATE=() E_ID=() E_ROOT=()
E_LOADED=false
_vaults_load() {
  local name e
  $E_LOADED && return 0
  E_NAME=() E_STATE=() E_ID=() E_ROOT=()
  while IFS= read -r name; do
    [[ -n "$name" ]] || continue
    e="$OVM_VAULTS_HOME/$name"
    E_NAME+=("$name")
    if [[ -L "$e" && ! -e "$e" ]] || ! _reachable "$e"; then
      E_STATE+=(unreachable) E_ID+=("")
      if [[ -L "$e" ]]; then E_ROOT+=("$(readlink -- "$e")"); else E_ROOT+=("$e"); fi
    elif [[ ! -d "$e" || ! -f "$e/$OVM_CONFIG" ]]; then
      E_STATE+=("not a vault") E_ID+=("") E_ROOT+=("$e")
    else
      E_STATE+=(ok) E_ROOT+=("$(_canon "$e")") E_ID+=("$(_cfg_id "$e")")
    fi
  done < <(_entries)
  E_LOADED=true
}

# The name of the entry of $OVM_VAULTS_HOME that is the directory <root> (canonical), or return 1
_entry_of() {
  local root="$1" name e
  # The common case first: the entry has the directory's name
  e="$OVM_VAULTS_HOME/${root##*/}"
  if [[ -d "$e" ]] && _reachable "$e" && [[ "$e" -ef "$root" ]]; then printf '%s\n' "${root##*/}"; return 0; fi
  while IFS= read -r name; do
    e="$OVM_VAULTS_HOME/$name"
    [[ -d "$e" ]] && _reachable "$e" && [[ "$e" -ef "$root" ]] && { printf '%s\n' "$name"; return 0; }
  done < <(_entries)
  return 1
}

# The vault holding <dir>: VA_ROOT (its canonical root) and VA_NAME (its entry). Returns 1 when no
# vault.yml holds <dir>; fails when the one that does is not an entry of $OVM_VAULTS_HOME.
VA_ROOT="" VA_NAME=""
_vault_of() {
  VA_ROOT=$(_find_root "$1") || return 1
  VA_NAME=$(_entry_of "$VA_ROOT") ||
    fail "$EX_NOTFOUND" "$(_display "$VA_ROOT") is not in $(_display "$OVM_VAULTS_HOME"): link it there (ln -s '$VA_ROOT' $(_display "$OVM_VAULTS_HOME")/<name>)"
}

# The vault you are in, or die
_here() {
  _vault_of "$PWD" || fail "$EX_NOTFOUND" "not inside a vault (no $OVM_CONFIG here or above): ovm new NAME, or name one"
}

# The entry <query> names, as V_I (index into E_*): its name, a vault id, or a unique id prefix of
# 4 or more. Returns 1 for no match, 2 for more than one (the candidates are in V_MATCHES).
V_I=-1 V_MATCHES=()
_vault_resolve() {
  local q="$1" i
  V_I=-1 V_MATCHES=()
  for i in "${!E_NAME[@]}"; do
    [[ "${E_NAME[$i]}" == "$q" ]] && { V_I=$i; return 0; }
  done
  for i in "${!E_ID[@]}"; do
    [[ -n "${E_ID[$i]}" && "${E_ID[$i]}" == "$q" ]] && { V_I=$i; return 0; }
  done
  if [[ ${#q} -ge 4 && "$q" =~ ^[a-z2-7]+$ ]]; then
    for i in "${!E_ID[@]}"; do
      [[ -n "${E_ID[$i]}" && "${E_ID[$i]}" == "$q"* ]] && V_MATCHES+=("$i")
    done
  fi
  case ${#V_MATCHES[@]} in
    0) return 1 ;;
    1) V_I=${V_MATCHES[0]}; return 0 ;;
    *) return 2 ;;
  esac
}

_ambiguous() {
  local i
  warn "'$1' matches more than one vault:"
  for i in "${V_MATCHES[@]}"; do
    printf '  %s  %s  %s\n' "${E_ID[$i]}" "${E_NAME[$i]}" "$(_display "${E_ROOT[$i]}")" >&2
  done
  exit "$EX_AMBIGUOUS"
}

# A vault <query> names that is usable, as V_I, or fail: 1 none, 2 ambiguous, 3 not usable
_vault_named() {
  local rc=0
  _vaults_load
  _vault_resolve "$1" || rc=$?
  [[ $rc -ne 2 ]] || _ambiguous "$1"
  [[ $rc -eq 0 ]] || fail "$EX_NOTFOUND" "no vault '$1' in $(_display "$OVM_VAULTS_HOME") (ovm list)"
  [[ "${E_STATE[$V_I]}" == ok ]] || fail "$EX_STALE" "${E_NAME[$V_I]} is ${E_STATE[$V_I]} (ovm list)"
}

# The roots of the vaults that answer, into LIVE (parallel: LIVE_ID, LIVE_NAME; LIVE_IX by name)
LIVE=() LIVE_ID=() LIVE_NAME=()
declare -A LIVE_IX=()
_live_vaults() {
  local i
  LIVE=() LIVE_ID=() LIVE_NAME=() LIVE_IX=()
  _vaults_load
  for i in "${!E_NAME[@]}"; do
    case "${E_STATE[$i]}" in
      ok)
        LIVE_IX[${E_NAME[$i]}]=${#LIVE[@]}
        LIVE+=("${E_ROOT[$i]}") LIVE_ID+=("${E_ID[$i]}") LIVE_NAME+=("${E_NAME[$i]}")
        ;;
      unreachable) warn "vault ${E_NAME[$i]} skipped: $(_display "${E_ROOT[$i]}") does not answer" ;;
    esac
  done
}

# --- Locking ------------------------------------------------------------------------------
#
# Guards the record of the links ovm made. mkdir is the atomic step; the file inside records
# when, because a directory's mtime cannot be read portably. Retry for 5s, then break a lock
# older than 60s: its holder is not coming back.

OVM_LOCK_HELD=false

_lock_try() {
  local tries=0
  while ! mkdir "$OVM_LOCK" 2>/dev/null; do
    tries=$((tries + 1))
    [[ $tries -ge 50 ]] && return 1
    sleep 0.1
  done
  printf '%(%s)T\n' -1 > "$OVM_LOCK/created" 2>/dev/null || true
  OVM_LOCK_HELD=true
  anfs_on_exit _lock_release
  trap '_lock_release; exit 130' INT TERM HUP
}

_lock_acquire() {
  local created now
  $OVM_LOCK_HELD && return 0
  mkdir -p "$OVM_STATE_HOME" || fail "$EX_LOCK" "cannot create $OVM_STATE_HOME"
  _lock_try && return 0
  created=$(cat -- "$OVM_LOCK/created" 2>/dev/null) || created=0
  [[ "$created" =~ ^[0-9]+$ ]] || created=0
  printf -v now '%(%s)T' -1
  if (( now - created > 60 )); then
    warn "clearing a stale lock at $OVM_LOCK"
    rm -rf "$OVM_LOCK"
    _lock_try && return 0
  fi
  fail "$EX_LOCK" "could not acquire $OVM_LOCK after 5s"
}

_lock_release() {
  $OVM_LOCK_HELD || return 0
  OVM_LOCK_HELD=false
  rm -rf "$OVM_LOCK"
}

# --- The workflow: plugins, their settings and our templates (init) -----------------------
#
# ~/.local/lib/ovm (this package's links: entry) holds plugins.yml, the pins, and vault/, the
# skeleton. The skeleton is copied by init into a fresh vault only (no .obsidian/ yet), each file
# where it is missing (lib/anfs/files.sh), so once there it is the person's and a deleted one does
# not come back. A plugin is its release's files in .obsidian/plugins/<id>/, downloaded once into
# $OVM_CACHE_HOME/plugins (CACHE: rebuildable) and checked against its pinned sha256s. psm's
# convention: sync places the missing ones and leaves the rest as they are; update brings the
# ones there to the pin. These are ovm's only network calls.

OVM_SHELLCMD_DATA=.obsidian/plugins/obsidian-shellcommands/data.json
OVM_SHELLCMD="PATH=\"\$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:\$PATH\" ovm validate"

# The library, into OVM_LIB: ~/.local/lib/ovm, else the package's own beside this script's real
# path (a checkout). Returns 1 when neither has plugins.yml and vault/.
OVM_LIB=""
_ovm_lib() {
  local self t here c
  [[ -z "$OVM_LIB" ]] || return 0
  self="${BASH_SOURCE[0]}"
  while [[ -L "$self" ]]; do
    t=$(readlink -- "$self")
    [[ "$t" == /* ]] || t="$(dirname -- "$self")/$t"
    self="$t"
  done
  here=$(cd -P -- "$(dirname -- "$self")" 2>/dev/null && pwd -P) || here=""
  for c in "$HOME/.local/lib/ovm" ${here:+"$here/../lib/ovm"}; do
    [[ -f "$c/plugins.yml" && -d "$c/vault" ]] || continue
    OVM_LIB=$(cd -P -- "$c" && pwd -P)
    return 0
  done
  return 1
}

# The pins, from plugins.yml: PIN_ID, PIN_REPO, PIN_VER, and per pin its assets and their sha256s
# (PIN_ASSETS, PIN_SHAS: space-separated, in the same order, manifest.json last so a plugin is
# never seen as there before its code is). Fails 69 on a file that does not read.
PIN_ID=() PIN_REPO=() PIN_VER=() PIN_ASSETS=() PIN_SHAS=()
_pins_load() {
  local f="$OVM_LIB/plugins.yml" out id repo ver asset sha i=-1 last="" bad=""
  out=$(US="$US" yq -r 'to_entries[] | .key as $id | .value as $p | (($p.sha256 // {}) | to_entries[]) |
    [$id, ($p.repo // "" | tostring), ($p.version // "" | tostring), .key, (.value | tostring)] | join(strenv(US))' "$f" 2>/dev/null) ||
    fail "$EX_UNAVAIL" "$(_display "$f") does not read: ppm install -f stack/obsidian"
  local -A man=()
  while IFS="$US" read -r id repo ver asset sha; do
    [[ -n "$id" ]] || continue
    if [[ ! "$id" =~ ^[a-z0-9][a-z0-9._-]*$ ]]; then bad="not a plugin id: $id"
    elif [[ ! "$repo" =~ ^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$ ]]; then bad="$id: repo is <owner>/<name>: $repo"
    elif [[ ! "$ver" =~ ^[0-9A-Za-z][0-9A-Za-z.+-]*$ ]]; then bad="$id: not a version: $ver"
    elif [[ ! "$asset" =~ ^[A-Za-z0-9_-][A-Za-z0-9._-]*$ ]]; then bad="$id: not an asset's name: $asset"
    elif [[ ! "$sha" =~ ^[0-9a-f]{64}$ ]]; then bad="$id $asset: not a sha256: $sha"
    fi
    [[ -z "$bad" ]] || fail "$EX_UNAVAIL" "$(_display "$f"): $bad"
    if [[ "$id" != "$last" ]]; then
      i=$((i + 1)) last="$id"
      PIN_ID+=("$id") PIN_REPO+=("$repo") PIN_VER+=("$ver") PIN_ASSETS+=("") PIN_SHAS+=("")
    fi
    if [[ "$asset" == manifest.json ]]; then man[$id]="$sha"; continue; fi
    PIN_ASSETS[i]+="$asset " PIN_SHAS[i]+="$sha "
  done <<< "$out"
  [[ ${#PIN_ID[@]} -gt 0 ]] || fail "$EX_UNAVAIL" "$(_display "$f") pins no plugin"
  for i in "${!PIN_ID[@]}"; do
    [[ -n "${man[${PIN_ID[$i]}]:-}" ]] || fail "$EX_UNAVAIL" "$(_display "$f"): ${PIN_ID[$i]} has no sha256 for manifest.json"
    PIN_ASSETS[i]+="manifest.json" PIN_SHAS[i]+="${man[${PIN_ID[$i]}]}"
  done
}

# sha256 of <file>: sha256sum (Linux), else shasum (macOS)
_sha256() {
  local out
  if command -v sha256sum >/dev/null 2>&1; then out=$(sha256sum -- "$1") || return 1
  else out=$(shasum -a 256 -- "$1") || return 1
  fi
  printf '%s\n' "${out%% *}"
}

# The version in a plugin's <manifest.json>, or nothing
_plugin_version() { yq -p json -o yaml -r '.version // ""' "$1" 2>/dev/null || true; }

# <a> is older than <b> (versions, as sort -V orders them)
_older() { [[ "$1" != "$2" && "$(printf '%s\n%s\n' "$1" "$2" | sort -V | head -n 1)" == "$1" ]]; }

# One asset of pin <i> in the cache, fetched when it is missing or its bytes are not the pin's.
# Into REPLY (its path). Returns 0, or 69 with FETCH_ERR set.
FETCH_ERR=""
_fetch() {
  local i="$1" asset="$2" sha="$3" dir f url got
  dir="$OVM_CACHE_HOME/plugins/${PIN_ID[$i]}/${PIN_VER[$i]}" f="$dir/$asset"
  REPLY="$f"
  if [[ -f "$f" ]] && [[ "$(_sha256 "$f")" == "$sha" ]]; then return 0; fi
  url="https://github.com/${PIN_REPO[$i]}/releases/download/${PIN_VER[$i]}/$asset"
  command -v curl >/dev/null 2>&1 || { FETCH_ERR="curl is not installed: it is how ovm downloads the plugins"; return "$EX_UNAVAIL"; }
  mkdir -p -- "$dir" || { FETCH_ERR="cannot create $(_display "$dir")"; return "$EX_UNAVAIL"; }
  rm -f -- "$f.part"
  if ! curl -fsSL --retry 3 -o "$f.part" "$url" 2>/dev/null; then
    rm -f -- "$f.part"
    FETCH_ERR="download failed: $url"
    return "$EX_UNAVAIL"
  fi
  got=$(_sha256 "$f.part") || got=""
  if [[ "$got" != "$sha" ]]; then
    rm -f -- "$f.part"
    FETCH_ERR="checksum mismatch for ${PIN_ID[$i]} $asset: the pin or the release changed"
    return "$EX_UNAVAIL"
  fi
  mv -f -- "$f.part" "$f"
}

# Pin <i>'s files into <root>/.obsidian/plugins/<id>/ (made when missing): every asset fetched
# first, then each written beside its name and moved into place, manifest.json last. Nothing else
# in the directory (data.json) is touched. Returns 0; 69 (FETCH_ERR) when a fetch failed and
# nothing was written; 1 (FETCH_ERR) when something is in the way.
_plugin_put() {
  local root="$1" i="$2" pdir a n=0 rc=0 tmp
  local -a assets shas files=()
  pdir="$root/.obsidian/plugins/${PIN_ID[$i]}"
  read -ra assets <<< "${PIN_ASSETS[$i]}"
  read -ra shas <<< "${PIN_SHAS[$i]}"
  for a in "${assets[@]}"; do
    _fetch "$i" "$a" "${shas[$n]}" || return $?
    files+=("$REPLY")
    n=$((n + 1))
  done
  if [[ -e "$pdir" && ! -d "$pdir" ]] || ! mkdir -p -- "$pdir" 2>/dev/null; then
    FETCH_ERR="$(_display "$pdir") is in the way (not a directory)"
    return 1
  fi
  for a in "${assets[@]}"; do
    if [[ -d "$pdir/$a" || -L "$pdir/$a" ]]; then
      FETCH_ERR="$(_display "$pdir/$a") is in the way (a directory or a link)"
      return 1
    fi
  done
  n=0
  for a in "${assets[@]}"; do
    tmp="$pdir/.$a.ovm.$$"
    cp -- "${files[$n]}" "$tmp" && mv -f -- "$tmp" "$pdir/$a" || { rm -f -- "$tmp"; rc=1; }
    n=$((n + 1))
  done
  [[ $rc -eq 0 ]] || FETCH_ERR="could not write $(_display "$pdir")"
  return $rc
}

# <ids> listed in <root>/.obsidian/community-plugins.json (a JSON array; made as [] when missing):
# each id appended when it is not there, nothing else changed, the file moved into place whole.
# Returns 1 when the file is not a JSON array of strings (it is not written).
_plugins_enable() {
  local root="$1"; shift
  local f="$root/.obsidian/community-plugins.json" id add="" tmp
  [[ $# -gt 0 ]] || return 0
  if [[ -e "$f" ]]; then
    if ! yq -p json -e 'tag == "!!seq" and all_c(tag == "!!str")' "$f" >/dev/null 2>&1; then
      warn "$(_display "$f") is not a JSON array of plugin ids: not written; add $* to it by hand"
      return 1
    fi
    for id in "$@"; do grep -q "\"$id\"" "$f" || add+="${add:+ }$id"; done
  else
    add="$*"
  fi
  [[ -n "$add" ]] || return 0
  tmp="$root/.obsidian/.community-plugins.json.ovm.$$"
  if [[ -e "$f" ]]; then
    A="$add" yq -p json -o json -I 2 '. + (strenv(A) | split(" "))' "$f" > "$tmp"
  else
    A="$add" yq -n -o json -I 2 'strenv(A) | split(" ")' > "$tmp"
  fi && mv -f -- "$tmp" "$f" || { rm -f -- "$tmp"; warn "could not write $(_display "$f")"; return 1; }
  say "enabled in .obsidian/community-plugins.json: $add"
}

# The skeleton into <root>: copied where missing (WF_COPIED), the rest kept (WF_KEPT). Returns 1
# when something is in the way (nothing copied, said), 69 when the library is broken.
WF_COPIED=() WF_KEPT=0
_skeleton_apply() {
  local root="$1" list out rc=0 state f why
  local -a inway=()
  if ! declare -F anfs_files_apply >/dev/null; then
    # shellcheck source=/dev/null
    [[ -f "$ANFS_LIB_DIR/files.sh" ]] && source "$ANFS_LIB_DIR/files.sh" ||
      { warn "settings and templates: $ANFS_LIB_DIR/files.sh is missing: install core/anfs again"; return "$EX_UNAVAIL"; }
  fi
  list=$(mktemp "${TMPDIR:-/tmp}/ovm-skeleton.XXXXXX")
  (cd "$OVM_LIB/vault" && find . -type f ! -name .DS_Store | sed 's|^\./||' | LC_ALL=C sort) > "$list"
  out=$(anfs_files_apply "$OVM_LIB/vault" "$root" "$list" 2>&1) || rc=$?
  rm -f -- "$list"
  while IFS=$'\t' read -r state f why; do
    case "$state" in
      missing) WF_COPIED+=("$f") ;;
      present|differs) WF_KEPT=$((WF_KEPT + 1)) ;;
      "in the way") inway+=("$f ($why)") ;;
    esac
  done <<< "$out"
  if [[ $rc -eq 1 ]]; then
    WF_COPIED=()
    warn "settings and templates: nothing copied: in the way: ${inway[*]}"
    return 1
  elif [[ $rc -ne 0 ]]; then
    WF_COPIED=()
    warn "settings and templates: nothing copied: ${out//$'\n'/; }"
    return "$EX_UNAVAIL"
  fi
  for f in "${WF_COPIED[@]}"; do say "copied $f"; done
  [[ $WF_KEPT -eq 0 ]] || say "kept $WF_KEPT $( ((WF_KEPT == 1)) && echo "file that is" || echo "files that are") yours (settings and templates already there)"
}

# The plugins into <root>: each pin whose directory has no manifest.json is placed (WF_PLACED),
# the others left (WF_LEFT), then the placed ones enabled. Returns the worst: 1 in the way, 69 a
# fetch failed.
WF_PLACED=() WF_LEFT=()
_plugins_apply() {
  local root="$1" i id m have rc=0 r
  for i in "${!PIN_ID[@]}"; do
    id="${PIN_ID[$i]}" m="$root/.obsidian/plugins/${PIN_ID[$i]}/manifest.json"
    if [[ -f "$m" ]]; then
      WF_LEFT+=("$id")
      have=$(_plugin_version "$m")
      if [[ "$have" == "${PIN_VER[$i]}" ]]; then say "$id $have is there"
      else say "$id ${have:-?} is there: left as it is (the pin is ${PIN_VER[$i]}; ovm update brings an older one to it)"
      fi
      continue
    fi
    r=0
    _plugin_put "$root" "$i" || r=$?
    if [[ $r -eq 0 ]]; then
      WF_PLACED+=("$id")
      say "placed $id ${PIN_VER[$i]}"
    else
      warn "$id not placed: $FETCH_ERR"
      [[ $r -eq 1 || $rc -eq 1 ]] && rc=1 || rc=$r
    fi
  done
  if [[ ${#WF_PLACED[@]} -gt 0 ]]; then _plugins_enable "$root" "${WF_PLACED[@]}" || rc=1; fi
  return $rc
}

# ovm update: each pin whose plugin is in <root> brought to the pin when older (WF_UPDATED);
# newer or equal left (WF_LEFT); absent named. Only the plugins' files are written.
WF_UPDATED=()
_plugins_update() {
  local root="$1" i id m have rc=0 r
  for i in "${!PIN_ID[@]}"; do
    id="${PIN_ID[$i]}" m="$root/.obsidian/plugins/${PIN_ID[$i]}/manifest.json"
    if [[ ! -f "$m" ]]; then say "$id is not in this vault: ovm sync places it"; continue; fi
    have=$(_plugin_version "$m")
    if [[ "$have" == "${PIN_VER[$i]}" ]]; then
      WF_LEFT+=("$id"); say "$id $have is at the pin"
    elif [[ -n "$have" ]] && _older "${PIN_VER[$i]}" "$have"; then
      WF_LEFT+=("$id"); say "$id $have is newer than the pin (${PIN_VER[$i]}): left as it is"
    else
      r=0
      _plugin_put "$root" "$i" || r=$?
      if [[ $r -eq 0 ]]; then
        WF_UPDATED+=("$id"); say "updated $id ${have:-?} -> ${PIN_VER[$i]}"
      else
        warn "$id not updated: $FETCH_ERR"
        [[ $r -eq 1 || $rc -eq 1 ]] && rc=1 || rc=$r
      fi
    fi
  done
  [[ ${#WF_UPDATED[@]} -eq 0 ]] || say "quit Obsidian or reload it (Command palette: Reload app without saving) to run the new code"
  return $rc
}

# What no file can do, said when this run placed a plugin or community-plugins.json lists one of
# the pins (ovm cannot see whether the clicks were made). Into WF_STEPS.
WF_STEPS=()
_steps_left() {
  local root="$1" placed="$2" f="$1/.obsidian/community-plugins.json" id ours=false
  if [[ "$placed" == true ]]; then ours=true
  elif [[ -f "$f" ]]; then
    for id in "${PIN_ID[@]}"; do grep -q "\"$id\"" "$f" && { ours=true; break; }; done
  fi
  if [[ -f "$root/$OVM_SHELLCMD_DATA" ]] && ! grep -q '"ovm-validate"' "$root/$OVM_SHELLCMD_DATA"; then
    WF_STEPS+=(add-ovm-command)
    say ""
    say "Shell commands' settings in this vault are yours, so ovm's command is not in them. To add it:"
    say "Settings > Shell commands > New shell command: $OVM_SHELLCMD"
    say "(alias \"ovm: validate this vault\", outputs to a notification)."
  fi
  $ours || return 0
  WF_STEPS+=(turn-on-community-plugins templater-trigger-on-new-file)
  say ""
  say "If you have not yet, on each device, in Obsidian (no file can do these):"
  say "  1. Open this vault and turn on community plugins (Settings > Community plugins, or the"
  say "     \"Turn on community plugins\" button of the trust dialog)."
  say "  2. Settings > Templater: turn on \"Trigger Templater on new file creation\"."
  say ""
  say "Shell commands lets a note run commands on this computer, and Meta Bind buttons can run them"
  say "from inside a note. A vault that syncs (iCloud, git) carries its plugin settings: whoever can"
  say "write to the vault can add a command that runs when you click. ovm ships one command (ovm"
  say "validate). Before turning on community plugins in a vault you did not write, read"
  say "$OVM_SHELLCMD_DATA."
  say "Shell commands is desktop only: on a phone Obsidian does not load it."
}

# --- init, new, list ----------------------------------------------------------------------

cmd_init() {
  local dir="${1:-}" noplug=${CLI_OPT[no-plugins]:-false}
  _require_yq
  local root parent id file name made=false rc=0 r fresh=false
  root=$(_canon "${dir:-.}") || fail "$EX_NOTFOUND" "no such directory: ${dir:-.}"
  file="$root/$OVM_CONFIG"
  name=$(_entry_of "$root") ||
    fail "$EX_NOTFOUND" "$(_display "$root") is not in $(_display "$OVM_VAULTS_HOME"), where vaults are: ovm new NAME, or link it there (ln -s '$root' $(_display "$OVM_VAULTS_HOME")/<name>) and ovm init that"
  if [[ "$root" != / && "$root" != "$OVM_HOME" ]] && parent=$(_find_root "$(dirname -- "$root")"); then
    fail "$EX_EXISTS" "$(_display "$root") is inside the vault at $(_display "$parent"); a vault does not hold another"
  fi
  # Fresh: Obsidian has never opened it, and ovm has not set it up
  [[ -e "$root/.obsidian" ]] || fresh=true

  if [[ -f "$file" ]]; then
    yq -e 'tag == "!!map" or tag == "!!null"' "$file" >/dev/null 2>&1 || die "$(_display "$file") is not a YAML mapping"
    id=$(_cfg_id "$root")
    if [[ -z "$id" ]]; then
      id=$(_new_id)
      I="$id" yq -i '.id = strenv(I)' "$file"
      made=true
    fi
  else
    id=$(_new_id)
    cat > "$file" <<CFG
# An ovm vault (ovm help). The id is this vault's identity: do not change it. The vault's name is
# its entry in ~/vaults (OVM_VAULTS_HOME).
id: $id
spaces_path: spaces              # the folder whose folders are the vault spaces (. the root; ovm space add PATH)
exclude: [_templates]            # what docs and validate skip: path patterns (.obsidian/, .trash/ always)
# The vocabulary \`ovm validate\` checks documents against; each key may also appear per space
required: [type, id]             # keys every document's frontmatter must have
#kinds:                          # allowed values of type; each may require more keys
#  note: {}
#  decision: {required: [status]}
#fields:                         # the value type of a frontmatter key
#  status: [proposed, accepted, superseded]   # a list: one of these
#  timestamp: datetime           # string, number, bool, date, datetime, list
#tags: [idea, decision]          # allowed tags, frontmatter and inline; a/b is allowed by a
#spaces:                         # per vault space, by its path (anfs/product): more vocabulary
#  product: {tags: [linker]}
CFG
    made=true
  fi
  if $made; then
    say "initialized vault $name ($id) at $(_display "$root")"
  else
    say "vault $name ($id) at $(_display "$root") is initialized already"
  fi

  # The workflow: what can be done is done; init or sync again finishes the rest
  if ! _ovm_lib; then
    warn "ovm's files are missing: ppm install -f stack/obsidian (vault.yml is written; ovm init again then)"
    rc=$EX_UNAVAIL
  else
    if $fresh; then
      r=0
      _skeleton_apply "$root" || r=$?
      [[ $r -eq 0 ]] || rc=$r
    else
      say "settings and templates: not copied (.obsidian/ is there: what the vault has is yours)"
    fi
    if ! $noplug; then
      _pins_load
      r=0
      _plugins_apply "$root" || r=$?
      [[ $r -eq 0 || $rc -eq 1 ]] || rc=$r
      _steps_left "$root" "$([[ ${#WF_PLACED[@]} -gt 0 ]] && echo true || echo false)"
    fi
  fi
  anfs_result id "$id" name "$name" path "$root" status "$($made && echo initialized || echo unchanged)" \
    placed "${WF_PLACED[*]}" kept "${WF_LEFT[*]}" copied "${WF_COPIED[*]}" steps_left "${WF_STEPS[*]}"
  return $rc
}

cmd_new() {
  local name="$1" dir
  [[ -n "$name" && "$name" != */* && "$name" != .* ]] ||
    fail "$EX_USAGE" "a vault's name is an entry of $(_display "$OVM_VAULTS_HOME"), not a path: $name"
  dir="$OVM_VAULTS_HOME/$name"
  [[ ! -e "$dir" && ! -L "$dir" ]] || fail "$EX_EXISTS" "already exists: $(_display "$dir") (ovm init $(_display "$dir") makes it a vault)"
  mkdir -p -- "$dir" || die "cannot create $dir"
  cmd_init "$dir"
}

# The vaults sync and update work on: those named (each must be usable), else every vault in
# ~/vaults that answers. Into WV_ROOT, WV_NAME, WV_ID.
WV_ROOT=() WV_NAME=() WV_ID=()
_work_vaults() {
  local q
  WV_ROOT=() WV_NAME=() WV_ID=()
  if [[ $# -eq 0 ]]; then
    _live_vaults
    WV_ROOT=("${LIVE[@]}") WV_NAME=("${LIVE_NAME[@]}") WV_ID=("${LIVE_ID[@]}")
    [[ ${#WV_ROOT[@]} -gt 0 ]] || say "no vaults in $(_display "$OVM_VAULTS_HOME") (ovm new NAME)"
    return 0
  fi
  for q in "$@"; do
    _vault_named "$q"
    WV_ROOT+=("${E_ROOT[$V_I]}") WV_NAME+=("${E_NAME[$V_I]}") WV_ID+=("${E_ID[$V_I]}")
  done
}

# The worst of two exit codes: 1 (needs the person) over 69 (needs a rerun)
_worst() { if [[ $1 -eq 0 || $2 -eq 1 ]]; then REPLY=$2; elif [[ $2 -eq 0 || $1 -eq 1 ]]; then REPLY=$1; else REPLY=$2; fi; }

# sync and update, one row per vault for --json: vault id path placed[] updated[] kept[] steps_left[]
_wf_row() {
  anfs_json_on || return 0
  printf '%s\n' "$1$US$2$US$3$US${WF_PLACED[*]}$US${WF_UPDATED[*]}$US${WF_LEFT[*]}$US${WF_STEPS[*]}"
}
_wf_table() {
  anfs_json_on || return 0
  anfs_table "VAULT ID PATH PLACED UPDATED KEPT STEPS_LEFT" "vault id path placed[] updated[] kept[] steps_left[]"
}

cmd_sync() {
  local i rc=0 r rows=""
  _require_yq
  _work_vaults "$@"
  [[ ${#WV_ROOT[@]} -gt 0 ]] || { printf '' | _wf_table; return 0; }
  _ovm_lib || fail "$EX_UNAVAIL" "ovm's files are missing: ppm install -f stack/obsidian"
  _pins_load
  for i in "${!WV_ROOT[@]}"; do
    WF_PLACED=() WF_LEFT=() WF_UPDATED=() WF_STEPS=()
    say "${WV_NAME[$i]} ($(_display "${WV_ROOT[$i]}")):"
    r=0
    _plugins_apply "${WV_ROOT[$i]}" || r=$?
    _worst "$rc" "$r"; rc=$REPLY
    if [[ ${#WF_PLACED[@]} -gt 0 ]]; then _steps_left "${WV_ROOT[$i]}" true; fi
    rows+="$(_wf_row "${WV_NAME[$i]}" "${WV_ID[$i]}" "${WV_ROOT[$i]}")"$'\n'
  done
  printf '%s' "$rows" | _wf_table
  return $rc
}

cmd_update() {
  local i rc=0 r rows=""
  _require_yq
  _work_vaults "$@"
  [[ ${#WV_ROOT[@]} -gt 0 ]] || { printf '' | _wf_table; return 0; }
  _ovm_lib || fail "$EX_UNAVAIL" "ovm's files are missing: ppm install -f stack/obsidian"
  _pins_load
  for i in "${!WV_ROOT[@]}"; do
    WF_PLACED=() WF_LEFT=() WF_UPDATED=() WF_STEPS=()
    say "${WV_NAME[$i]} ($(_display "${WV_ROOT[$i]}")):"
    r=0
    _plugins_update "${WV_ROOT[$i]}" || r=$?
    _worst "$rc" "$r"; rc=$REPLY
    rows+="$(_wf_row "${WV_NAME[$i]}" "${WV_ID[$i]}" "${WV_ROOT[$i]}")"$'\n'
  done
  printf '%s' "$rows" | _wf_table
  return $rc
}

cmd_list() {
  local i
  _vaults_load
  for i in "${!E_NAME[@]}"; do
    printf '%s\n' "${E_NAME[$i]}$US${E_ID[$i]}$US${E_STATE[$i]}$US${E_ROOT[$i]}"
  done | anfs_table "NAME ID STATUS PATH" "name id status path"
}

# --- Documents ----------------------------------------------------------------------------
#
# A document is a .md file in a vault that the walk meets (_walk: not under a hidden name or
# node_modules, not matched by vault.yml's exclude:), and not index.md or log.md, which OKF
# reserves and which carry no frontmatter.

# One row per document that opens with frontmatter: path, ok|open (open: the block never closes),
# then its top-level id, type and title. A file with no frontmatter gives no row.
# shellcheck disable=SC2016
FM_AWK='
function val(s) {
  sub(/^[^:]*:[ \t]*/, "", s); sub(/[ \t\r]+$/, "", s)
  if (s ~ /^".*"$/ || s ~ /^\047.*\047$/) s = substr(s, 2, length(s) - 2)
  gsub(/\t/, " ", s)
  return s
}
function row(state) { printf "%s\037%s\037%s\037%s\037%s\n", file, state, id, type, title }
FNR == 1 {
  if (open) row("open")
  open = 0; file = FILENAME; id = ""; type = ""; title = ""
  line = $0; sub(/[ \t\r]+$/, "", line)
  if (line != "---") nextfile
  open = 1; next
}
open && /^---[ \t\r]*$/ { row("ok"); open = 0; nextfile }
open && /^id:/    { id = val($0) }
open && /^type:/  { type = val($0) }
open && /^title:/ { title = val($0) }
END { if (open) row("open") }
'

# The .md files under <dir>, in the vault at <root>: one absolute path per line, sorted. Hidden
# names (.obsidian, .trash, .git) and node_modules are always skipped; each of vault.yml's
# exclude: patterns is matched against the path relative to the root of every directory and file
# met, as [[ $rel == $pat ]] would (find's -path: * crosses /), and a matching directory is pruned.
# What docs, show, path, validate (and tasks) all go through.
_walk() {
  local root="$1" dir="$2" rel p
  local -a args=()
  _vault_cfg "$root"
  rel="${dir#"$root"}"
  args=(".$rel" -mindepth 1 \( -name '.*' -o -name node_modules)
  for p in "${VC_EXCLUDE[@]}"; do args+=(-o -path "./$p"); done
  args+=(\) -prune -o -type f -name '*.md' -print)
  (cd -- "$root" && find "${args[@]}" 2>/dev/null) |
    R="$root" awk '{ print ENVIRON["R"] substr($0, 2) }' | LC_ALL=C sort
}

# The documents under <dir> of the vault at <root>, one path per line
_doc_files() { _walk "$1" "$2" | awk '!/\/(index|log)\.md$/'; }

# FM_AWK's rows for every document under <dir> of the vault at <root>
_doc_scan() {
  _doc_files "$1" "$2" | tr '\n' '\0' | xargs -0 -r awk "$FM_AWK" 2>/dev/null | LC_ALL=C sort
}

# A document's frontmatter, without the fences / its body, without the frontmatter
_fm_block() { awk 'NR == 1 { if ($0 !~ /^---[ \t\r]*$/) exit; next } /^---[ \t\r]*$/ { exit } { print }' "$1"; }
_doc_body() {
  awk 'NR == 1 && /^---[ \t\r]*$/ { fm = 1; next } fm == 1 { if (/^---[ \t\r]*$/) fm = 2; next } { print }' "$1"
}

# Find a document by id in every live vault: D_PATH, D_ROOT, D_VAULT (name), D_VID. Returns 1
# when there is none; exits 2 when more than one document carries the id.
D_PATH="" D_ROOT="" D_VAULT="" D_VID=""
_doc_find() {
  local want="$1" v path state id type title
  local -a hits=() roots=() names=() vids=()
  _live_vaults
  for v in "${!LIVE[@]}"; do
    # grep narrows it to the files that mention the id; the frontmatter scan decides
    while IFS="$US" read -r path state id type title; do
      [[ "$id" == "$want" ]] || continue
      hits+=("$path") roots+=("${LIVE[$v]}") names+=("${LIVE_NAME[$v]}") vids+=("${LIVE_ID[$v]}")
    done < <(_doc_files "${LIVE[$v]}" "${LIVE[$v]}" | tr '\n' '\0' |
      xargs -0 -r grep -lE "^id:[[:space:]]*[\"']?$want" /dev/null 2>/dev/null |
      while IFS= read -r path; do awk "$FM_AWK" "$path"; done)
  done
  case ${#hits[@]} in
    0) return 1 ;;
    1) D_PATH="${hits[0]}" D_ROOT="${roots[0]}" D_VAULT="${names[0]}" D_VID="${vids[0]}" ;;
    *)
      warn "more than one document has the id $want:"
      printf '  %s\n' "${hits[@]}" >&2
      exit "$EX_AMBIGUOUS"
      ;;
  esac
}

# ovm cd is the shell function's (sh/ovm.sh): it cds to what `ovm path --dir` prints
cmd_cd() {
  echo "ovm cd needs the ovm shell function (source ~/.config/sh/ovm.sh)" >&2
  exit 1
}

cmd_path() {
  local rc=0 path
  if [[ $# -eq 0 ]]; then
    _here
    if anfs_json_on; then anfs_result path "$VA_ROOT"; else printf '%s\n' "$VA_ROOT"; fi
    return 0
  fi
  _vaults_load
  _vault_resolve "$1" || rc=$?
  [[ $rc -ne 2 ]] || _ambiguous "$1"
  if [[ $rc -eq 0 ]]; then
    path="${E_ROOT[$V_I]}"
    [[ "${E_STATE[$V_I]}" == ok ]] || path="$OVM_VAULTS_HOME/${E_NAME[$V_I]}"
    if anfs_json_on; then anfs_result path "$path" kind vault; else printf '%s\n' "$path"; fi
    if [[ "${E_STATE[$V_I]}" != ok ]]; then
      warn "${E_NAME[$V_I]} is ${E_STATE[$V_I]} (ovm list)"
      return "$EX_STALE"
    fi
    return 0
  fi
  if [[ "$1" =~ $ID_RE ]] && _doc_find "$1"; then
    [[ "${CLI_OPT[dir]:-false}" != true ]] || D_PATH=$(dirname -- "$D_PATH")
    if anfs_json_on; then anfs_result path "$D_PATH" kind document; else printf '%s\n' "$D_PATH"; fi
    return 0
  fi
  fail "$EX_NOTFOUND" "no vault or document matching '$1'"
}

# The part of <dir> (in the vault at <root>) that is vault space <path> or below it, into REPLY;
# returns 1 when they do not meet or the folder is not there. What --space narrows a scope with.
_space_narrow() {
  local dir="$2" sd
  _vault_cfg "$1"
  [[ -n "$VC_SPACES" ]] || return 1
  sd="$1/$VC_PFX$3"
  if [[ "$dir" == "$sd" || "$dir" == "$sd"/* ]]; then REPLY="$dir"
  elif [[ "$sd" == "$dir"/* ]]; then REPLY="$sd"
  else return 1
  fi
  [[ -d "$REPLY" ]]
}

# --space PATH, checked, into REPLY (a trailing / dropped; empty when not given)
_space_opt() {
  REPLY="${CLI_OPT[space]:-}"
  while [[ "$REPLY" == ?*/ ]]; do REPLY="${REPLY%/}"; done
  [[ -z "$REPLY" ]] || _space_path_ok "$REPLY" ||
    fail "$EX_USAGE" "--space is a vault space's path under spaces_path (anfs, anfs/product): $REPLY"
}

# The scope of docs and tasks, into S_ROOT, S_DIR and S_NAME (parallel): the vault spaces links.yml
# links into <to> (what is not here is warned about and skipped); else <arg>: a DIR (in its
# vault), a vault, <vault>/<space>, or a name that is no vault while you stand in one (a space of
# that vault); else the vault you are in; else every vault. Then narrowed to the vault space <space> and below it, when given.
S_ROOT=() S_DIR=() S_NAME=()
_scope() {
  local arg="$1" to="$2" space="$3" dir i j v rc=0 found=false
  local -a roots=() dirs=() names=()
  [[ -z "$arg" || -z "$to" ]] || fail "$EX_USAGE" "a vault, a vault space or a DIR, or --to: not both"
  if [[ -n "$to" ]]; then
    _pairs_load
    _live_vaults
    local -A seen=()
    for i in "${!K_VAULT[@]}"; do
      [[ "${K_TO[$i]}" == "$to" ]] || continue
      found=true
      if [[ -z "${LIVE_IX[${K_VAULT[$i]}]+x}" ]]; then
        # An unreachable vault was warned about by _live_vaults
        for j in "${!E_NAME[@]}"; do [[ "${E_NAME[$j]}" != "${K_VAULT[$i]}" || "${E_STATE[$j]}" != unreachable ]] || continue 2; done
        warn "${K_VAULT[$i]}/${K_SPACE[$i]} skipped: no vault ${K_VAULT[$i]} in $(_display "$OVM_VAULTS_HOME") ($(_display "${K_FILE[$i]}"))"
        continue
      fi
      v=${LIVE_IX[${K_VAULT[$i]}]}
      _vault_cfg "${LIVE[$v]}"
      if [[ -z "$VC_SPACES" ]]; then
        warn "${K_VAULT[$i]}/${K_SPACE[$i]} skipped: $(_display "${LIVE[$v]}/$OVM_CONFIG"): $VC_BAD"
        continue
      fi
      dir="${LIVE[$v]}/$VC_PFX${K_SPACE[$i]}"
      if [[ ! -d "$dir" ]]; then
        warn "${K_VAULT[$i]}/${K_SPACE[$i]} skipped: no folder $(_display "$dir")"
        continue
      fi
      [[ -z "${seen[$dir]:-}" ]] || continue
      seen[$dir]=1
      roots+=("${LIVE[$v]}") dirs+=("$dir") names+=("${LIVE_NAME[$v]}")
    done
    $found || warn "no vault space is linked into $to ($(_display "$OVM_LINKS_YML")): ovm space link <vault>/<space> $to"
  elif [[ -n "$arg" ]]; then
    case "$arg" in
      /*|.*|"~"|"~/"*)
        [[ "$arg" != "~" && "$arg" != "~/"* ]] || arg="$HOME${arg#\~}"
        dir=$(_canon "$arg") || fail "$EX_NOTFOUND" "no such directory: $arg"
        _vault_of "$dir" || fail "$EX_NOTFOUND" "$(_display "$dir") is not inside a vault"
        roots=("$VA_ROOT") dirs=("$dir") names=("$VA_NAME")
        ;;
      */*)
        _space_arg "$arg" folder
        roots=("$SP_ROOT") dirs=("$SP_DIR") names=("$SP_VAULT")
        ;;
      *)
        # A name that is no vault, while you stand in one: a space of that vault
        _vaults_load
        _vault_resolve "$arg" || rc=$?
        if [[ $rc -eq 1 ]] && _vault_of "$PWD"; then
          _space_arg "$arg" folder
          roots=("$SP_ROOT") dirs=("$SP_DIR") names=("$SP_VAULT")
        else
          _vault_named "$arg"
          roots=("${E_ROOT[$V_I]}") dirs=("${E_ROOT[$V_I]}") names=("${E_NAME[$V_I]}")
        fi
        ;;
    esac
  elif _vault_of "$PWD"; then
    roots=("$VA_ROOT") dirs=("$VA_ROOT") names=("$VA_NAME")
  else
    _live_vaults
    roots=("${LIVE[@]}") dirs=("${LIVE[@]}") names=("${LIVE_NAME[@]}")
  fi
  S_ROOT=() S_DIR=() S_NAME=()
  for v in "${!roots[@]}"; do
    if [[ -n "$space" ]]; then
      if _space_narrow "${roots[$v]}" "${dirs[$v]}" "$space"; then dirs[$v]="$REPLY"; else dirs[$v]=""; fi
    fi
  done
  # A folder inside another one in scope (nested links) is read once, with it
  for v in "${!roots[@]}"; do
    [[ -n "${dirs[$v]}" ]] || continue
    for i in "${!dirs[@]}"; do
      [[ $i -ne $v && -n "${dirs[$i]}" ]] || continue
      if [[ "${dirs[$v]}" == "${dirs[$i]}"/* ]] || [[ "${dirs[$v]}" == "${dirs[$i]}" && $i -lt $v ]]; then continue 2; fi
    done
    S_ROOT+=("${roots[$v]}") S_DIR+=("${dirs[$v]}") S_NAME+=("${names[$v]}")
  done
}

cmd_docs() {
  local want_type="${CLI_OPT[type]:-}" to="${CLI_OPT[to]:-}" v
  _require_yq
  _space_opt
  _scope "${1:-}" "${to%/}" "$REPLY"
  local -a roots=("${S_ROOT[@]}") dirs=("${S_DIR[@]}") names=("${S_NAME[@]}")

  local file state id type title space
  for v in "${!roots[@]}"; do
    _vault_cfg "${roots[$v]}"
    while IFS="$US" read -r file state id type title; do
      [[ -n "$file" ]] || continue
      [[ -z "$want_type" || "$type" == "$want_type" ]] || continue
      _space_of "${roots[$v]}" "${file#"${roots[$v]}"/}" "${names[$v]}"
      printf '%s\n' "$id$US$type$US$title$US$REPLY$US$file$US${names[$v]}"
    done < <(_doc_scan "${roots[$v]}" "${dirs[$v]}")
  done | anfs_table "ID TYPE TITLE SPACE PATH VAULT" "id type title space path vault"
}

cmd_show() {
  local want="$1" body=${CLI_OPT[body]:-false}
  _require_yq
  _doc_find "$want" || fail "$EX_NOTFOUND" "no document with the id '$want' in any vault (ovm docs)"
  if ! anfs_json_on; then
    if $body; then _doc_body "$D_PATH"; else cat -- "$D_PATH"; fi
    return 0
  fi
  # The frontmatter and the body go through files: a document can be larger than one
  # environment string may be
  local tmp space
  tmp=$(mktemp -d "${TMPDIR:-/tmp}/ovm-show.XXXXXX")
  anfs_on_exit "rm -rf '$tmp'"
  _fm_block "$D_PATH" > "$tmp/fm.yml"
  _doc_body "$D_PATH" > "$tmp/body"
  [[ -s "$tmp/fm.yml" ]] || echo '{}' > "$tmp/fm.yml"
  _space_of "$D_ROOT" "${D_PATH#"$D_ROOT"/}" "$D_VAULT"
  space="$REPLY"
  ID="$want" VAULT="$D_VAULT" VID="$D_VID" P="$D_PATH" SPACE="$space" FM="$tmp/fm.yml" BODY="$tmp/body" \
    yq -n -o=json '{
      "id": strenv(ID), "vault": strenv(VAULT), "vault_id": strenv(VID), "path": strenv(P),
      "space": strenv(SPACE), "frontmatter": load(strenv(FM)), "body": load_str(strenv(BODY))
    } | (select(.space == "") | .space) = null' ||
    die "the frontmatter of $(_display "$D_PATH") does not parse (ovm validate)"
}

# --- Tasks --------------------------------------------------------------------------------
#
# A task is an open `- [ ]` line of any .md file the walk meets (index.md and log.md too). What
# `ovm tasks --json` prints is user/pjm's source contract: exactly these ten keys, no more
# (cmd_pull in pjm reads them; a new key is agreed with pjm first).

# One row per open task of the files named, in their order: a sort key (vault, file, line), then
# space (left empty: _tasks_scan fills it in), file, line, text, vault_id, vault, doc, section,
# parent and tags (space-separated). From the environment: TR the vault's root, TV its name, TI
# its id. Per file: the frontmatter (its id; an unclosed block is read as body), fenced code
# skipped (``` or ~~~, closed by the same character at least as many times), ATX headings,
# blockquote and callout markers stripped, and a stack of the list entries above for the parent.
# Not handled: indented code blocks, %% %% and HTML comments, setext headings.
# shellcheck disable=SC2016
TASKS_AWK='
function clean(s) { gsub(/[\001-\037\177]/, " ", s); sub(/^ +/, "", s); sub(/ +$/, "", s); return s }
function fmval(s) {
  sub(/^[^:]*:[ \t]*/, "", s); sub(/[ \t]+$/, "", s)
  if (s ~ /^".*"$/ || s ~ /^\047.*\047$/) s = substr(s, 2, length(s) - 2)
  return clean(s)
}
function tags(s,    t, out, seen, m) {
  t = s; gsub(/`[^`]*`/, "", t); t = " " t; out = ""
  while (match(t, /[ \t]#[A-Za-z][A-Za-z0-9_\/-]*/)) {
    m = substr(t, RSTART + 2, RLENGTH - 2)
    if (!(m in seen)) { seen[m] = 1; out = out (out == "" ? "" : " ") m }
    t = substr(t, RSTART + RLENGTH)
  }
  return out
}
function startfile() {
  rel = substr(FILENAME, length(ENVIRON["TR"]) + 2)
  base = rel; sub(/.*\//, "", base)
  nodoc = (base == "index.md" || base == "log.md")
  doc = ""; section = ""; fence = ""; flen = 0; sp = 0; fm = 0; nbuf = 0
}
# A frontmatter block that never closed is not one: its lines are the body
function endfile(    k) {
  if (fm != 1) return
  fm = 2; doc = ""
  for (k = 1; k <= nbuf; k++) body(buf[k], k)
}
function body(s, n,    q, inq, ind, i, c, rest, m, fch, h, item, istask, ch, txt, par) {
  q = s; inq = 0
  while (match(q, /^[ \t]*>[ ]?/)) { q = substr(q, RLENGTH + 1); inq = 1 }
  if (fence != "") {
    if (q ~ /^[ \t]*(`+|~+)[ \t]*$/) {
      m = q; gsub(/[ \t]/, "", m)
      if (substr(m, 1, 1) == fence && length(m) >= flen) fence = ""
    }
    return
  }
  ind = 0
  for (i = 1; i <= length(q); i++) {
    c = substr(q, i, 1)
    if (c == " ") ind++
    else if (c == "\t") ind = ind - ind % 4 + 4
    else break
  }
  rest = substr(q, i)
  if (rest == "") return
  while (sp > 0 && st_ind[sp] >= ind) sp--
  if (match(rest, /^(```+|~~~+)/)) {
    m = substr(rest, 1, RLENGTH); fch = substr(m, 1, 1)
    if (!(fch == "`" && index(substr(rest, RLENGTH + 1), "`") > 0)) { fence = fch; flen = length(m); return }
  }
  if (!inq && ind < 4 && rest ~ /^##?#?#?#?#?([ \t]|$)/) {
    h = rest; sub(/^#+[ \t]*/, "", h); sub(/[ \t]+$/, "", h)
    if (h ~ /(^|[ \t])#+$/) { sub(/#+$/, "", h); sub(/[ \t]+$/, "", h) }
    section = clean(h); sp = 0
    return
  }
  if (!match(rest, /^([-*+]|[0-9]+[.)])( |$)/)) return
  item = substr(rest, RLENGTH + 1); istask = 0; ch = ""; txt = ""
  if (item ~ /^\[.\]( |$)/) { ch = substr(item, 2, 1); txt = clean(substr(item, 4)); istask = (txt != "") }
  par = (sp > 0 && st_task[sp]) ? st_txt[sp] : ""
  sp++; st_ind[sp] = ind; st_task[sp] = istask; st_txt[sp] = txt
  if (!istask || ch != " ") return
  printf "%s\001%s\001%010d\037%s\037%s\037%d\037%s\037%s\037%s\037%s\037%s\037%s\037%s\n", \
    VAULT, rel, n, "", rel, n, txt, VID, VAULT, (nodoc ? "" : doc), section, par, tags(txt)
}
BEGIN { VAULT = ENVIRON["TV"]; VID = ENVIRON["TI"] }
FNR == 1 { endfile(); startfile() }
{ sub(/\r$/, "") }
FNR == 1 {
  t = $0; sub(/[ \t]+$/, "", t)
  if (t == "---") { fm = 1; buf[++nbuf] = $0; next }
  fm = 2
}
fm == 1 {
  buf[++nbuf] = $0
  t = $0; sub(/[ \t]+$/, "", t)
  if (t == "---") { fm = 2; nbuf = 0; next }
  if (!nodoc && $0 ~ /^id:/) doc = fmval($0)
  next
}
{ body($0, FNR) }
END { endfile() }
'

# The rows of TASKS_AWK for every file under <dir> of the vault at <root>: <root> <dir> <name> <id>.
# The space of each file is _space_of's, as docs says it (once per file), as <vault>/<path>.
_tasks_scan() {
  local root="$1" name="$3" line key rest rel last="" sp=""
  _vault_cfg "$root"
  _linked_spaces "$name"
  _walk "$root" "$2" | tr '\n' '\0' |
    TR="$root" TV="$name" TI="$4" xargs -0 -r awk "$TASKS_AWK" |
    while IFS= read -r line; do
      key="${line%%"$US"*}" rest="${line#*"$US"}"
      rest="${rest#*"$US"}" rel="${rest%%"$US"*}"
      if [[ "$rel" != "$last" ]]; then
        last="$rel"
        _space_of "$root" "$rel" "$name"
        sp="${REPLY:+$name/$REPLY}"
      fi
      printf '%s\n' "$key$US$sp$US$rest"
    done
}

cmd_tasks() {
  local v to="${CLI_OPT[to]:-}"
  _require_yq
  _space_opt
  _scope "${1:-}" "${to%/}" "$REPLY"
  for v in "${!S_ROOT[@]}"; do
    _tasks_scan "${S_ROOT[$v]}" "${S_DIR[$v]}" "${S_NAME[$v]}" "$(_cfg_id "${S_ROOT[$v]}")"
  done | anfs_sorted |
    anfs_table "SPACE FILE LINE TEXT" "space file line text vault_id vault doc section parent tags[]"
}

# --- links.yml: where vault spaces are linked ---------------------------------------------
#
# The person's declaration, ~/.config/ovm/links.yml, then this machine's additions in
# links.local.yml beside it: a list of {vault, space, to, as}. Both are read, links.yml first, and
# a pair (vault, space, one of to) given twice is one link: a local file adds, it cannot take one
# away. ovm writes them only from space link, unlink and remove: links.yml when it is a file or
# missing, links.local.yml when links.yml is a link (shipped by a layer of the person's
# repository, which is theirs to edit).

# The declared pairs, one per (vault, space, wsm space): K_VAULT, K_SPACE (its path under
# spaces_path), K_TO, K_AS (the default, the last part of the space's path, filled in), K_FILE (where it is declared first). K_RO[vault|space|to]
# is the shipped file (a link) that declares that pair, when one does.
K_VAULT=() K_SPACE=() K_TO=() K_AS=() K_FILE=()
declare -A K_RO=() K_SEEN=()
K_LOADED=false
# With K_SOFT=true (wsm's events), a file that does not read is warned about, and _pairs_load
# returns 1 instead of exiting
K_SOFT=false

_pairs_bad() {
  if $K_SOFT; then warn "$1 (no links read)"; return 1; fi
  fail "$EX_USAGE" "$1"
}

# Read <file> into K_*. A file that is not a list of {vault, space, to[, as]} is refused whole.
_pairs_read() {
  local f="$1" tag line n=0 k t key
  local -a F=() keys=() tos=() ttags=()
  local -a v=() s=() to=() as=()
  local where
  tag=$(yq -r tag "$f" 2>/dev/null) || { _pairs_bad "$(_display "$f") does not parse as YAML"; return 1; }
  [[ "$tag" != "!!null" ]] || return 0
  [[ "$tag" == "!!seq" ]] || { _pairs_bad "$(_display "$f") is not a list of {vault, space, to, as} entries"; return 1; }
  # shellcheck disable=SC2016
  while IFS= read -r line; do
    # (yq prints a blank line for a list with only comments before it)
    [[ -n "$line" ]] || continue
    n=$((n + 1))
    IFS="$US" read -ra F <<< "$line"
    where="$(_display "$f"): entry $n"
    [[ "${F[0]:-}" == "!!map" ]] || { _pairs_bad "$where is not a map of vault, space, to and as"; return 1; }
    IFS=, read -ra keys <<< "${F[1]:-}"
    for key in "${keys[@]}"; do
      case "$key" in vault|space|to|as) ;; *) _pairs_bad "$where: unknown key '$key' (vault, space, to, as)"; return 1 ;; esac
    done
    [[ "${F[2]:-}" == "!!str" && -n "${F[3]:-}" && "${F[3]}" != */* ]] ||
      { _pairs_bad "$where: vault is the name of an entry of $(_display "$OVM_VAULTS_HOME")"; return 1; }
    while [[ "${F[5]:-}" == ?*/ ]]; do F[5]="${F[5]%/}"; done
    where+=" (${F[3]}/${F[5]:-})"
    [[ "${F[4]:-}" == "!!str" ]] && _space_path_ok "${F[5]:-}" ||
      { _pairs_bad "$where: space is a folder's path under the vault's spaces_path (product, anfs/product)"; return 1; }
    case "${F[6]:-}" in
      "!!null") ;;
      "!!str") [[ -n "${F[7]:-}" && "${F[7]}" != */* && "${F[7]}" != .* ]] ||
                 { _pairs_bad "$where: as is a name, not a path"; return 1; } ;;
      *) _pairs_bad "$where: as is a name"; return 1 ;;
    esac
    IFS=, read -ra ttags <<< "${F[9]:-}"
    tos=("${F[@]:10}")
    case "${F[8]:-}" in
      "!!str"|"!!seq") ;;
      *) _pairs_bad "$where: to is a wsm space, or a list of them (wsm ls)"; return 1 ;;
    esac
    [[ ${#tos[@]} -gt 0 ]] || { _pairs_bad "$where: to is empty"; return 1; }
    for k in "${!tos[@]}"; do
      [[ "${ttags[$k]:-}" == "!!str" && -n "${tos[$k]}" ]] ||
        { _pairs_bad "$where: to is a wsm space, or a list of them (wsm ls)"; return 1; }
      v+=("${F[3]}") s+=("${F[5]}") to+=("${tos[$k]%/}") as+=("${F[7]:-}")
    done
  done < <(US="$US" yq -r '.[] | [tag, ((select(tag == "!!map") | keys | join(",")) // ""),
      (.vault | tag), (.vault // "" | tostring), (.space | tag), (.space // "" | tostring),
      (.as | tag), (.as // "" | tostring), (.to | tag), ([.to] | flatten | map(tag) | join(",")),
      ([.to] | flatten | .[] | tostring)] | join(strenv(US))' "$f" 2>/dev/null)
  # Valid as a whole: now it counts
  for k in "${!v[@]}"; do
    key="${v[$k]}|${s[$k]}|${to[$k]}"
    [[ ! -L "$f" ]] || K_RO[$key]="$f"
    [[ -z "${K_SEEN[$key]:-}" ]] || continue
    K_SEEN[$key]=1
    K_VAULT+=("${v[$k]}") K_SPACE+=("${s[$k]}") K_TO+=("${to[$k]}") K_AS+=("${as[$k]:-${s[$k]##*/}}") K_FILE+=("$f")
  done
}

_pairs_load() {
  local f
  $K_LOADED && return 0
  _require_yq
  K_VAULT=() K_SPACE=() K_TO=() K_AS=() K_FILE=() K_RO=() K_SEEN=()
  for f in "$OVM_LINKS_YML" "$OVM_LINKS_LOCAL"; do
    [[ -e "$f" ]] || continue
    _pairs_read "$f" || return 1
  done
  K_LOADED=true
}

# The file ovm writes, into LW: links.yml, unless it is a link (shipped), then links.local.yml
_links_writable() {
  LW="$OVM_LINKS_YML"
  [[ ! -L "$OVM_LINKS_YML" ]] || LW="$OVM_LINKS_LOCAL"
}

# Add <to> to the entry of <vault>, <space> and <as> (empty: the default) in <file>, or a new entry
_links_add() {
  local f="$1" n
  if [[ ! -e "$f" ]]; then
    mkdir -p -- "${f%/*}" || die "cannot create ${f%/*}"
    cat > "$f" <<'EOF'
# Which vault spaces ovm links into which wsm spaces (ovm help). Written by ovm space link, unlink
# and remove; ovm space apply makes what is missing on a machine.
#- vault: apex                 # an entry of ~/vaults
#  space: anfs/product         # a folder under that vault's spaces_path, by its path
#  to: [anfs-dev, lgat/tech]   # wsm space ids (wsm ls)
#  as: apex                    # optional: the link's name in each wsm space (default: product)
EOF
  fi
  # shellcheck disable=SC2016
  n=$(V="$2" S="$3" A="$5" yq -r '[(. // [])[] | select(tag == "!!map" and .vault == strenv(V) and .space == strenv(S)
      and (.as // "") == strenv(A))] | length' "$f") || die "$(_display "$f") does not parse"
  if [[ "$n" -gt 0 ]]; then
    V="$2" S="$3" A="$5" T="$4" yq -i '(.[] | select(tag == "!!map" and .vault == strenv(V) and .space == strenv(S)
      and (.as // "") == strenv(A)) | .to) |= ([.] | flatten) + [strenv(T)]' "$f"
  elif [[ -n "$5" ]]; then
    V="$2" S="$3" A="$5" T="$4" yq -i '. += [{"vault": strenv(V), "space": strenv(S), "to": [strenv(T)], "as": strenv(A)}] |
      .[-1].to style="flow"' "$f"
  else
    V="$2" S="$3" T="$4" yq -i '. += [{"vault": strenv(V), "space": strenv(S), "to": [strenv(T)]}] | .[-1].to style="flow"' "$f"
  fi
}

# Take the pair <vault> <space> <to> out of every file ovm may write that has it; an entry whose
# to is left empty goes
_links_del() {
  local f
  for f in "$OVM_LINKS_YML" "$OVM_LINKS_LOCAL"; do
    [[ -f "$f" && ! -L "$f" ]] || continue
    # shellcheck disable=SC2016
    V="$1" S="$2" T="$3" yq -i '
      del(.[] | select(tag == "!!map" and .vault == strenv(V) and .space == strenv(S) and (.to | tag) == "!!str" and .to == strenv(T))) |
      del(.[] | select(tag == "!!map" and .vault == strenv(V) and .space == strenv(S) and (.to | tag) == "!!seq") | .to[] | select(. == strenv(T))) |
      del(.[] | select(tag == "!!map" and .vault == strenv(V) and .space == strenv(S) and (.to | tag) == "!!seq" and (.to | length) == 0))' "$f"
  done
}

# --- Links: vault spaces in wsm spaces ----------------------------------------------------
#
# A link is <wsm space's directory>/<as> -> <vault>/<spaces_path>/<space>. The wsm space's
# directory comes from wsm (`wsm ls --json`: space and dir, null when the space is not installed),
# so links.yml holds no path and works on another machine. One tool reads another's list as JSON,
# never by column (lib/anfs/table.sh).

declare -A WSM_DIR=() WSM_KNOWN=()
WSM_LOADED=false WSM_OK=false
# Read wsm's spaces; without wsm, fail 69, or with `soft` return 1 and leave WSM_OK false
_wsm_load() {
  local id dir
  $WSM_LOADED && { $WSM_OK || [[ "${1:-}" == soft ]] || _wsm_missing; return 0; }
  WSM_LOADED=true
  if ! command -v wsm >/dev/null 2>&1; then
    [[ "${1:-}" == soft ]] && return 0
    _wsm_missing
  fi
  WSM_DIR=() WSM_KNOWN=()
  while IFS="$US" read -r id dir; do
    id="${id%/}"
    [[ -n "$id" ]] || continue
    WSM_KNOWN[$id]=1
    WSM_DIR[$id]="$dir"
  done < <(wsm ls --json 2>/dev/null | yq -p json -r ".[] | .space + \"$US\" + (.dir // \"\")" 2>/dev/null || true)
  WSM_OK=true
}
_wsm_missing() { fail "$EX_UNAVAIL" "wsm is required to link vault spaces (ppm install core/wsm)"; }

# The record of the symlinks ovm made: path, vault id, what it points at, the space. Loaded into
# R_PATH, R_VID, R_DEST, R_TGT.
R_PATH=() R_VID=() R_DEST=() R_TGT=()
_rec_load() {
  local path vid dest tgt
  R_PATH=() R_VID=() R_DEST=() R_TGT=()
  [[ -f "$OVM_LINKS" ]] || return 0
  while IFS="$US" read -r path vid dest tgt; do
    [[ -n "$path" ]] || continue
    R_PATH+=("$path") R_VID+=("$vid") R_DEST+=("$dest") R_TGT+=("$tgt")
  done < "$OVM_LINKS"
}
# Rewrite the record without <path>, then with it again when the other three are given
_rec_set() {
  local path="$1" i tmp="$OVM_LINKS.tmp.$$"
  _lock_acquire
  _rec_load
  for i in "${!R_PATH[@]}"; do
    [[ "${R_PATH[$i]}" == "$path" ]] && continue
    printf '%s\n' "${R_PATH[$i]}$US${R_VID[$i]}$US${R_DEST[$i]}$US${R_TGT[$i]}"
  done > "$tmp"
  [[ $# -lt 4 ]] || printf '%s\n' "$path$US$2$US$3$US$4" >> "$tmp"
  mv -- "$tmp" "$OVM_LINKS"
  _lock_release
}

# Where one link stands. Sets LS_STATE, LS_PATH (the symlink), LS_DEST (what it should point at):
#   ok         the symlink is there and points into the vault
#   missing    the wsm space is installed and nothing is at the symlink's path
#   pending    the wsm space is not installed; wsm will say when it is
#   unknown    no source defines the wsm space (or there is no wsm to ask)
#   conflict   something else is at the symlink's path
#   no folder  the vault space's folder is not there
#   dangling   the folder is gone and ovm's symlink is still there, pointing at nothing
# Usage: _link_state <vault root> <folder, relative to it> <wsm space> <as>
LS_STATE="" LS_PATH="" LS_DEST=""
_link_state() {
  local root="$1" src="$2" tgt="$3" as="$4" dir=""
  LS_DEST="$root/$src" LS_PATH=""
  [[ -z "${WSM_KNOWN[$tgt]:-}" ]] || dir="${WSM_DIR[$tgt]:-}"
  [[ -z "$dir" ]] || LS_PATH="$dir/$as"
  if [[ ! -d "$LS_DEST" ]]; then
    if [[ -n "$LS_PATH" && -L "$LS_PATH" && "$(anfs_link_src_state "$LS_PATH" "$LS_DEST")" == "missing src" ]]
    then LS_STATE=dangling
    else LS_STATE="no folder"
    fi
    return 0
  fi
  if [[ -z "${WSM_KNOWN[$tgt]:-}" ]]; then LS_STATE=unknown; return 0; fi
  if [[ -z "$dir" ]]; then LS_STATE=pending; return 0; fi
  if [[ -L "$LS_PATH" ]]; then
    if _points_at "$LS_PATH" "$LS_DEST"; then LS_STATE=ok; else LS_STATE=conflict; fi
  elif [[ -e "$LS_PATH" ]]; then
    LS_STATE=conflict
  else
    LS_STATE=missing
  fi
}

# True when the symlink <path> leads to <dest>: as written, or once both are resolved (a link
# made by hand may spell the same directory another way)
_points_at() {
  local to
  to=$(readlink -- "$1" 2>/dev/null) || return 1
  [[ "$to" == "$2" ]] && return 0
  [[ -d "$1" && -d "$2" && "$(_canon "$1")" == "$(_canon "$2")" ]]
}

# A symlink in a cloned repo would show up there as an untracked file
_in_git() { [[ "$(git -C "$1" rev-parse --is-inside-work-tree 2>/dev/null)" == true ]]; }

# Bring one link into being. Returns 1 when it could not be (and says why).
# Usage: _link_make <root> <vault id> <folder> <wsm space> <as> <label: vault/space>
_link_make() {
  local root="$1" vid="$2" src="$3" tgt="$4" as="$5" label="$6"
  _link_state "$root" "$src" "$tgt" "$as"
  case "$LS_STATE" in
    ok)
      _rec_set "$LS_PATH" "$vid" "$LS_DEST" "$tgt"
      ;;
    missing)
      if _in_git "${LS_PATH%/*}"; then
        warn "not linking $label: $(_display "${LS_PATH%/*}") is inside a git repository, where the link would be an untracked file"
        return 1
      fi
      anfs_link_one "$LS_DEST" "$LS_PATH" || { warn "cannot link $(_display "$LS_PATH")"; return 1; }
      _rec_set "$LS_PATH" "$vid" "$LS_DEST" "$tgt"
      say "linked $(_display "$LS_PATH") -> $(_display "$LS_DEST")"
      ;;
    pending)  say "pending $label -> $tgt: the wsm space is not installed (wsm install $tgt)" ;;
    unknown)  warn "$label: no wsm space '$tgt' (wsm ls)"; return 1 ;;
    "no folder"|dangling) warn "$label: no such folder in the vault: $(_display "$LS_DEST")"; return 1 ;;
    conflict) warn "$label: $(_display "$LS_PATH") exists and is not this link; move it away, or pick another name with --as"; return 1 ;;
  esac
}

# Remove a symlink ovm made, if it still is one: never anything that replaced it
_link_drop() {
  local path="$1" dest="$2"
  if [[ -L "$path" ]] && { _points_at "$path" "$dest" || [[ "$(anfs_link_src_state "$path" "$dest")" == "missing src" ]]; }; then
    rm -f -- "$path"
    say "unlinked $(_display "$path")"
  fi
  _rec_set "$path"
}

# --- ovm space ----------------------------------------------------------------------------

# The vault space an argument names: <vault>/<path> (the first part is always the vault: apex/anfs/
# product is anfs/product in apex), or a one-part <space> in the vault you are in. Sets
# SP_VAULT (the entry's name), SP_SPACE (its path), and when the vault is usable SP_ROOT, SP_VID, SP_REL (the
# folder, relative to the root) and SP_DIR. <need>: vault (it must be usable), folder (and the
# folder there), or nothing (a vault no longer in ~/vaults is still named).
SP_VAULT="" SP_SPACE="" SP_ROOT="" SP_VID="" SP_REL="" SP_DIR=""
_space_arg() {
  local arg="$1" need="${2:-}" rc=0
  while [[ "$arg" == ?*/ ]]; do arg="${arg%/}"; done
  if [[ "$arg" == */* ]]; then
    SP_VAULT="${arg%%/*}" SP_SPACE="${arg#*/}"
  elif _vault_of "$PWD"; then
    SP_VAULT="$VA_NAME" SP_SPACE="$arg"
  else
    fail "$EX_USAGE" "name the vault: <vault>/$arg (you are not in one)"
  fi
  [[ -n "$SP_VAULT" && "$SP_VAULT" != .* ]] && _space_path_ok "$SP_SPACE" ||
    fail "$EX_USAGE" "a vault space is <vault>/<path>, a folder under the vault's spaces_path (apex/anfs/product): $arg"
  SP_ROOT="" SP_VID="" SP_REL="" SP_DIR=""
  _vaults_load
  _vault_resolve "$SP_VAULT" || rc=$?
  [[ $rc -ne 2 ]] || _ambiguous "$SP_VAULT"
  if [[ $rc -eq 0 && "${E_STATE[$V_I]}" == ok ]]; then
    SP_VAULT="${E_NAME[$V_I]}" SP_ROOT="${E_ROOT[$V_I]}" SP_VID="${E_ID[$V_I]}"
    _vault_cfg "$SP_ROOT"
    if [[ -n "$VC_SPACES" ]]; then
      SP_REL="$VC_PFX$SP_SPACE" SP_DIR="$SP_ROOT/$SP_REL"
    elif [[ -n "$need" ]]; then
      fail "$EX_STALE" "$(_display "$SP_ROOT/$OVM_CONFIG"): $VC_BAD"
    fi
  elif [[ -n "$need" ]]; then
    [[ $rc -ne 0 ]] || fail "$EX_STALE" "${E_NAME[$V_I]} is ${E_STATE[$V_I]} (ovm list)"
    fail "$EX_NOTFOUND" "no vault '$SP_VAULT' in $(_display "$OVM_VAULTS_HOME") (ovm list)"
  fi
  if [[ "$need" == folder && ! -d "$SP_DIR" ]]; then
    fail "$EX_NOTFOUND" "no folder $(_display "$SP_DIR"): ovm space add $SP_VAULT/$SP_SPACE"
  fi
  return 0
}

# One row of space list: space, to, as, status, the link, vault, the folder
_space_row() { printf '%s\n' "$1$US$2$US$3$US$4$US$5$US$6$US$7"; }

cmd_space_list() {
  local want="${1:-}" problems=${CLI_OPT[problems]:-false}
  _require_yq
  _pairs_load
  _wsm_load soft
  $WSM_OK || warn "wsm is not installed: where vault spaces are linked is unknown (ppm install core/wsm)"
  local all=false v i s name root
  local -a vs=()
  _live_vaults
  if [[ -n "$want" ]]; then
    _vault_named "$want"
    vs=("${LIVE_IX[${E_NAME[$V_I]}]}")
  elif _vault_of "$PWD"; then
    vs=("${LIVE_IX[$VA_NAME]}")
  else
    all=true
    vs=("${!LIVE[@]}")
  fi

  # Every declared link's path, so a symlink in the record that none declares is an orphan
  local -A declared=() vid_name=()
  for i in "${!K_VAULT[@]}"; do
    [[ -z "${WSM_DIR[${K_TO[$i]}]:-}" ]] || declared["${WSM_DIR[${K_TO[$i]}]}/${K_AS[$i]}"]=1
  done
  for v in "${!LIVE[@]}"; do vid_name[v${LIVE_ID[$v]}]="${LIVE_NAME[$v]}"; done

  local -a rows=()
  local -A shown=() mine=()
  for v in "${vs[@]}"; do
    root="${LIVE[$v]}" name="${LIVE_NAME[$v]}"
    mine[v${LIVE_ID[$v]}]=1
    _vault_cfg "$root"
    [[ -z "$VC_BAD" ]] || warn "$(_display "$root/$OVM_CONFIG"): $VC_BAD"
    # The top-level folders and every space path links.yml declares in this vault, in order:
    # each with its links, or unlinked
    local -a paths=()
    while IFS= read -r s; do
      [[ -n "$s" && -z "${shown[$s]:-}" ]] || continue
      shown[$s]=1 paths+=("$s")
    done < <(_space_dirs "$root"
             for i in "${!K_VAULT[@]}"; do [[ "${K_VAULT[$i]}" != "$name" ]] || printf '%s\n' "${K_SPACE[$i]}"; done)
    if [[ ${#paths[@]} -gt 0 ]]; then mapfile -t paths < <(printf '%s\n' "${paths[@]}" | LC_ALL=C sort); fi
    for s in "${paths[@]}"; do
      local any=false
      for i in "${!K_VAULT[@]}"; do
        [[ "${K_VAULT[$i]}" == "$name" && "${K_SPACE[$i]}" == "$s" ]] || continue
        any=true
        if [[ -n "$VC_SPACES" ]]; then
          _link_state "$root" "$VC_PFX$s" "${K_TO[$i]}" "${K_AS[$i]}"
        else
          LS_STATE="no folder" LS_PATH="" LS_DEST=""
        fi
        rows+=("$(_space_row "$s" "${K_TO[$i]}" "${K_AS[$i]}" "$LS_STATE" "$LS_PATH" "$name" "$LS_DEST")")
      done
      $any || rows+=("$(_space_row "$s" "" "" unlinked "" "$name" "$root/$VC_PFX$s")")
    done
    shown=()
  done
  if $all; then
    # Entries naming a vault that is not one here (an unreachable one was warned about)
    for i in "${!K_VAULT[@]}"; do
      [[ -z "${LIVE_IX[${K_VAULT[$i]}]+x}" ]] || continue
      _vault_resolve "${K_VAULT[$i]}" && [[ "${E_STATE[$V_I]}" == unreachable ]] && continue
      rows+=("$(_space_row "${K_SPACE[$i]}" "${K_TO[$i]}" "${K_AS[$i]}" "no vault" "" "${K_VAULT[$i]}" "")")
    done
  fi
  # Symlinks ovm made that no entry declares any more
  _rec_load
  for i in "${!R_PATH[@]}"; do
    [[ -z "${declared[${R_PATH[$i]}]:-}" && -L "${R_PATH[$i]}" ]] || continue
    $all || [[ -n "${mine[v${R_VID[$i]}]:-}" ]] || continue
    s="${R_DEST[$i]##*/}" name="${vid_name[v${R_VID[$i]}]:-}"
    if [[ -n "$name" ]]; then
      root="${LIVE[${LIVE_IX[$name]}]}"
      _vault_cfg "$root"
      [[ -z "$VC_SPACES" || "${R_DEST[$i]}" != "$root/$VC_PFX"?* ]] || s="${R_DEST[$i]#"$root/$VC_PFX"}"
    fi
    rows+=("$(_space_row "$s" "${R_TGT[$i]}" "${R_PATH[$i]##*/}" orphan "${R_PATH[$i]}" "$name" "${R_DEST[$i]}")")
  done

  local -a out=()
  local row st
  for row in "${rows[@]}"; do
    if $problems; then
      st="${row#*"$US"*"$US"*"$US"}" st="${st%%"$US"*}"
      case "$st" in ok|pending|unlinked) continue ;; esac
    fi
    out+=("$row")
  done
  if [[ ${#out[@]} -gt 0 ]]; then printf '%s\n' "${out[@]}"; fi |
    anfs_table "SPACE TO AS STATUS LINK VAULT" "space to as status link vault path"
  if $problems; then
    [[ ${#out[@]} -eq 0 ]] || return 1
    say "no problems"
  fi
  return 0
}

cmd_space_add() {
  _require_yq
  _pairs_load
  _space_arg "$1" vault
  if [[ -d "$SP_DIR" ]]; then
    say "already a space: $(_display "$SP_DIR")"
    anfs_result space "$SP_SPACE" vault "$SP_VAULT" path "$SP_DIR" status unchanged
    return 0
  fi
  [[ ! -e "$SP_DIR" ]] || fail "$EX_EXISTS" "$(_display "$SP_DIR") exists and is not a folder"
  mkdir -p -- "$SP_DIR" || die "cannot create $SP_DIR"
  say "made $SP_VAULT/$SP_SPACE: $(_display "$SP_DIR")"
  anfs_result space "$SP_SPACE" vault "$SP_VAULT" path "$SP_DIR" status made
}

cmd_space_link() {
  local to="${2%/}" as="${CLI_OPT[as]:-}"
  [[ "$as" != */* && "$as" != . && "$as" != .. ]] || fail "$EX_USAGE" "--as is a name, not a path: $as"
  _require_yq
  _pairs_load
  _space_arg "$1" folder
  _wsm_load
  [[ -n "${WSM_KNOWN[$to]:-}" ]] || fail "$EX_NOTFOUND" "no wsm space '$to' (wsm ls)"
  [[ -n "$SP_VID" ]] || die "$(_display "$SP_ROOT/$OVM_CONFIG") has no id: ovm init $(_display "$SP_ROOT")"
  [[ "$as" != "${SP_SPACE##*/}" ]] || as=""
  local name="${as:-${SP_SPACE##*/}}" label="$SP_VAULT/$SP_SPACE" key="$SP_VAULT|$SP_SPACE|$to" i old="" declared=false
  for i in "${!K_VAULT[@]}"; do
    [[ "${K_VAULT[$i]}|${K_SPACE[$i]}|${K_TO[$i]}" == "$key" ]] || continue
    declared=true old="${K_AS[$i]}"
  done
  # Declared in a shipped file under another name: that file is the person's repository's
  if [[ -n "${K_RO[$key]:-}" && "$old" != "$name" ]]; then
    fail "$EX_NOTFOUND" "$label -> $to is declared in $(_display "${K_RO[$key]}") as $old, which is shipped (a link): edit it there"
  fi

  # Everything that would refuse the link, before links.yml changes
  _link_state "$SP_ROOT" "$SP_REL" "$to" "$name"
  case "$LS_STATE" in
    conflict) fail "$EX_EXISTS" "$(_display "$LS_PATH") exists and is not this link; move it away, or pick another name with --as" ;;
    missing)
      ! _in_git "${LS_PATH%/*}" ||
        fail "$EX_UNAVAIL" "$(_display "${LS_PATH%/*}") is inside a git repository, where the link would be an untracked file"
      ;;
  esac

  # One link per vault space and wsm space: again with another name renames it
  if ! $declared || [[ "$old" != "$name" ]]; then
    _links_writable
    [[ "$LW" != "$OVM_LINKS_LOCAL" ]] ||
      say "$(_display "$OVM_LINKS_YML") is shipped (a link): writing $(_display "$OVM_LINKS_LOCAL")"
    ! $declared || _links_del "$SP_VAULT" "$SP_SPACE" "$to"
    _links_add "$LW" "$SP_VAULT" "$SP_SPACE" "$to" "$as"
    if $declared && [[ -n "${WSM_DIR[$to]:-}" ]]; then _link_drop "${WSM_DIR[$to]}/$old" "$LS_DEST"; fi
  fi
  local rc=0
  _link_make "$SP_ROOT" "$SP_VID" "$SP_REL" "$to" "$name" "$label" || rc=1
  anfs_result space "$SP_SPACE" to "$to" as "$name" status "$LS_STATE" link "$LS_PATH" vault "$SP_VAULT" path "$LS_DEST"
  return "$rc"
}

# Unlink the vault space in SP_* from <to> (every wsm space when empty): the links ovm made, and
# the pairs in the files ovm writes. A pair a shipped file declares is left, and named. Prints
# nothing to count; returns 1 when nothing matched or a pair is shipped.
_space_unlink() {
  local to="$1" i j n=0 label="$SP_VAULT/$SP_SPACE" key
  local -a shipped=()
  _wsm_load soft
  for i in "${!K_VAULT[@]}"; do
    [[ "${K_VAULT[$i]}" == "$SP_VAULT" && "${K_SPACE[$i]}" == "$SP_SPACE" ]] || continue
    [[ -z "$to" || "${K_TO[$i]}" == "$to" ]] || continue
    key="$SP_VAULT|$SP_SPACE|${K_TO[$i]}"
    if [[ -n "${K_RO[$key]:-}" ]]; then shipped+=("${K_TO[$i]}$US${K_RO[$key]}"); continue; fi
    n=$((n + 1))
    # The links ovm made for it: the record's (a wsm space no longer installed is only there),
    # and the one wsm's directory says
    if [[ -n "$SP_DIR" ]]; then
      _rec_load
      local -a paths=("${R_PATH[@]}") dests=("${R_DEST[@]}") tgts=("${R_TGT[@]}")
      for j in "${!paths[@]}"; do
        [[ "${dests[$j]}" == "$SP_DIR" && "${tgts[$j]}" == "${K_TO[$i]}" ]] || continue
        _link_drop "${paths[$j]}" "${dests[$j]}"
      done
      [[ -z "${WSM_DIR[${K_TO[$i]}]:-}" ]] || _link_drop "${WSM_DIR[${K_TO[$i]}]}/${K_AS[$i]}" "$SP_DIR"
    fi
    _links_del "$SP_VAULT" "$SP_SPACE" "${K_TO[$i]}"
    say "removed $label -> ${K_TO[$i]} from links.yml"
  done
  for i in "${shipped[@]}"; do
    warn "$label -> ${i%%"$US"*} is declared in $(_display "${i#*"$US"}"), which is shipped (a link): edit it there"
  done
  UNLINKED=$n
  [[ ${#shipped[@]} -eq 0 ]] || return 1
  [[ $n -gt 0 ]] || fail "$EX_NOTFOUND" "no link of $label${to:+ into $to} in links.yml (ovm space ls)"
}

cmd_space_unlink() {
  local to="${2:-}" rc=0
  to="${to%/}"
  _require_yq
  _pairs_load
  _space_arg "$1"
  _space_unlink "$to" || rc=$?
  anfs_result space "$SP_SPACE" vault "$SP_VAULT" removed "$UNLINKED"
  return "$rc"
}

cmd_space_remove() {
  local i n=0 rc=0
  _require_yq
  _pairs_load
  _space_arg "$1"
  for i in "${!K_VAULT[@]}"; do
    [[ "${K_VAULT[$i]}" == "$SP_VAULT" && "${K_SPACE[$i]}" == "$SP_SPACE" ]] && n=$((n + 1))
  done
  [[ $n -gt 0 ]] || fail "$EX_NOTFOUND" "$SP_VAULT/$SP_SPACE is not linked anywhere: nothing to remove (its folder is yours: rm it yourself)"
  anfs_confirm "space remove unlinks $SP_VAULT/$SP_SPACE from $n wsm space(s) and takes it out of links.yml; its folder stays" "Unlink it?"
  _space_unlink "" || rc=$?
  [[ -z "$SP_DIR" || ! -d "$SP_DIR" ]] || say "left $(_display "$SP_DIR") and its notes"
  anfs_result space "$SP_SPACE" vault "$SP_VAULT" removed "$UNLINKED"
  return "$rc"
}

cmd_space_apply() {
  local event="${CLI_OPT[event]:-}" arg i v rc=0 made=0
  local -A want=()
  for arg in "$@"; do [[ -z "${arg%/}" ]] || want[${arg%/}]=1; done
  _require_yq
  if [[ -z "$event" ]]; then
    _pairs_load
    _wsm_load
    _live_vaults
    for i in "${!K_VAULT[@]}"; do
      [[ ${#want[@]} -eq 0 || -n "${want[${K_TO[$i]}]:-}" ]] || continue
      # Only what can be here: the vault in ~/vaults, its folder there (space list shows the rest)
      [[ -n "${LIVE_IX[${K_VAULT[$i]}]+x}" ]] || continue
      v=${LIVE_IX[${K_VAULT[$i]}]}
      _vault_cfg "${LIVE[$v]}"
      [[ -n "$VC_SPACES" && -d "${LIVE[$v]}/$VC_PFX${K_SPACE[$i]}" ]] || continue
      made=$((made + 1))
      _link_make "${LIVE[$v]}" "${LIVE_ID[$v]}" "$VC_PFX${K_SPACE[$i]}" "${K_TO[$i]}" "${K_AS[$i]}" \
        "${K_VAULT[$i]}/${K_SPACE[$i]}" || rc=1
    done
    [[ ${#K_VAULT[@]} -gt 0 ]] || say "no links in $(_display "$OVM_LINKS_YML") (ovm space link <vault>/<space> <spec>)"
    anfs_result applied "$made" ok "$([[ $rc -eq 0 ]] && echo true || echo false)"
    return "$rc"
  fi

  # From wsm, for the spaces it just installed or removed. Never fails the tool that emitted:
  # what could not be done is said, and `ovm space list --problems` shows it later.
  [[ ${#want[@]} -gt 0 ]] || return 0
  case "$event" in
    install)
      K_SOFT=true
      _pairs_load || return 0
      _wsm_load soft
      $WSM_OK || return 0
      _live_vaults
      for i in "${!K_VAULT[@]}"; do
        [[ -n "${want[${K_TO[$i]}]:-}" && -n "${LIVE_IX[${K_VAULT[$i]}]+x}" ]] || continue
        v=${LIVE_IX[${K_VAULT[$i]}]}
        _vault_cfg "${LIVE[$v]}"
        [[ -n "$VC_SPACES" ]] || continue
        _link_make "${LIVE[$v]}" "${LIVE_ID[$v]}" "$VC_PFX${K_SPACE[$i]}" "${K_TO[$i]}" "${K_AS[$i]}" \
          "${K_VAULT[$i]}/${K_SPACE[$i]}" || true
      done
      ;;
    remove)
      # The space is gone from wsm, so its directory is only in the record of what ovm linked
      _rec_load
      local -a paths=("${R_PATH[@]}") dests=("${R_DEST[@]}") tgts=("${R_TGT[@]}")
      for i in "${!paths[@]}"; do
        [[ -n "${want[${tgts[$i]}]:-}" ]] || continue
        _link_drop "${paths[$i]}" "${dests[$i]}"
      done
      ;;
    *) cli_usage_err "unknown event '$event': install or remove" ;;
  esac
  return 0
}

# --- validate -----------------------------------------------------------------------------
#
# A document is checked against the vocabulary of vault.yml: its own keys (required, kinds,
# fields, tags), merged with those of the deepest vault space holding it that has an entry
# (spaces.<path>: anfs, or anfs/product): required and tags
# are the union, kinds and fields the vault's with the space's entries replacing the same names.

# Put `id: <id>` into a document's frontmatter: on its empty id line, else as its last line
_doc_set_id() {
  local file="$1" id="$2" tmp
  tmp=$(mktemp "${TMPDIR:-/tmp}/ovm-id.XXXXXX")
  awk -v id="$id" '
    NR == 1 { print; fm = 1; next }
    fm == 1 && /^id:/ { print "id: " id; done = 1; next }
    fm == 1 && /^---[ \t\r]*$/ { if (!done) print "id: " id; fm = 2 }
    { print }
  ' "$file" > "$tmp"
  # Written through, not moved over: the file keeps its inode, mode and whatever syncs it
  cat -- "$tmp" > "$file"
  rm -f -- "$tmp"
}

# The inline tags of documents (file<US>tag per line): `#name` at the start of a line or after a
# space, outside the frontmatter, fenced code and inline code
# shellcheck disable=SC2016
TAGS_AWK='
FNR == 1 { fm = 0; fence = 0; if ($0 ~ /^---[ \t\r]*$/) { fm = 1; next } }
fm == 1 { if ($0 ~ /^---[ \t\r]*$/) fm = 2; next }
/^[ \t]*(```|~~~)/ { fence = !fence; next }
fence { next }
{
  line = $0
  gsub(/`[^`]*`/, "", line)
  line = " " line
  while (match(line, /[ \t]#[A-Za-z][A-Za-z0-9_\/-]*/)) {
    print FILENAME "\037" substr(line, RSTART + 2, RLENGTH - 2)
    line = substr(line, RSTART + RLENGTH)
  }
}
'

# The value types a field may have
OVM_FIELD_TYPES="string number bool date datetime list"

# The vocabulary of <root>/vault.yml, into V_* (keyed by scope, or "<scope>|<name>": the scope is
# a vault space's name, or . for the vault's own), and V_FINDINGS: what is wrong with vault.yml
declare -A V_REQ=() V_KIND=() V_KREQ=() V_FTYPE=() V_FALLOW=() V_TAG=() V_NKIND=() V_NTAG=() V_SPACE=()
V_FINDINGS=() V_HAS_REQ=false
_vocab_load() {
  local root="$1" path tag val sc key
  local -a P=() rest=()
  local -A said=()
  while IFS="$US" read -r path tag val; do
    [[ -n "$path" ]] || continue
    IFS="$RS" read -ra P <<< "$path"
    # The vault's own keys
    if [[ ${#P[@]} -eq 1 ]]; then
      case "${P[0]}" in
        id|name|spaces_path|exclude|required|kinds|fields|tags|spaces) ;;
        links) V_FINDINGS+=("links: is not read: link a vault space with ovm space link, declared in $(_display "$OVM_LINKS_YML")") ;;
        profile) V_FINDINGS+=("profile: is not read: its required is required:, its types are kinds:") ;;
        items) V_FINDINGS+=("items: is not read: what to skip is exclude:") ;;
        *) V_FINDINGS+=("unknown key '${P[0]}'") ;;
      esac
      [[ "${P[0]}" != required ]] || V_HAS_REQ=true
      continue
    fi
    # spaces.<name>.<key>...: the same vocabulary, for that space
    sc=. rest=("${P[@]}")
    if [[ "${P[0]}" == spaces ]]; then
      sc="${P[1]}"
      if [[ ${#P[@]} -eq 2 ]]; then
        if ! _space_path_ok "$sc"; then
          V_FINDINGS+=("spaces.$sc: a vault space is a folder's path under spaces_path (product, anfs/product)")
          continue
        fi
        V_SPACE[$sc]=1
        [[ -n "$VC_SPACES" && -d "$root/$VC_PFX$sc" ]] ||
          V_FINDINGS+=("spaces.$sc: no folder ${VC_PFX:-./}$sc (ovm space add $sc)")
        continue
      fi
      rest=("${P[@]:2}")
      if [[ ${#rest[@]} -eq 1 ]]; then
        case "${rest[0]}" in
          required|kinds|fields|tags) ;;
          *) V_FINDINGS+=("spaces.$sc: unknown key '${rest[0]}' (required, kinds, fields, tags)") ;;
        esac
        continue
      fi
    fi
    key="$sc|${rest[1]}"
    case "${rest[0]}" in
      required) [[ "$tag" == "!!map" || "$tag" == "!!seq" ]] || V_REQ[$sc]+="$val$US" ;;
      tags)     [[ "$tag" == "!!map" || "$tag" == "!!seq" ]] || { V_TAG[$sc|${val#\#}]=1; V_NTAG[$sc]=$(( ${V_NTAG[$sc]:-0} + 1 )); } ;;
      kinds)
        if [[ ${#rest[@]} -eq 2 ]]; then
          [[ -n "${V_KIND[$key]:-}" ]] || V_NKIND[$sc]=$(( ${V_NKIND[$sc]:-0} + 1 ))
          V_KIND[$key]=1 V_KREQ[$key]="${V_KREQ[$key]:-}"
        elif [[ "${rest[2]}" == required ]]; then
          [[ ${#rest[@]} -lt 4 ]] || V_KREQ[$key]+="$val$US"
        elif [[ ${#rest[@]} -eq 3 ]]; then
          V_FINDINGS+=("kinds.${rest[1]}: unknown key '${rest[2]}' (required)")
        fi
        ;;
      fields)
        if [[ ${#rest[@]} -eq 2 ]]; then
          case "$tag" in
            "!!seq") V_FTYPE[$key]=one-of V_FALLOW[$key]="" ;;
            "!!str")
              if [[ " $OVM_FIELD_TYPES " == *" $val "* ]]; then V_FTYPE[$key]="$val"
              elif [[ -z "${said[$key]:-}" ]]; then
                said[$key]=1
                V_FINDINGS+=("fields.${rest[1]}: unknown type '$val' ($OVM_FIELD_TYPES, or a list of the values allowed)")
              fi
              ;;
            *) V_FINDINGS+=("fields.${rest[1]}: a type ($OVM_FIELD_TYPES) or a list of the values allowed") ;;
          esac
        elif [[ ${#rest[@]} -eq 3 && "${V_FTYPE[$key]:-}" == one-of ]]; then
          V_FALLOW[$key]+="$val$US"
        fi
        ;;
    esac
  done < <(_yaml_dump "$root/$OVM_CONFIG" 2>/dev/null)
  [[ -z "$VC_BAD" ]] || V_FINDINGS+=("$VC_BAD")
  $V_HAS_REQ || V_REQ[.]="type${US}id$US"
  return 0
}

# Whether <value> (with its YAML <tag>) is a <type>
_type_ok() {
  local type="$1" tag="$2" val="$3"
  case "$type" in
    string)   [[ "$tag" != "!!seq" && "$tag" != "!!map" ]] ;;
    number)   [[ "$tag" == "!!int" || "$tag" == "!!float" ]] ;;
    bool)     [[ "$tag" == "!!bool" ]] ;;
    date)     [[ "$tag" != "!!seq" && "$tag" != "!!map" && "$val" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] ;;
    datetime) [[ "$tag" != "!!seq" && "$tag" != "!!map" &&
                 "$val" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt\ ][0-9]{2}:[0-9]{2}(:[0-9]{2}(\.[0-9]+)?)?\ ?([Zz]|[+-][0-9]{2}(:?[0-9]{2})?)?$ ]] ;;
    list)     [[ "$tag" == "!!seq" ]] ;;
    *) return 0 ;;
  esac
}

# Whether the tag <t> is allowed in vault space <sc>: built in (go: what ovm tasks and pjm give a
# meaning), listed, or a listed ancestor (a allows a/b)
OVM_BUILTIN_TAGS=" go "
_tag_ok() {
  local sc="$1" t="$2"
  [[ "$OVM_BUILTIN_TAGS" != *" $t "* ]] || return 0
  while :; do
    [[ -n "${V_TAG[.|$t]:-}" || -n "${V_TAG[$sc|$t]:-}" ]] && return 0
    [[ "$t" == */* ]] || return 1
    t="${t%/*}"
  done
}

cmd_validate() {
  local path="${1:-}" fix=${CLI_OPT[fix]:-false} strict=${CLI_OPT[strict]:-false}
  _require_yq
  local scope root
  if [[ -n "$path" ]]; then
    [[ -e "$path" ]] || fail "$EX_NOTFOUND" "no such file or directory: $path"
    if [[ -d "$path" ]]; then scope=$(_canon "$path"); else scope="$(_canon "$(dirname -- "$path")")/${path##*/}"; fi
    _vault_of "$( [[ -d "$scope" ]] && echo "$scope" || dirname -- "$scope")" ||
      fail "$EX_NOTFOUND" "$(_display "$scope") is not inside a vault"
    root="$VA_ROOT"
  else
    _here
    root="$VA_ROOT" scope="$VA_ROOT"
  fi
  _vault_cfg "$root"
  _vocab_load "$root"

  local -a rows=()
  local fnd
  for fnd in "${V_FINDINGS[@]}"; do rows+=("$OVM_CONFIG$US$fnd"); done

  # The whole vault's ids, so a duplicate outside PATH is still one
  local -A state_of=() id_of=() type_of=() count=() first=()
  local f state id type title
  while IFS="$US" read -r f state id type title; do
    [[ -n "$f" ]] || continue
    state_of[$f]="$state" id_of[$f]="$id" type_of[$f]="$type"
    [[ -n "$id" ]] || continue
    count[$id]=$(( ${count[$id]:-0} + 1 ))
    [[ -n "${first[$id]:-}" ]] || first[$id]="$f"
  done < <(_doc_scan "$root" "$root")

  local -a docs=()
  if [[ -d "$scope" ]]; then
    mapfile -t docs < <(_doc_files "$root" "$scope")
  else
    docs=("$scope")
  fi

  # The inline tags, in one pass over the documents, when any tag is listed
  local -A inline=()
  local t any_tags=false
  for t in "${!V_NTAG[@]}"; do any_tags=true; done
  if $any_tags && [[ ${#docs[@]} -gt 0 && -n "${docs[0]}" ]]; then
    while IFS="$US" read -r f t; do
      [[ " ${inline[$f]:-} " == *" $t "* ]] || inline[$f]+="${inline[$f]:+ }$t"
    done < <(printf '%s\0' "${docs[@]}" | xargs -0 -r awk "$TAGS_AWK" 2>/dev/null)
  fi

  local rel sc key k p ptag pval dump minted=0 new ty kn
  local -a P=() names=() reqs=() fmtags=() items=() order=()
  local -A has=() ftag=() fval=() fitems=() asked=() told=()
  for f in "${docs[@]}"; do
    [[ -n "$f" ]] || continue
    rel="${f#"$root"/}"
    case "${state_of[$f]:-none}" in
      none) rows+=("$rel${US}no frontmatter"); continue ;;
      open) rows+=("$rel${US}the frontmatter is not closed (no second ---)"); continue ;;
    esac
    # The frontmatter, every node of it, in one read
    if ! dump=$(_fm_block "$f" | _yaml_dump - 2>/dev/null); then
      rows+=("$rel${US}the frontmatter does not parse as YAML")
      continue
    fi
    has=() ftag=() fval=() fitems=() fmtags=() order=()
    while IFS="$US" read -r p ptag pval; do
      [[ -n "$p" ]] || continue
      IFS="$RS" read -ra P <<< "$p"
      k="${P[0]}"
      if [[ ${#P[@]} -eq 1 ]]; then
        # A key with a value: not null, not an empty string
        [[ -n "$k" ]] || continue
        [[ "$ptag" == "!!null" || ( "$ptag" == "!!str" && -z "$pval" ) ]] || { has[$k]=1; order+=("$k"); }
        ftag[$k]="$ptag" fval[$k]="$pval"
        [[ "$k" != tags || "$ptag" != "!!str" ]] || read -ra fmtags <<< "${pval//,/ }"
      elif [[ ${#P[@]} -eq 2 && -n "$k" ]]; then
        fitems[$k]+="$ptag$RS$pval$US"
        [[ "$k" != tags || "$ptag" == "!!map" || "$ptag" == "!!seq" ]] || fmtags+=("$pval")
      fi
    done <<< "$dump"
    id="${id_of[$f]}"
    if $fix && [[ -z "${has[id]:-}" ]]; then
      new=$(_new_id)
      while [[ -n "${count[$new]:-}" ]]; do new=$(_new_id); done
      _doc_set_id "$f" "$new"
      count[$new]=1 first[$new]="$f" id="$new"
      has[id]=1
      minted=$((minted + 1))
      say "$rel: minted id $new"
    fi
    # The scope: the deepest vault space holding it that vault.yml says more of, else the vault's
    sc=.
    if [[ -n "$VC_SPACES" && "$rel" == "$VC_PFX"*/* ]]; then
      for key in "${!V_SPACE[@]}"; do
        if [[ "${rel#"$VC_PFX"}" == "$key"/* ]] && [[ "$sc" == . || ${#key} -gt ${#sc} ]]; then sc="$key"; fi
      done
    fi
    # required: the vault's and the space's
    IFS="$US" read -ra reqs <<< "${V_REQ[.]:-}${V_REQ[$sc]:-}"
    asked=()
    for key in "${reqs[@]}"; do
      [[ -n "$key" && -z "${asked[$key]:-}" ]] || continue
      asked[$key]=1
      [[ -n "${has[$key]:-}" ]] || rows+=("$rel${US}missing required key: $key")
    done
    # kinds: type is one of them, and has what its kind requires
    ty="${type_of[$f]}"
    if [[ $(( ${V_NKIND[.]:-0} + ${V_NKIND[$sc]:-0} )) -gt 0 && -n "$ty" ]]; then
      if [[ -n "${V_KIND[$sc|$ty]:-}" ]]; then kn="$sc|$ty"
      elif [[ -n "${V_KIND[.|$ty]:-}" ]]; then kn=".|$ty"
      else kn=""
      fi
      if [[ -z "$kn" ]]; then
        names=()
        for key in "${!V_KIND[@]}"; do
          [[ "${key%%|*}" == . || "${key%%|*}" == "$sc" ]] || continue
          [[ " ${names[*]} " == *" ${key#*|} "* ]] || names+=("${key#*|}")
        done
        mapfile -t names < <(printf '%s\n' "${names[@]}" | LC_ALL=C sort)
        rows+=("$rel${US}type '$ty' is not one of: ${names[*]}")
      else
        IFS="$US" read -ra reqs <<< "${V_KREQ[$kn]:-}"
        for key in "${reqs[@]}"; do
          [[ -n "$key" && -z "${asked[$key]:-}" ]] || continue
          asked[$key]=1
          [[ -n "${has[$key]:-}" ]] || rows+=("$rel${US}missing required key for a $ty: $key")
        done
      fi
    fi
    # fields: each key present has a value of its type, in the document's order
    for k in "${order[@]}"; do
      key=".|$k"
      [[ -z "${V_FTYPE[$sc|$k]:-}" ]] || key="$sc|$k"
      [[ -n "${V_FTYPE[$key]:-}" ]] || continue
      if [[ "${V_FTYPE[$key]}" == one-of ]]; then
        if [[ "${ftag[$k]}" == "!!seq" ]]; then
          IFS="$US" read -ra items <<< "${fitems[$k]:-}"
          for p in "${items[@]}"; do
            [[ -n "$p" ]] || continue
            [[ "$US${V_FALLOW[$key]}" == *"$US${p#*"$RS"}$US"* ]] ||
              rows+=("$rel${US}$k: '${p#*"$RS"}' is not one of: ${V_FALLOW[$key]//$US/ }")
          done
        elif [[ "$US${V_FALLOW[$key]}" != *"$US${fval[$k]}$US"* ]]; then
          rows+=("$rel${US}$k: '${fval[$k]}' is not one of: ${V_FALLOW[$key]//$US/ }")
        fi
      elif ! _type_ok "${V_FTYPE[$key]}" "${ftag[$k]}" "${fval[$k]}"; then
        rows+=("$rel${US}$k is not a ${V_FTYPE[$key]}${fval[$k]:+: ${fval[$k]}}")
      fi
    done
    # tags: in the frontmatter and inline, each listed or under a listed one
    if [[ $(( ${V_NTAG[.]:-0} + ${V_NTAG[$sc]:-0} )) -gt 0 ]]; then
      told=()
      # shellcheck disable=SC2086
      for t in "${fmtags[@]}" ${inline[$f]:-}; do
        t="${t#\#}"
        [[ -n "$t" && -z "${told[$t]:-}" ]] || continue
        told[$t]=1
        _tag_ok "$sc" "$t" || rows+=("$rel${US}tag '$t' is not in the vocabulary (vault.yml tags:)")
      done
    fi
    if [[ -n "$id" && ${count[$id]:-0} -gt 1 ]]; then
      rows+=("$rel${US}duplicate id $id$( [[ "${first[$id]}" == "$f" ]] || printf ' (also %s)' "${first[$id]#"$root"/}")")
    fi
  done

  if anfs_json_on; then
    if [[ ${#rows[@]} -gt 0 ]]; then printf '%s\n' "${rows[@]}"; fi | anfs_table "PATH FINDING" "path finding"
  else
    for f in "${rows[@]}"; do printf '%s: %s\n' "${f%%"$US"*}" "${f#*"$US"}"; done
    say "${#docs[@]} document(s), ${#rows[@]} finding(s)$( [[ $minted -eq 0 ]] || printf ', %d id(s) minted' "$minted")"
  fi
  if $strict && [[ ${#rows[@]} -gt 0 ]]; then return 1; fi
  return 0
}

# --- Completion ---------------------------------------------------------------------------
#
# What cli.sh asks for on a tab press (complete_<kind>): one candidate per line, quickly. No yq.

# The entries of ~/vaults, without looking inside them (a hung iCloud must not hang a tab press)
complete_vault() {
  local name
  while IFS= read -r name; do
    printf '%s\t%s\n' "$name" "$(anfs_display "$OVM_VAULTS_HOME/$name")"
  done < <(_entries)
}
complete_vault_or_doc() { complete_vault; }

# The spaces_path of the vault at <root>, into REPLY: its line in vault.yml, read in bash
_complete_spaces_path() {
  local line
  REPLY=spaces
  [[ -r "$1/$OVM_CONFIG" ]] || return 0
  while IFS= read -r line; do
    if [[ "$line" =~ ^spaces_path:[[:space:]]*[\"\']?([^\"\'#[:space:]]+) ]]; then
      REPLY="${BASH_REMATCH[1]%/}"
      return 0
    fi
  done < "$1/$OVM_CONFIG"
}
# The folders under <root>'s spaces_path, each printed as <prefix><name>
_complete_spaces_of() {
  local d
  _complete_spaces_path "$1"
  [[ "$REPLY" != . ]] || REPLY=""
  for d in "$1/${REPLY:+$REPLY/}"*/; do
    [[ -d "$d" ]] || continue
    d="${d%/}"
    printf '%s%s\n' "$2" "${d##*/}"
  done
}
# The deeper vault spaces links.yml and links.local.yml link: <vault>/<path> per line, read in
# bash from their block entries (`- vault: x`, `space: a/b`), as ovm writes them
_complete_linked() {
  local f line vault="" space="" re='^(-[[:space:]]+|[[:space:]]+)(vault|space):[[:space:]]*["'\'']?([^"'\''#[:space:]]+)'
  for f in "$OVM_LINKS_YML" "$OVM_LINKS_LOCAL"; do
    [[ -r "$f" ]] || continue
    vault="" space=""
    while IFS= read -r line || [[ -n "$line" ]]; do
      if [[ "$line" == -* ]]; then
        [[ -z "$vault" || "$space" != */* ]] || printf '%s/%s\n' "$vault" "${space%/}"
        vault="" space=""
      fi
      if [[ "$line" =~ $re ]]; then
        if [[ "${BASH_REMATCH[2]}" == vault ]]; then vault="${BASH_REMATCH[3]}"; else space="${BASH_REMATCH[3]}"; fi
      fi
    done < "$f"
    [[ -z "$vault" || "$space" != */* ]] || printf '%s/%s\n' "$vault" "${space%/}"
  done | LC_ALL=C sort -u
}
# A vault space: the top-level ones of the vault you are in, then <vault>/<space> for every entry
# of ~/vaults that answers (directory listings, and one line of its vault.yml), then the deeper
# ones links.yml links
complete_space() {
  local name root
  if root=$(_find_root "$PWD" 2>/dev/null); then _complete_spaces_of "$root" ""; fi
  while IFS= read -r name; do
    [[ -d "$OVM_VAULTS_HOME/$name" ]] && _reachable "$OVM_VAULTS_HOME/$name" || continue
    _complete_spaces_of "$OVM_VAULTS_HOME/$name" "$name/"
  done < <(_entries)
  _complete_linked
}
complete_vault_or_space() { complete_vault; complete_space; }
# --space's value, a vault space's path: the top-level ones and the deeper linked ones, of the
# vault you are in, else of every vault
complete_vault_space() {
  local root here line
  if root=$(_find_root "$PWD" 2>/dev/null); then
    _complete_spaces_of "$root" ""
    here=$(_entry_of "$root" 2>/dev/null) || return 0
    while IFS= read -r line; do
      [[ "${line%%/*}" != "$here" ]] || printf '%s\n' "${line#*/}"
    done < <(_complete_linked)
  else
    complete_space | awk '{ sub(/^[^\/]*\//, ""); print }' | LC_ALL=C sort -u
  fi
}

# A wsm space: wsm's to say
complete_spec() { command wsm __complete install "" 2>/dev/null | cut -f1; }

# --- Dispatch -----------------------------------------------------------------------------

cli_globals "$@"
set -- "${CLI_ARGS[@]}"

cli_dispatch "$@"
