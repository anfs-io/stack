#!/usr/bin/env bash
# ventoy — wrapper around the upstream Ventoy release (Ventoy2Disk.sh)
set -euo pipefail

# Paths, messages, the log and the command line come from anfs
ANFS_LIB="$HOME/.local/lib/anfs"
if [[ ! -f "$ANFS_LIB/bash.sh" || ! -f "$ANFS_LIB/table.sh" || ! -f "$ANFS_LIB/iso.sh" ]]; then
  echo "ventoy: $ANFS_LIB is missing or out of date; install core/anfs again" >&2
  exit 69
fi
# The bash floor, first: re-execs under bash 5 when this is macOS's 3.2
# shellcheck source=/dev/null
source "$ANFS_LIB/bash.sh"
# shellcheck source=/dev/null
source "$ANFS_LIB/paths.sh"
# shellcheck source=/dev/null
source "$ANFS_LIB/log.sh"
# shellcheck source=/dev/null
source "$ANFS_LIB/sources.sh"
# shellcheck source=/dev/null
source "$ANFS_LIB/iso.sh"
# shellcheck source=/dev/null
source "$ANFS_LIB/cli.sh"
# shellcheck source=/dev/null
source "$ANFS_LIB/table.sh"

anfs_tool_paths ventoy
anfs_gitsrc_env
: "${VENTOY_HOME:=$VENTOY_DATA_HOME/current}"
: "${VENTOY_ISO_DIR:=$VENTOY_CACHE_HOME/isos}"
VENTOY_MOUNT="$VENTOY_CACHE_HOME/mnt"
: "${VENTOY_IMAGE_SIZE:=64G}"

EX_UNAVAIL=69

CLI_TOOL=ventoy

cli_cmd disks "USB disks: DEVICE SIZE USB-ID BUS:ADDR MOUNTED NAME (macOS: the ids are what
QEMU passthrough takes)"
cli_cmd prepare "Install Ventoy to a USB disk, e.g. /dev/sdb, or a disk image (Linux; ERASES
the disk). A path that does not exist yet is created as a sparse disk image:
ventoy prepare ~/ventoy.img --size 32G. Other options go on to Ventoy2Disk.sh: -g (GPT),
-s (secure boot), -L LABEL, -r MiB" \
  --opt "-f --force: Reinstall even if Ventoy is already on the disk" \
  --opt "--size SIZE: Size of a new image (default \$VENTOY_IMAGE_SIZE, else 64G)" \
  --passthrough --arg "[disk]"
cli_cmd update "Upgrade Ventoy on a disk or disk image, keeping its ISOs (Linux)" --arg "[disk]"
cli_cmd status "Show Ventoy info for a disk or disk image (Linux)" --arg "[disk]"
cli_cmd list "ISOs on a stick and in VENTOY_ISO_DIR: SIZE STATUS ISO" --alias ls --arg "[target]"
cli_cmd copy "Copy ISOs to a stick: everything in VENTOY_ISO_DIR, or the catalogue ISOs named.
A named ISO is downloaded into the store when it is not there, and selected (a
link in VENTOY_ISO_DIR), so sync keeps it on the stick. A newer version replaces
the one selected before for that id" \
  --opt "-t --target TARGET: The stick" \
  --opt "-k --keep: Keep the older version selected" --arg "[iso...]"
cli_cmd remove "Remove ISOs from a stick (paths as \`ventoy list\` shows them)" --alias rm \
  --opt "-t --target TARGET: The stick" --arg "iso..."
cli_cmd sync "Make the stick's ISOs match VENTOY_ISO_DIR exactly: copy missing or changed
ISOs, remove all others (an empty dir removes every ISO)" \
  --opt "-n --dry-run: Show what would change" --opt "-y --yes: Do not ask" --arg "[target]"
# The catalogue and the store are anfs's, and so is the group: `ventoy iso list`, `ventoy iso pull`
# are `anfs iso` and `pmm iso` (lib/anfs/iso.sh)
anfs_iso_cli
cli_cmd info "Show paths, Ventoy version and the ISOs that would be copied"
cli_cmd path "Print VENTOY_DISK, the default disk or disk image: pmm up <machine> --media \"\$(ventoy path)\""
cli_standard

cli_help_epilogue() {
  cat <<'EOF'
A target is the stick's disk or data partition (Linux; mounted for you), a disk image file
(Linux; attached with losetup and detached again), or a mounted directory (default on macOS:
/Volumes/Ventoy). Commands without a disk use VENTOY_DISK. Only *.iso files on the stick are
ever copied or removed.

A disk image can be served to a PiKVM over NFS and presented to its host as a USB flash
drive. Never change it while the PiKVM has it connected: pikvm msd with -- ventoy sync -y

Environment:
  VENTOY_DISK     Default disk, e.g. /dev/disk/by-id/usb-... (stable across replugs, unlike /dev/sdX),
                  or a disk image, e.g. /srv/nfs/pikvm/ventoy.img
  VENTOY_IMAGE_SIZE  Size of images created by prepare (default 64G)
  VENTOY_ISO_DIR  The ISOs that go on the stick (default ~/.cache/ventoy/isos): links
                  `copy <iso>` makes into the store, and any file put there by hand. Delete
                  one to drop it.
  ANFS_ISO_HOME   The store every tool downloads into (default ~/.cache/anfs/isos)

`ventoy iso` is the catalogue and the store, the same commands as `anfs iso` and `pmm iso`:
list, show, pull, add, remove, path, prune. The catalogue is isos/isos.yml in each anfs source,
and ~/.config/anfs/isos.yml for your own entries (`ventoy iso add`; an id there replaces a
source's): id, name, architecture, url, filename, and checksum (a sha256) or checksum_url (the
publisher's checksum file).
  VENTOY_HOME     Ventoy release directory (default ~/.local/share/ventoy/current)
EOF
}

die()  { anfs_die "$@"; }
warn() { anfs_warn "$@"; }

is_linux() {
  [[ "$(uname -s)" == "Linux" ]]
}

require_linux() {
  is_linux || anfs_fail "$EX_UNAVAIL" "'$1' needs Linux (Ventoy2Disk.sh is Linux-only); use a Linux VM with the USB stick passed through"
}

# Set by resolve_disk / open_stick and undone by cleanup on exit
DISK=""
IMAGE=""
LOOP_DEV=""
MOUNTED_PART=""

cleanup() {
  if [[ -n "$MOUNTED_PART" ]]; then
    sync
    sudo umount "$STICK_DIR" && echo "Unmounted $MOUNTED_PART" >&2
    MOUNTED_PART=""
  fi
  if [[ -n "$LOOP_DEV" ]]; then
    sudo losetup -d "$LOOP_DEV" && echo "Detached $IMAGE" >&2
    LOOP_DEV=""
  fi
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# Attach a disk image file to a loop device (with partition scan); ro attaches it read-only.
# One attachment at a time: a second one could write the same exFAT from two places.
attach_image() {
  local img="$1" mode="$2" attached
  is_linux || anfs_fail "$EX_UNAVAIL" "$img: disk images need Linux (losetup)"
  attached="$(sudo losetup -j "$img" | cut -d: -f1)"
  [[ -z "$attached" ]] || die "$img is already attached as $attached (detach with: sudo losetup -d $attached)"

  local opts=(-f -P --show)
  [[ "$mode" != ro ]] || opts+=(-r)
  IMAGE="$img"
  LOOP_DEV="$(sudo losetup "${opts[@]}" "$img")" || die "could not attach $img"
  echo "Attached $img as $LOOP_DEV ($mode)" >&2
  DISK="$LOOP_DEV"
}

# Sets DISK from the argument, else $VENTOY_DISK. Symlinks such as /dev/disk/by-id/... resolve to
# the real device; a disk image file is attached to a loop device ("ro" or "rw", default rw).
resolve_disk() {
  DISK="${1:-${VENTOY_DISK:-}}"
  [[ -z "$DISK" || ! -L "$DISK" ]] || DISK="$(readlink -f "$DISK")"
  [[ ! -f "$DISK" ]] || attach_image "$(readlink -f "$DISK")" "${2:-rw}"
}

# Whole disk: a real disk or an attached image
is_whole_disk() {
  local type
  type="$(lsblk -dno TYPE "$1")"
  [[ "$type" == disk || "$type" == loop ]]
}

# Run Ventoy2Disk.sh from its own directory, as it expects
ventoy2disk() {
  [[ -f "$VENTOY_HOME/Ventoy2Disk.sh" ]] || anfs_fail "$EX_UNAVAIL" "Ventoy not found in $VENTOY_HOME (reinstall with: ppm install ventoy)"
  (cd "$VENTOY_HOME" && sudo sh ./Ventoy2Disk.sh "$@")
}

# Whole, unmounted disk only
check_disk() {
  local disk="$1"
  [[ -b "$disk" ]] || die "$disk is not a block device (list disks with: ventoy disks)"
  is_whole_disk "$disk" || die "$disk is a partition; pass the whole disk (e.g. /dev/sdb, not /dev/sdb1)"
  if lsblk -nro MOUNTPOINT "$disk" | grep -q .; then
    lsblk -o NAME,SIZE,MOUNTPOINT "$disk" >&2
    die "$disk has mounted partitions; unmount them first"
  fi
}

# Stronger than a y/N, and deliberately without a -y: the device (or image) path has to be typed
confirm_erase() {
  local disk="$1" answer
  if [[ -n "$IMAGE" ]]; then
    ls -lh "$IMAGE"
    read -r -p "ALL DATA in $IMAGE will be erased. Type the image path to continue: " answer
    [[ -n "$answer" && "$(readlink -f "$answer")" == "$IMAGE" ]] || die "nothing done"
    return
  fi
  lsblk -o NAME,SIZE,TYPE,TRAN,MODEL "$disk"
  [[ "$(lsblk -dno TRAN "$disk" | tr -d ' ')" == "usb" ]] || warn "$disk is not a USB device"
  read -r -p "ALL DATA on $disk will be erased. Type the device path to continue: " answer
  [[ "$answer" == "$disk" ]] || die "nothing done"
}

# Sets STICK_DIR to the stick's ISO directory. A directory is used as-is; a disk, partition or
# disk image (Linux) has Ventoy's data partition mounted ("ro" or "rw") and unmounted again on exit.
open_stick() {
  local target mode="$2"
  resolve_disk "$1" "$mode"
  target="$DISK"

  if [[ -z "$target" ]]; then
    is_linux && cli_usage_err "no disk given (pass one, or set VENTOY_DISK)"
    target="/Volumes/Ventoy"
  fi

  if [[ -d "$target" ]]; then
    STICK_DIR="$target"
    return
  fi
  is_linux && [[ -b "$target" ]] || die "$target is not a directory, block device or disk image"

  local part="$target"
  if is_whole_disk "$target"; then
    # Ventoy's ISO (exFAT) partition is the first one
    part="$(lsblk -lnpo NAME,TYPE "$target" | awk '$2 == "part" { print $1; exit }')"
    [[ -n "$part" ]] || die "$target has no partitions; run: ventoy prepare $target"
  fi

  STICK_DIR="$VENTOY_MOUNT"
  mkdir -p "$STICK_DIR"
  echo "Mounting $part on $STICK_DIR ($mode)" >&2
  sudo mount -o "$mode,uid=$(id -u),gid=$(id -g)" "$part" "$STICK_DIR" \
    || die "could not mount $part; if it is already mounted, pass its mount directory instead"
  MOUNTED_PART="$part"
}

cmd_prepare() {
  require_linux prepare
  local target="" mode="-i" size="${CLI_OPT[size]:-}" new_image=false
  local opts=()
  ! ${CLI_OPT[force]:-false} || mode="-I"
  # What is not ours goes on to Ventoy2Disk.sh, where it was typed
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --) ;;
      -r|-L)
        [[ $# -ge 2 ]] || cli_usage_err "$1 needs a value"
        opts+=("$1" "$2")
        shift
        ;;
      -*) opts+=("$1") ;;
      *) target="$1" ;;
    esac
    shift
  done
  target="${target:-${VENTOY_DISK:-}}"
  [[ -n "$target" ]] || cli_usage_err "no disk or image given (pass one, or set VENTOY_DISK)"

  # A path that does not exist yet becomes a new (sparse) disk image
  if [[ ! -e "$target" ]]; then
    [[ "$target" != /dev/* ]] || die "$target not found (list disks with: ventoy disks)"
    truncate -s "${size:-$VENTOY_IMAGE_SIZE}" "$target" || die "could not create image $target"
    anfs_info "Created image $target (${size:-$VENTOY_IMAGE_SIZE}, sparse)"
    new_image=true
  elif [[ -n "$size" ]]; then
    cli_usage_err "--size only sizes a new image; $target exists (delete it to recreate it with another size)"
  fi

  resolve_disk "$target" rw
  check_disk "$DISK"
  $new_image || confirm_erase "$DISK"
  # Ventoy2Disk.sh asks "Continue?" twice; the typed confirmation above covers both
  if ! printf 'y\ny\n' | ventoy2disk "$mode" "${opts[@]}" "$DISK"; then
    ! $new_image || rm -f "$target"
    die "Ventoy2Disk.sh failed on $DISK"
  fi
}

cmd_update() {
  require_linux update
  resolve_disk "${1:-}" rw
  [[ -n "$DISK" ]] || cli_usage_err "no disk or image given (pass one, or set VENTOY_DISK)"
  check_disk "$DISK"
  printf 'y\n' | ventoy2disk -u "$DISK"
}

cmd_status() {
  require_linux status
  resolve_disk "${1:-}" ro
  [[ -n "$DISK" ]] || cli_usage_err "no disk or image given (pass one, or set VENTOY_DISK)"
  [[ -b "$DISK" ]] || die "$DISK is not a block device or disk image"
  ventoy2disk -l "$DISK"
}

# Rows of USB disks: device, size, usb id, bus:addr, mount points, name
usb_disks() {
  local line disk size mounts name words
  if is_linux; then
    while IFS= read -r line; do
      [[ "$line" =~ ^NAME=\"(.*)\"\ SIZE=\"(.*)\"\ TRAN=\"(.*)\"\ VENDOR=\"(.*)\"\ MODEL=\"(.*)\"$ ]] || continue
      [[ "${BASH_REMATCH[3]}" == usb ]] || continue
      disk="${BASH_REMATCH[1]}" size="${BASH_REMATCH[2]}"
      # lsblk pads the vendor: fold the spaces
      read -ra words <<< "${BASH_REMATCH[4]} ${BASH_REMATCH[5]}" || true
      name="${words[*]}"
      mounts="$(lsblk -nro MOUNTPOINT "$disk" | awk 'NF { printf "%s%s", sep, $0; sep = "," }')"
      anfs_row "$disk" "$size" "" "" "$mounts" "$name"
    done < <(lsblk -dpn -P -o NAME,SIZE,TRAN,VENDOR,MODEL)
    return
  fi

  # ioreg links each USB device to its disk (BSD name); partitions (diskNsM) are skipped
  local id busaddr
  while read -r disk id busaddr name; do
    [[ -n "$disk" ]] || continue
    size="$(diskutil info "$disk" | awk -F': *' '/Disk Size/ { sub(/ \(.*/, "", $2); print $2; exit }')"
    mounts="$(mount | awk -v d="/dev/${disk}s" 'index($1, d) == 1 { printf "%s%s", sep, $3; sep = "," }')"
    anfs_row "/dev/$disk" "$size" "$id" "$busaddr" "$mounts" "$name"
  done < <(ioreg -r -c IOUSBHostDevice -l -w0 | awk '
    /"USB Product Name" = / { sub(/.*= "/, ""); sub(/"$/, ""); name = $0 }
    /"idVendor" = /         { vid = $NF }
    /"idProduct" = /        { pid = $NF }
    /"locationID" = /       { bus = int($NF / 16777216) }
    /"USB Address" = /      { addr = $NF }
    /"BSD Name" = "disk[0-9]+"/ {
      sub(/.*= "/, ""); sub(/"$/, "")
      printf "%s %04x:%04x %d:%d %s\n", $0, vid, pid, bus, addr, name
    }')
}

cmd_disks() {
  local rows
  rows="$(usb_disks)"
  [[ -z "$rows" ]] || rows+=$'\n'
  printf '%s' "$rows" | anfs_table "DEVICE SIZE USB-ID BUS:ADDR MOUNTED NAME" "device size usb_id bus_addr mounted name"
  [[ -n "$rows" ]] || anfs_json_on || warn "no USB disks found"
}

file_size() {
  wc -c < "$1" | tr -d ' '
}

human_size() {
  ls -lhL "$1" | awk '{ print $5 }'
}

# ISOs on the stick, NUL-separated (Ventoy also boots ISOs in subdirectories); skips macOS ._ files
stick_isos() {
  find "$STICK_DIR" -type f -iname '*.iso' ! -name '._*' -print0 | sort -z
}

# Status of an ISO on the stick (path relative to STICK_DIR) compared with VENTOY_ISO_DIR
stick_iso_status() {
  local rel="$1" name
  name="$(basename "$rel")"
  if [[ "$rel" == */* || ! -f "$VENTOY_ISO_DIR/$name" ]]; then
    echo "only on stick"
  elif [[ "$(file_size "$STICK_DIR/$rel")" == "$(file_size "$VENTOY_ISO_DIR/$name")" ]]; then
    echo "on stick"
  else
    echo "differs"
  fi
}

# True when a local ISO is missing from the stick's top level or has a different size there
needs_copy() {
  local iso="$1" dest
  dest="$STICK_DIR/$(basename "$1")"
  [[ ! -f "$dest" || "$(file_size "$dest")" != "$(file_size "$iso")" ]]
}

copy_iso() {
  # -L: follow symlinked ISOs; -X (macOS): skip xattrs so no ._ files land on the exFAT stick
  local opts=(-L)
  [[ "$(uname -s)" == "Darwin" ]] && opts+=(-X)
  cp "${opts[@]}" "$1" "$STICK_DIR/$(basename "$1")"
}

# Remove an ISO (path relative to STICK_DIR) and any macOS ._ sidecar next to it
remove_iso() {
  local rel="$1"
  rm -f "$STICK_DIR/$rel"
  rm -f "$STICK_DIR/$(dirname "$rel")/._$(basename "$rel")"
}

cmd_list() {
  open_stick "${1:-}" ro

  local rel iso name rows=""
  while IFS= read -r -d '' iso; do
    rel="${iso#"$STICK_DIR"/}"
    rows+="$(anfs_row "$(human_size "$iso")" "$(stick_iso_status "$rel")" "$rel")"$'\n'
  done < <(stick_isos)

  # ISOs `ventoy copy` would still add
  shopt -s nullglob
  for iso in "$VENTOY_ISO_DIR"/*.iso; do
    name="$(basename "$iso")"
    [[ -f "$STICK_DIR/$name" ]] && continue
    rows+="$(anfs_row "$(human_size "$iso")" "not copied" "$name")"$'\n'
  done

  printf '%s' "$rows" | anfs_table "SIZE STATUS ISO" "size status iso"
  [[ -n "$rows" ]] || anfs_json_on || warn "no ISOs on the stick or in $VENTOY_ISO_DIR"
}

cmd_copy() {
  local keep="${CLI_OPT[keep]:-false}" id iso name copied=0 skipped=0
  local -a isos=()
  if [[ $# -gt 0 ]]; then
    require_iso_list
    # Check every id before downloading anything
    for id in "$@"; do
      anfs_iso_known "$id" || die "no ISO '$id' in the catalogue (list them with: ventoy iso list; the stick is --target)"
    done
    for id in "$@"; do
      select_iso "$id" "$keep"
      isos+=("$VENTOY_ISO_DIR/$SELECTED")
    done
  else
    [[ -d "$VENTOY_ISO_DIR" ]] || die "ISO dir $VENTOY_ISO_DIR not found (select ISOs with: ventoy copy <iso>, or mkdir it and put files there)"
    shopt -s nullglob
    isos=("$VENTOY_ISO_DIR"/*.iso)
    [[ ${#isos[@]} -gt 0 ]] || die "no ISOs in $VENTOY_ISO_DIR"
  fi

  open_stick "${CLI_OPT[target]:-}" rw

  for iso in "${isos[@]}"; do
    name="$(basename "$iso")"
    if ! needs_copy "$iso"; then
      anfs_info "Skipping $name (already on the stick)"
      skipped=$((skipped + 1))
      continue
    fi
    anfs_info "Copying $name"
    copy_iso "$iso"
    copied=$((copied + 1))
  done

  sync
  anfs_info "Done: $copied copied, $skipped skipped"
}

cmd_remove() {
  local name missing=0

  # Validate every name before touching the stick
  for name in "$@"; do
    [[ "$name" != /* && "/$name/" != */../* ]] || die "'$name': use a path relative to the stick, as shown by: ventoy list"
    [[ "${name,,}" == *.iso ]] || die "'$name' is not an .iso file"
  done

  open_stick "${CLI_OPT[target]:-}" rw

  for name in "$@"; do
    if [[ -f "$STICK_DIR/$name" ]]; then
      remove_iso "$name"
      anfs_info "Removed $name"
    else
      warn "not on the stick: $name"
      missing=1
    fi
  done

  sync
  [[ "$missing" -eq 0 ]] || exit 1
}

cmd_sync() {
  local target="${1:-}" dry_run="${CLI_OPT[dry-run]:-false}"

  # A missing dir (e.g. a broken symlink) must not be mistaken for "remove everything"
  [[ -d "$VENTOY_ISO_DIR" ]] || die "ISO dir $VENTOY_ISO_DIR not found; refusing to sync (it would remove every ISO)"

  if $dry_run; then
    open_stick "$target" ro
  else
    open_stick "$target" rw
  fi

  local removes=() copies=() iso rel
  while IFS= read -r -d '' iso; do
    rel="${iso#"$STICK_DIR"/}"
    [[ "$(stick_iso_status "$rel")" == "only on stick" ]] && removes+=("$rel")
  done < <(stick_isos)

  shopt -s nullglob
  for iso in "$VENTOY_ISO_DIR"/*.iso; do
    needs_copy "$iso" && copies+=("$iso")
  done

  if [[ ${#removes[@]} -eq 0 && ${#copies[@]} -eq 0 ]]; then
    anfs_info "Stick already matches $VENTOY_ISO_DIR"
    return
  fi

  for rel in "${removes[@]}"; do
    printf "  remove  %-6s %s\n" "$(human_size "$STICK_DIR/$rel")" "$rel"
  done
  for iso in "${copies[@]}"; do
    printf "  copy    %-6s %s\n" "$(human_size "$iso")" "$(basename "$iso")"
  done

  ! $dry_run || return 0
  anfs_confirm "this removes ${#removes[@]} and copies ${#copies[@]} ISOs on the stick" "Apply?"

  # Remove first to free space for the copies
  for rel in "${removes[@]}"; do
    remove_iso "$rel"
    anfs_info "Removed $rel"
  done
  for iso in "${copies[@]}"; do
    anfs_info "Copying $(basename "$iso")"
    copy_iso "$iso"
  done

  sync
  anfs_info "Done: ${#removes[@]} removed, ${#copies[@]} copied"
}

# --- selecting: the catalogue, the store and the downloader are anfs's (lib/anfs/iso.sh) ---
# The store ($ANFS_ISO_HOME) is every tool's. What goes on a stick is what VENTOY_ISO_DIR holds:
# `copy <iso>` links an ISO from the store into it, and a file put there by hand counts just the
# same.

require_iso_list() {
  anfs_require yq "https://github.com/mikefarah/yq, which ppm installs"
  yq --version 2>&1 | grep -q mikefarah || anfs_fail "$EX_UNAVAIL" "yq is not mikefarah's (https://github.com/mikefarah/yq), which ppm installs"
}

# Tab-separated "id  file" records of what `copy <iso>` selected, so a newer version can replace it
SELECT_STATE_NAME=".ventoy-get"

state_filename() {
  local state="$VENTOY_ISO_DIR/$SELECT_STATE_NAME"
  [[ -f "$state" ]] || return 0
  awk -F'\t' -v id="$1" '$1 == id { file = $2 } END { if (file != "") print file }' "$state"
}

record_state() {
  local state="$VENTOY_ISO_DIR/$SELECT_STATE_NAME"
  {
    [[ -f "$state" ]] && awk -F'\t' -v id="$1" '$1 != id' "$state"
    printf '%s\t%s\n' "$1" "$2"
  } > "$state.tmp"
  mv "$state.tmp" "$state"
}

# Select a catalogue ISO for the stick, downloading it when the store does not have it; its name
# in VENTOY_ISO_DIR is left in SELECTED. Usage: select_iso <id> <keep: true|false>
select_iso() {
  local id="$1" keep="$2" file previous
  file=$(anfs_iso_fetch_id "$id") || die "$id: could not be downloaded and verified"
  SELECTED=$(basename "$file")
  previous="$(state_filename "$id")"

  mkdir -p "$VENTOY_ISO_DIR"
  if [[ -e "$VENTOY_ISO_DIR/$SELECTED" && ! -L "$VENTOY_ISO_DIR/$SELECTED" ]]; then
    anfs_info "$id: $SELECTED is a file of its own in $(anfs_display "$VENTOY_ISO_DIR"); left as it is"
  else
    ln -sfn "$file" "$VENTOY_ISO_DIR/$SELECTED"
  fi
  record_state "$id" "$SELECTED"

  # Replace the older version selected for this id. Its file stays in the store.
  if [[ -n "$previous" && "$previous" != "$SELECTED" && -e "$VENTOY_ISO_DIR/$previous" ]]; then
    if $keep; then
      anfs_info "$id: keeping older $previous (--keep)"
    else
      rm -f "$VENTOY_ISO_DIR/$previous"
      anfs_info "$id: removed older $previous"
    fi
  fi
}

cmd_path() {
  [[ -n "${VENTOY_DISK:-}" ]] || die "VENTOY_DISK is not set: it names the default disk or disk image"
  local disk="$VENTOY_DISK"
  [[ ! -L "$disk" ]] || disk="$(readlink -f "$disk")"
  echo "$disk"
}

cmd_info() {
  echo "Ventoy home: $VENTOY_HOME"
  if [[ -f "$VENTOY_HOME/ventoy/version" ]]; then
    echo "Version:     $(cat "$VENTOY_HOME/ventoy/version")"
  elif is_linux; then
    echo "Version:     not installed (ppm install ventoy)"
  else
    echo "Version:     not installed (prepare/update/status need Linux)"
  fi

  if [[ -f "${VENTOY_DISK:-}" ]]; then
    echo "Disk:        $VENTOY_DISK (image: $(human_size "$VENTOY_DISK"), $(du -h "$VENTOY_DISK" | cut -f1) allocated)"
  elif [[ -n "${VENTOY_DISK:-}" ]]; then
    echo "Disk:        $VENTOY_DISK$([[ -L "$VENTOY_DISK" ]] && echo " -> $(readlink -f "$VENTOY_DISK")")"
  else
    echo "Disk:        (VENTOY_DISK not set)"
  fi

  if [[ -L "$VENTOY_ISO_DIR" ]]; then
    echo "ISO dir:     $VENTOY_ISO_DIR -> $(readlink "$VENTOY_ISO_DIR")"
  else
    echo "ISO dir:     $VENTOY_ISO_DIR"
  fi
  echo "ISO store:   $ANFS_ISO_HOME"
  echo "Catalogue:   $(anfs_iso_catalogs | paste -sd" " -)"

  shopt -s nullglob
  local isos=("$VENTOY_ISO_DIR"/*.iso)
  if [[ ${#isos[@]} -eq 0 ]]; then
    echo "ISOs:        none"
  else
    echo "ISOs:"
    ls -lhL "${isos[@]}" | awk '{ print "  " $5 "\t" $NF }'
  fi
}

cli_dispatch "$@"
