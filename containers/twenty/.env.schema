# Twenty config schema — canonical source of truth for every tunable.
#
# Validate: varlock load --path .
#
# @defaultSensitive=false @defaultRequired=infer
# ---

## Images — fully qualified for Podman (no docker.io assumption).
# @type=string
TWENTY_IMAGE=docker.io/twentycrm/twenty
# Pinned: each start runs `upgrade` against the database, and Twenty doesn't
# support skipping versions. Step one release at a time.
# @type=string
TWENTY_TAG=v2.42.6

## Core config
# Session/token signing secret. The dev default is INSECURE — set a real one for
# anything shared or exposed. Generate: openssl rand -base64 32
# @required @sensitive @type=string
TWENTY_APP_SECRET=dev-insecure-change-me
# Encrypts stored credentials (connected accounts, API keys). The dev default is
# INSECURE. Changing it after first boot makes existing secrets unreadable.
# Generate: openssl rand -base64 32
# @required @sensitive @type=string
TWENTY_ENCRYPTION_KEY=dev-insecure-change-me
# Must match the URL in your browser exactly (scheme, host, port), or login and
# CORS break. Change it together with TWENTY_PORT or when fronting with a proxy.
# @required @type=url
TWENTY_SERVER_URL=http://localhost:8020
# Host port. 8020 avoids the Rails dev server (3000/5000).
# @type=port
TWENTY_PORT=8020

## Injected by pcm — do not set
# Connection URL for the shared pcm postgres (x-pcm.depends_on in compose.yml).
# To point elsewhere, export it in your shell before `pcm up`. Optional because
# pcm only provisions it on `up`; `down`, `logs` etc. run without it.
# @optional @sensitive @type=url
PCM_POSTGRES_URL=
# Connection URL (with its own db number) for the shared pcm valkey, used for
# BullMQ queues and the cache.
# @optional @type=url
PCM_VALKEY_URL=
# Root of pcm service volumes.
# @required @type=string
PCM_VOLUMES_HOME=
