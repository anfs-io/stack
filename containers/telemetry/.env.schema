# Telemetry config schema — canonical source of truth for every tunable.
#
# No secrets in this stack.
# Validate: varlock load --path .
#
# @defaultSensitive=false @defaultRequired=infer
# ---

## Images — fully qualified for Podman (no docker.io assumption).
# @type=string
TEMPO_IMAGE=docker.io/grafana/tempo
# @type=string
TEMPO_TAG=3.0.2
# Decoupled from the Tempo version.
# @type=string
OTELCOL_IMAGE=docker.io/otel/opentelemetry-collector-contrib
# @type=string
OTELCOL_TAG=0.128.0
# @type=string
GRAFANA_IMAGE=docker.io/grafana/grafana
# @type=string
GRAFANA_TAG=11.6.16

## Host ports
# OTLP gRPC — point your app's OTel SDK at localhost:4317.
# @type=port
OTLP_GRPC_PORT=4317
# OTLP HTTP — alternative to gRPC on localhost:4318.
# @type=port
OTLP_HTTP_PORT=4318
# Grafana UI. 8080 avoids the Rails dev server (3000/5000).
# @type=port
GRAFANA_PORT=8080

## Grafana auth is anonymous-admin for local dev (GF_AUTH_* in compose.yml, not
## parameterized). Do not use this config as-is off localhost.

## Dashboards — the coupling boundary. The stack ships ZERO dashboard JSON; the
## Grafana provider loads whatever is in this directory. Point it at a project's
## dashboard store, as an absolute path (compose does not expand ~), e.g.
## GRAFANA_DASHBOARDS_DIR=/Users/you/spikes/chorus/storage/telemetry/dashboards
## The directory must exist: pcm only creates missing dirs under PCM_VOLUMES_HOME.
# @required @type=string
GRAFANA_DASHBOARDS_DIR=${PCM_VOLUMES_HOME}/telemetry/dashboards

## Injected by pcm — do not set
# Root of pcm service volumes.
# @required @type=string
PCM_VOLUMES_HOME=
