# Traefik config schema — canonical source of truth for every tunable.
#
# Validate: varlock load --path .
#
# @defaultSensitive=false @defaultRequired=infer
# ---

## Image — fully qualified for Podman (no docker.io assumption).
# @type=string
TRAEFIK_IMAGE=docker.io/library/traefik
# @type=string
TRAEFIK_TAG=v3.7.13
# DEBUG, INFO, WARN, ERROR
# @type=enum(DEBUG, INFO, WARN, ERROR)
TRAEFIK_LOG_LEVEL=INFO

## Entry points
# Host address the proxy binds to. Keep 127.0.0.1 on a laptop; use 0.0.0.0 on a
# server (or behind a tunnel on another host) to accept outside traffic.
# @type=ip
PROXY_BIND=127.0.0.1
# Host ports. Rootless podman can't publish ports below 1024 unless the host
# allows it (sysctl net.ipv4.ip_unprivileged_port_start=80); see README.
# 8088 because 8080 is taken by telemetry (Grafana).
# @type=port
PROXY_HTTP_PORT=8088
# @type=port
PROXY_HTTPS_PORT=8443

## Injected by pcm — do not set
# Podman API socket (inside the podman machine VM on macOS).
# @required @type=string
PCM_PODMAN_SOCKET=
