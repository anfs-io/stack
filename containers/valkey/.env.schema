# Valkey config schema — canonical source of truth for every tunable.
#
# Shared pcm valkey. Dependents get a logical database from ./provision.
# Validate: varlock load --path .
#
# @defaultSensitive=false @defaultRequired=infer
# ---

## Image — fully qualified for Podman (no docker.io assumption).
# @type=string
VALKEY_IMAGE=docker.io/valkey/valkey
# @type=string
VALKEY_TAG=9

## Server
# Number of logical databases: db 0 is pcm's allocation table, so this caps
# dependents at VALKEY_DATABASES - 1.
# @type=string
VALKEY_DATABASES=64
# Host port.
# @type=port
VALKEY_PORT=6379

## Injected by pcm — do not set
# Root of pcm service volumes.
# @required @type=string
PCM_VOLUMES_HOME=
