#!/usr/bin/env bash
# provision — pcm dependency hook for authentik
#
# Run by pcm (from this directory) once authentik is healthy, for each service that
# declares it in x-pcm.depends_on:
#
#   provision slug=<name> redirect=<uri>[,<uri>...] [redirect=<uri>...]
#             [redirect_regex=<pattern>...] [name=<display name>] [client_type=public]
#
#   slug            required; the application slug and OIDC client_id (a DNS label:
#                   lower-case letters, digits, '-')
#   redirect        a strict redirect URI. Repeat it, or give a comma-separated list
#                   (the only way to give several from an x-pcm.depends_on map)
#   redirect_regex  a regex redirect URI (matching_mode: regex), e.g.
#                   http://[a-z0-9-]+\.localhost:3000/auth/callback for every tenant
#                   subdomain. Repeat it for several; never split on commas (a regex may
#                   hold one). It must start with http:// or https:// (after an optional
#                   ^) and hold no whitespace, quotes or control characters. The hook
#                   anchors it: stored as ^(?:<pattern>)$ unless it already starts with ^
#                   and ends with $ (authentik fullmatches anyway; the anchors make it
#                   explicit). At least one redirect or redirect_regex is required
#   name         display name of the application (default: slug)
#   client_type  public (default; PKCE, no secret). confidential is not supported yet
#
# Registers an OAuth2/OpenID client: writes the blueprint
# ${PCM_VOLUMES_HOME}/authentik/blueprints/pcm-<slug>.yaml (/blueprints/custom in the
# worker) and applies it synchronously with `ak apply_blueprint`. Re-running with the
# same settings changes nothing; with different ones it updates the provider in place.
#
# Prints KEY=VALUE; pcm exports each to the dependent as PCM_AUTHENTIK_<KEY>:
#   ISSUER       http://localhost:<AUTHENTIK_HTTP_PORT>/application/o/<slug>/
#   CLIENT_ID    <slug>
#   CLIENT_TYPE  public
#
# pcm runs it under varlock, which sets AUTHENTIK_* and PCM_VOLUMES_HOME from .env.schema.
set -euo pipefail

port="${AUTHENTIK_HTTP_PORT:?not set; run via pcm (varlock resolves it from .env.schema)}"
volumes="${PCM_VOLUMES_HOME:?not set; run via pcm}"

slug="" name="" client_type=public
redirects=()
regexes=()
for arg in "$@"; do
  case "$arg" in
    slug=*) slug="${arg#*=}" ;;
    name=*) name="${arg#*=}" ;;
    client_type=*) client_type="${arg#*=}" ;;
    redirect=*) IFS=, read -r -a more <<< "${arg#*=}"; redirects+=("${more[@]}") ;;
    redirect_regex=*) regexes+=("${arg#*=}") ;;
    *) echo "provision: unknown setting '$arg'" >&2; exit 1 ;;
  esac
done

if [[ ! "$slug" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
  echo "provision: slug '${slug}' is required and must be a DNS label ([a-z0-9][a-z0-9-]*)" >&2
  exit 1
fi
if (( ${#redirects[@]} + ${#regexes[@]} == 0 )); then
  echo "provision: redirect=<uri> or redirect_regex=<pattern> is required" >&2
  exit 1
fi
for uri in "${redirects[@]}"; do
  if [[ ! "$uri" =~ ^https?://[^[:space:]\"\'\\]+$ ]]; then
    echo "provision: invalid redirect URI '$uri' (http(s)://, no spaces or quotes)" >&2
    exit 1
  fi
done
anchored=()
for rx in "${regexes[@]}"; do
  # Backslashes are the point of a regex; quotes, whitespace and control characters never
  # belong in a redirect URI, and a literal scheme keeps it from matching another one
  if [[ "$rx" =~ [[:space:][:cntrl:]\"\'] || ! "$rx" =~ ^\^?https?:// ]]; then
    echo "provision: invalid redirect_regex '$rx' (starts with http:// or https://, no whitespace or quotes)" >&2
    exit 1
  fi
  if [[ "$rx" == ^* && "$rx" == *\$ ]]; then anchored+=("$rx"); else anchored+=("^(?:${rx})\$"); fi
done
name="${name:-$slug}"
if [[ "$name" =~ [[:cntrl:]] ]]; then
  echo "provision: name must be a single line" >&2
  exit 1
fi
case "$client_type" in
  public) ;;
  # confidential: generate a secret here (openssl rand -hex 32, or reuse the one already in
  # the blueprint so re-runs are stable), put `client_secret:` in the provider attrs below
  # and print CLIENT_SECRET=<secret> with the other keys.
  confidential) echo "provision: client_type=confidential: not yet supported" >&2; exit 1 ;;
  *) echo "provision: invalid client_type '$client_type' (public|confidential)" >&2; exit 1 ;;
esac

container=$(podman ps \
  --filter "label=com.docker.compose.project=${PCM_PROJECT:-authentik}" \
  --filter "label=com.docker.compose.service=worker" \
  --format '{{.Names}}' | head -n1)
if [[ -z "$container" ]]; then
  echo "provision: authentik worker container is not running" >&2
  exit 1
fi

# On a fresh install the worker applies authentik's own blueprints (the default flows,
# the scope mappings) in the background after it is healthy; ours refers to them.
ready_check='
from authentik.crypto.models import CertificateKeyPair
from authentik.flows.models import Flow
from authentik.providers.oauth2.models import ScopeMapping
ok = (
    CertificateKeyPair.objects.filter(name="authentik Self-signed Certificate").exists()
    and Flow.objects.filter(slug__in=["default-provider-authorization-implicit-consent",
                                      "default-provider-invalidation-flow"]).count() == 2
    and ScopeMapping.objects.filter(managed__in=[
        "goauthentik.io/providers/oauth2/scope-" + s for s in ("openid", "email", "profile")
    ]).count() == 3
)
print("PCM_READY" if ok else "PCM_WAITING")
'
for (( i = 0; ; i++ )); do
  if podman exec "$container" ak shell -c "$ready_check" 2>/dev/null | grep -q '^PCM_READY$'; then
    break
  fi
  if (( i >= 30 )); then
    echo "provision: authentik's default flows and scope mappings never appeared" >&2
    exit 1
  fi
  (( i == 0 )) && echo "provision: waiting for authentik's default blueprints" >&2
  sleep 5
done

# A YAML double-quoted scalar
yq_str() {
  local s="${1//\\/\\\\}"
  printf '"%s"' "${s//\"/\\\"}"
}

file="pcm-${slug}.yaml"
dir="${volumes}/authentik/blueprints"
mkdir -p "$dir"
tmp=$(mktemp "${dir}/.${file}.XXXXXX")
trap 'rm -f "$tmp"' EXIT
{
  cat <<EOF
# Written by pcm's authentik provision hook for ${PCM_DEPENDENT:-unknown}; deprovision removes it.
version: 1
metadata:
  name: pcm - ${slug}
  labels:
    # Applied by the hook only, not by the worker's file discovery
    blueprints.goauthentik.io/instantiate: "false"
entries:
  - model: authentik_providers_oauth2.oauth2provider
    id: provider
    identifiers:
      client_id: ${slug}
    attrs:
      name: $(yq_str "${name} (pcm ${slug})")
      client_type: ${client_type}
      # Since 2026.x a provider allows only the grant types listed here (none by default)
      grant_types: [authorization_code, refresh_token]
      redirect_uris:
EOF
  for uri in "${redirects[@]}"; do
    printf '        - matching_mode: strict\n          url: %s\n' "$(yq_str "$uri")"
  done
  for rx in "${anchored[@]}"; do
    printf '        - matching_mode: regex\n          url: %s\n' "$(yq_str "$rx")"
  done
  cat <<EOF
      signing_key: !Find [authentik_crypto.certificatekeypair, [name, "authentik Self-signed Certificate"]]
      authorization_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-implicit-consent]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-provider-invalidation-flow]]
      property_mappings:
        - !Find [authentik_providers_oauth2.scopemapping, [managed, goauthentik.io/providers/oauth2/scope-openid]]
        - !Find [authentik_providers_oauth2.scopemapping, [managed, goauthentik.io/providers/oauth2/scope-email]]
        - !Find [authentik_providers_oauth2.scopemapping, [managed, goauthentik.io/providers/oauth2/scope-profile]]
  - model: authentik_core.application
    identifiers:
      slug: ${slug}
    attrs:
      name: $(yq_str "$name")
      provider: !KeyOf provider
      policy_engine_mode: any
EOF
} > "$tmp"
chmod 644 "$tmp"

if cmp -s "$tmp" "${dir}/${file}"; then
  echo "provision: blueprint ${file} unchanged" >&2
else
  mv "$tmp" "${dir}/${file}"
  echo "provision: wrote blueprint ${file} for ${PCM_DEPENDENT:-unknown}" >&2
fi

# Applied every time, so a fresh database (or an edit made in the UI) is put back
# ak logs every app it loads; show them only if the apply fails
if ! log=$(podman exec "$container" ak apply_blueprint "custom/${file}" 2>&1); then
  printf '%s\n' "$log" >&2
  echo "provision: applying ${file} failed" >&2
  exit 1
fi
# apply_blueprint exits 0 even when an entry fails to apply, so check the result
check="from authentik.core.models import Application
print('PCM_OK' if Application.objects.filter(slug='${slug}', provider__oauth2provider__client_id='${slug}').exists() else 'PCM_MISSING')"
if ! podman exec "$container" ak shell -c "$check" 2>/dev/null | grep -q '^PCM_OK$'; then
  printf '%s\n' "$log" >&2
  echo "provision: applied ${file}, but application '${slug}' with its provider is not there" >&2
  exit 1
fi
echo "provision: applied ${file} (application and OAuth2 provider '${slug}')" >&2

cat <<EOF
ISSUER=http://localhost:${port}/application/o/${slug}/
CLIENT_ID=${slug}
CLIENT_TYPE=${client_type}
EOF
