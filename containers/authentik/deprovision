#!/usr/bin/env bash
# deprovision — pcm dependency hook for authentik
#
# Run by pcm (from this directory) during `pcm remove <service>` for each service that
# declares authentik in x-pcm.depends_on, after that service is down and while authentik
# is running:
#
#   deprovision slug=<name> [redirect=...] [redirect_regex=...] [name=...] [client_type=...]
#
# Takes provision's settings; only slug matters. Deletes the application and the OAuth2
# provider provision registered for it (by applying pcm-<slug>.yaml rewritten with
# state: absent), then removes the blueprint file. Idempotent: nothing there, nothing done.
#
# pcm runs it under varlock, which sets PCM_VOLUMES_HOME from .env.schema.
set -euo pipefail

volumes="${PCM_VOLUMES_HOME:?not set; run via pcm}"

slug=""
for arg in "$@"; do
  case "$arg" in
    slug=*) slug="${arg#*=}" ;;
    redirect=* | redirect_regex=* | name=* | client_type=*) ;;
    *) echo "deprovision: unknown setting '$arg'" >&2; exit 1 ;;
  esac
done

if [[ ! "$slug" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
  echo "deprovision: slug '${slug}' is required and must be a DNS label ([a-z0-9][a-z0-9-]*)" >&2
  exit 1
fi

container=$(podman ps \
  --filter "label=com.docker.compose.project=${PCM_PROJECT:-authentik}" \
  --filter "label=com.docker.compose.service=worker" \
  --format '{{.Names}}' | head -n1)
if [[ -z "$container" ]]; then
  echo "deprovision: authentik worker container is not running" >&2
  exit 1
fi

file="pcm-${slug}.yaml"
dir="${volumes}/authentik/blueprints"
mkdir -p "$dir"
cat > "${dir}/${file}" <<EOF
# Written by pcm's authentik deprovision hook for ${PCM_DEPENDENT:-unknown}; removed once applied.
version: 1
metadata:
  name: pcm - ${slug} (removal)
  labels:
    blueprints.goauthentik.io/instantiate: "false"
entries:
  - model: authentik_core.application
    state: absent
    identifiers:
      slug: ${slug}
  - model: authentik_providers_oauth2.oauth2provider
    state: absent
    identifiers:
      client_id: ${slug}
EOF
chmod 644 "${dir}/${file}"

# ak logs every app it loads; show them only if the apply fails
if ! log=$(podman exec "$container" ak apply_blueprint "custom/${file}" 2>&1); then
  printf '%s\n' "$log" >&2
  echo "deprovision: applying ${file} failed; left it in place" >&2
  exit 1
fi
# apply_blueprint exits 0 even when an entry fails to apply, so check the result
check="from authentik.core.models import Application
from authentik.providers.oauth2.models import OAuth2Provider
gone = not Application.objects.filter(slug='${slug}').exists() and not OAuth2Provider.objects.filter(client_id='${slug}').exists()
print('PCM_GONE' if gone else 'PCM_LEFT')"
if ! podman exec "$container" ak shell -c "$check" 2>/dev/null | grep -q '^PCM_GONE$'; then
  printf '%s\n' "$log" >&2
  echo "deprovision: applied ${file}, but application or provider '${slug}' is still there; left the file in place" >&2
  exit 1
fi
rm -f "${dir}/${file}"
echo "deprovision: removed application and OAuth2 provider '${slug}' for ${PCM_DEPENDENT:-unknown}" >&2
