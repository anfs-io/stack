# authentik config schema — canonical source of truth for every tunable.
#
# Uses the shared pcm postgres; connection details come from its provision hook.
# Validate: varlock load --path .
#
# @defaultSensitive=false @defaultRequired=infer
# ---

## Image — already fully qualified (ghcr.io).
# @type=string
AUTHENTIK_IMAGE=ghcr.io/goauthentik/server
# @type=string
AUTHENTIK_TAG=2026.5.3

## Core config
# authentik's master secret key (signs cookies, tokens). The dev default is
# INSECURE — set a real one for anything shared. Generate: openssl rand -hex 32
# Changing it after first boot invalidates sessions and tokens.
# @required @sensitive @type=string
AUTHENTIK_SECRET_KEY=dev-insecure-change-me

## Web UI ports — 9000/9443 avoid the Rails dev server (3000/5000).
# @type=port
AUTHENTIK_HTTP_PORT=9000
# @type=port
AUTHENTIK_HTTPS_PORT=9443

## Injected by pcm — do not set
# Connection details for the shared pcm postgres (x-pcm.depends_on in compose.yml).
# To point elsewhere, export them in your shell before `pcm up`. Optional because
# pcm only provisions them on `up`; `down`, `logs` etc. run without them.
# @optional @type=string
PCM_POSTGRES_HOST=
# @optional @type=port
PCM_POSTGRES_PORT=
# @optional @type=string
PCM_POSTGRES_DATABASE=
# @optional @type=string
PCM_POSTGRES_USER=
# @optional @sensitive @type=string
PCM_POSTGRES_PASSWORD=
# Root of pcm service volumes.
# @required @type=string
PCM_VOLUMES_HOME=
