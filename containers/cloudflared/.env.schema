# cloudflared config schema — canonical source of truth for every tunable.
#
# Validate: varlock load --path .
#
# @defaultSensitive=false @defaultRequired=infer
# ---

## Image — fully qualified for Podman (no docker.io assumption).
# @type=string
CLOUDFLARED_IMAGE=docker.io/cloudflare/cloudflared
# @type=string
CLOUDFLARED_TAG=2026.9.3

## Written by the cloudflare-tunnel edge — do not set
# This machine's tunnel token, in ~/.config/pcm/containers/cloudflared/local.env. The edge
# writes it on the first `pcm up` of a service it publishes, before this
# starts. Optional so definitions validate on machines that never use it.
# @optional @sensitive @type=string
TUNNEL_TOKEN=
