# cloudflared config schema — canonical source of truth for every tunable.
#
# Validate: varlock load --path .
#
# @defaultSensitive=false @defaultRequired=infer
# ---

## Image — fully qualified for Podman (no docker.io assumption).
# @type=string
CLOUDFLARED_IMAGE=docker.io/cloudflare/cloudflared
# @type=string
CLOUDFLARED_TAG=2026.9.3

## Written by the cloudflare-tunnel edge — do not set
# This machine's tunnel token, in pcm's state: ~/.local/state/pcm/containers/cloudflared/state.env
# (mode 0600). The edge writes it on the first `pcm up` of a service it publishes, before this
# starts; `pcm remove cloudflared` deletes it and the next up fetches it again. A TUNNEL_TOKEN in
# local.env would win over it: don't put one there. Optional so definitions validate on machines
# that never use it.
# @optional @sensitive @type=string
TUNNEL_TOKEN=
