# Gemstash config schema — canonical source of truth for every tunable.
#
# Validate: varlock load --path .
#
# @defaultSensitive=false @defaultRequired=infer
# ---

## Image — built locally from ./Containerfile (no official upstream image).
# Gem version installed into the image; also its tag. Changing it rebuilds on
# the next `pcm up` (or force with `podman compose --pcm build gemstash`).
# @type=string
GEMSTASH_VERSION=2.8.2

## Core config
# Upstream source for gems not in the private repo.
# @type=url
GEMSTASH_RUBYGEMS_URL=https://rubygems.org
# Require an API key (gemstash authorize --fetch) to download private gems.
# @type=enum(true, false)
GEMSTASH_PROTECTED_FETCH=false
# Seconds allowed for fetching a gem from upstream.
# @type=string
GEMSTASH_FETCH_TIMEOUT=20
# Host port (gemstash's own default).
# @type=port
GEMSTASH_PORT=9292

## Injected by pcm — do not set
# Root of pcm service volumes.
# @required @type=string
PCM_VOLUMES_HOME=
